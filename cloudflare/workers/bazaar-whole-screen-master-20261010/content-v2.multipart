export default {async fetch(request,env){const u=new URL(request.url);if(request.method!=="GET"||u.pathname!=="/run-2d84f1")return new Response("not found",{status:404});const q=[...Array(24).keys()],rows=[];async function w(){for(;;){const ti=q.shift();if(ti===undefined)return;try{const rr=await env.ORCH.fetch(new Request("https://orch/tile48-b72d-"+ti)),txt=await rr.text();let x;try{x=JSON.parse(txt)}catch{x={error:"non_json",prefix:txt.slice(0,160)}}rows.push({ti,status:rr.status,...x});}catch(e){rows.push({ti,error:e instanceof Error?e.message:String(e)});}}}await Promise.all([w(),w(),w(),w()]);const accepted=[];for(const row of rows)for(const m of row.merged||[])accepted.push({...m,tile_index:row.tile_index??row.ti});const norm=s=>String(s||"").toLowerCase().replace(/[^a-z0-9]/g,""),iou=(a,b)=>{if(!a||!b)return 0;const x1=Math.max(a.x,b.x),y1=Math.max(a.y,b.y),x2=Math.min(a.x+a.width,b.x+b.width),y2=Math.min(a.y+a.height,b.y+b.height),iw=Math.max(0,x2-x1),ih=Math.max(0,y2-y1),inter=iw*ih,uni=a.width*a.height+b.width*b.height-inter;return uni>0?inter/uni:0},sorted=[...accepted].sort((a,b)=>(b.transform?.inlier_count||0)-(a.transform?.inlier_count||0)||(a.transform?.mean_hamming??999)-(b.transform?.mean_hamming??999)||(a.transform?.mean_residual??999)-(b.transform?.mean_residual??999)),merged=[];for(const x of sorted){if(merged.some(y=>norm(x.asset_path)===norm(y.asset_path)&&iou(x.bbox,y.bbox)>=.45))continue;merged.push(x);}const hands=merged.filter(x=>norm(x.asset_path).includes("handsoftime")),sgw=merged.filter(x=>norm(x.asset_path).includes("stainedglasswindow"));return new Response(JSON.stringify({schema_version:1,version:"whole-screen-master-v1",tile_count:24,completed_tiles:rows.filter(x=>!x.error&&x.status===200).length,error_tiles:rows.filter(x=>x.error||x.status!==200).map(x=>({tile:x.ti,status:x.status??null,error:x.error??null,prefix:x.prefix??null})),raw_accept_count:accepted.length,merged_accept_count:merged.length,stained_glass_count:sgw.length,hands_of_time_count:hands.length,merged:merged.map(x=>({asset_path:x.asset_path,bbox:x.bbox,tile_index:x.tile_index,part_index:x.part_index,inliers:x.transform?.inlier_count??0,mean_hamming:x.transform?.mean_hamming??null,mean_residual:x.transform?.mean_residual??null,scale:x.transform?.scale??null}))}),{headers:{"content-type":"application/json","cache-control":"no-store"}})}};
