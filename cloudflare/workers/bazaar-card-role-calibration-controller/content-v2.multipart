--9b6c3c8ad0f69b9a148c9114fe21248a59bf056a3c416cea00fe4d09301a
Content-Disposition: form-data; name="worker.js"; filename="worker.js"
Content-Type: application/javascript+module

async function allIds(env){let c,out=[];do{const l=await env.BUCKET.list({prefix:"clean/train/",limit:1000,cursor:c});for(const o of l.objects)if(o.key.endsWith("/truth.json"))out.push(o.key.split("/")[2]);c=l.truncated?l.cursor:undefined}while(c);return [...new Set(out)].sort()}async function runOne(env,id){const r=await env.GATE.fetch("https://calibrator.internal/evaluate-case?case_id="+encodeURIComponent(id));const j=await r.json().catch(()=>({}));return {case_id:id,ok:r.ok,status:r.status,truth_item_count:j.truth_item_count??null,region_count:j.region_count??null,positive_count:j.positive_count??null,negative_count:j.negative_count??null,error:j.error||null}}export default{async fetch(req,env){const u=new URL(req.url);if(u.pathname!=="/batch")return Response.json({ok:true});const ids=await allIds(env),off=Math.max(0,parseInt(u.searchParams.get("offset")||"0")),lim=Math.min(40,Math.max(1,parseInt(u.searchParams.get("limit")||"10"))),sel=ids.slice(off,off+lim),res=[];for(let i=0;i<sel.length;i+=3)res.push(...await Promise.all(sel.slice(i,i+3).map(id=>runOne(env,id))));return Response.json({total:ids.length,offset:off,processed:res.length,ok:res.filter(x=>x.ok).length,failed:res.filter(x=>!x.ok),results:res,next_offset:off+res.length,complete:off+res.length>=ids.length})}};
