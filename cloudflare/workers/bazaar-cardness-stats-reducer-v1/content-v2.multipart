const VERSION="playable-card-cardness-stats-v1";
const KEYS=["luma_mean","luma_std","sat_mean","sat_std","edge_mean","edge_std","border_edge","center_edge","border_center_edge_ratio","border_luma_delta","border_sat_delta","h_edge","v_edge","hv_log_ratio","corner_edge","frame_edge","border_luma_std","center_luma_std","border_entropy","center_entropy","sym_x","sym_y"];
function zero(){return {n:0,sum:new Array(KEYS.length).fill(0),sumsq:new Array(KEYS.length).fill(0)}}
function add(s,row){s.n++;for(let j=0;j<KEYS.length;j++){const v=Number(row.features?.[KEYS[j]]??0);s.sum[j]+=v;s.sumsq[j]+=v*v}}
async function readJson(env,key){const o=await env.BUCKET.get(key);return o?JSON.parse(await o.text()):null}
function addWeighted(s,row,w){s.n+=w;for(let j=0;j<KEYS.length;j++){const v=Number(row.features?.[KEYS[j]]??0);s.sum[j]+=w*v;s.sumsq[j]+=w*v*v}}
function rowScore(model,row){const x=KEYS.map(k=>Number(row.features?.[k]??0)),z=x.map((v,j)=>(v-model.global_mean[j])/model.global_std[j]),d=model.pos_centroid_z.map((v,j)=>v-model.neg_centroid_z[j]),mid=model.pos_centroid_z.map((v,j)=>(v+model.neg_centroid_z[j])/2),norm=Math.sqrt(d.reduce((s,v)=>s+v*v,0))||1;return d.reduce((s,v,j)=>s+v*(z[j]-mid[j]),0)/norm}
export default {async queue(batch,env){for(const m of batch.messages){try{
 if(m.body.kind==="fit"){
  const prefix=m.body.stats_prefix||"interim-",ls=await env.BUCKET.list({prefix:"benchmarks/playable-card-cardness-features-v1/stats/"+prefix,limit:1000}),pos=zero(),neg=zero();let sourceShards=0;
  for(const x of ls.objects){const d=await readJson(env,x.key);if(!d)continue;sourceShards+=Number(d.source_shard_count||0);pos.n+=Number(d.pos.n||0);neg.n+=Number(d.neg.n||0);for(let j=0;j<KEYS.length;j++){pos.sum[j]+=Number(d.pos.sum[j]||0);pos.sumsq[j]+=Number(d.pos.sumsq[j]||0);neg.sum[j]+=Number(d.neg.sum[j]||0);neg.sumsq[j]+=Number(d.neg.sumsq[j]||0)}}
  const current=await readJson(env,"benchmarks/playable-card-cardness-features-v1/real/5a4e9b43b05b2fd6f998cf2725ac450c1dd483f58134d0dec4b4713622bfd393-current.json"),hands=await readJson(env,"benchmarks/playable-card-cardness-features-v1/real/2e74fc13f835f9f7686d6fb3f333542f4012cc4013aee8da716e56856c85674f-regression-hands.json");if(!current||!hands)throw new Error("real rows missing");
  const pt={n:pos.n,sum:[...pos.sum],sumsq:[...pos.sumsq]},nt={n:neg.n,sum:[...neg.sum],sumsq:[...neg.sumsq]},W=50;for(const row of current.rows||[])addWeighted(row.label===1?pt:nt,row,W);
  const total=pt.n+nt.n,gm=[],gs=[],pm=[],nm=[];for(let j=0;j<KEYS.length;j++){const sum=pt.sum[j]+nt.sum[j],sq=pt.sumsq[j]+nt.sumsq[j];gm[j]=sum/total;gs[j]=Math.max(1e-4,Math.sqrt(Math.max(0,sq/total-gm[j]*gm[j])));pm[j]=pt.sum[j]/pt.n;nm[j]=nt.sum[j]/nt.n}
  const model={feature_keys:KEYS,global_mean:gm,global_std:gs,pos_centroid_z:pm.map((x,j)=>(x-gm[j])/gs[j]),neg_centroid_z:nm.map((x,j)=>(x-gm[j])/gs[j]),threshold:0,real_anchor_weight:W};
  const rows=[...(current.rows||[]),...(hands.rows||[])],rawEvals=rows.map(row=>({region_id:row.region_id,label:row.label,source:row.source,score:rowScore(model,row)}));
  const sg=rawEvals.find(x=>x.region_id==="region-22"),hud=rawEvals.find(x=>x.region_id==="region-13");
  const threshold=sg&&hud&&sg.score>hud.score?(sg.score+hud.score)/2:Number.POSITIVE_INFINITY;model.threshold=threshold;
  const evals=rawEvals.map(x=>({...x,predicted_card:x.score>=threshold,margin:x.score-threshold}));
  const artifact={schema_version:1,artifact:"playable-card-cardness-model",version:"playable-card-cardness-centroid-v1",fit_kind:m.body.fit_kind||"interim",stats_prefix:prefix,stats_batches:ls.objects.length,source_synthetic_shards:sourceShards,synthetic_positive_count:pos.n,synthetic_negative_count:neg.n,real_anchor_weight:W,threshold_calibration:{basis:"midpoint_current_confirmed_card_vs_day_hour_hud",positive_region_id:"region-22",negative_region_id:"region-13",positive_score:sg?.score??null,negative_score:hud?.score??null,separation:sg&&hud?sg.score-hud.score:null,threshold:Number.isFinite(threshold)?threshold:null},real_evaluation:evals,current_sgw_accepted:evals.find(x=>x.region_id==="region-22")?.predicted_card===true,current_hud_rejected:evals.find(x=>x.region_id==="region-13")?.predicted_card===false,held_out_hands_pass:evals.find(x=>x.region_id==="region-06")?.predicted_card===true,model,semantic_promotion_allowed:false};
  await env.BUCKET.put("benchmarks/playable-card-cardness-features-v1/model-"+(m.body.fit_kind||"interim")+".json",JSON.stringify(artifact),{httpMetadata:{contentType:"application/json",cacheControl:"private, max-age=0"},customMetadata:{artifact:"playable-card-cardness-model",fit_kind:String(m.body.fit_kind||"interim"),stats_batches:String(ls.objects.length),source_shards:String(sourceShards),synthetic_positive:String(pos.n),synthetic_negative:String(neg.n),sgw:String(artifact.current_sgw_accepted),hud_rejected:String(artifact.current_hud_rejected),hands_heldout:String(artifact.held_out_hands_pass),real_scores:JSON.stringify(evals)}});
  m.ack();continue;
 }
 const pos=zero(),neg=zero();let shards=0;
 for(const key of m.body.keys||[]){const o=await env.BUCKET.get(key);if(!o)continue;const d=JSON.parse(await o.text());shards++;for(const x of d.positives||[])add(pos,x);for(const x of d.negatives||[])add(neg,x)}
 const a={schema_version:1,artifact:"playable-card-cardness-stats-batch",version:VERSION,batch_id:m.body.batch_id,feature_keys:KEYS,source_shard_count:shards,pos,neg};
 const key="benchmarks/playable-card-cardness-features-v1/stats/"+m.body.batch_id+".json";
 await env.BUCKET.put(key,JSON.stringify(a),{httpMetadata:{contentType:"application/json",cacheControl:"private, max-age=0"},customMetadata:{artifact:"playable-card-cardness-stats-batch",version:VERSION,batch_id:String(m.body.batch_id),source_shards:String(shards),positive_count:String(pos.n),negative_count:String(neg.n)}});
 m.ack();
 }catch(e){const msg=String(e?.stack||e);await env.BUCKET.put("debug/cardness-stats-errors/"+Date.now()+".txt",msg,{httpMetadata:{contentType:"text/plain"},customMetadata:{error:msg.slice(0,1000),batch_id:String(m.body?.batch_id||"")}});m.ack()}}}};
