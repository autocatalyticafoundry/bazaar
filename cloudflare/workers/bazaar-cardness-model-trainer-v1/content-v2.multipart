const VERSION="playable-card-cardness-centroid-v1";
const KEYS=["luma_mean","luma_std","sat_mean","sat_std","edge_mean","edge_std","border_edge","center_edge","border_center_edge_ratio","border_luma_delta","border_sat_delta","h_edge","v_edge","hv_log_ratio","corner_edge","frame_edge","border_luma_std","center_luma_std","border_entropy","center_entropy","sym_x","sym_y"];
function vec(f){return KEYS.map(k=>Number(f?.[k]??0))}
function weightedMean(rows,weights){const m=new Array(KEYS.length).fill(0),sw=weights.reduce((a,b)=>a+b,0)||1;for(let i=0;i<rows.length;i++){const v=vec(rows[i].features),w=weights[i];for(let j=0;j<m.length;j++)m[j]+=v[j]*w}return m.map(x=>x/sw)}
function score(model,row){const v=vec(row.features),z=v.map((x,j)=>(x-model.global_mean[j])/model.global_std[j]),delta=model.pos_centroid_z.map((x,j)=>x-model.neg_centroid_z[j]),mid=model.pos_centroid_z.map((x,j)=>(x+model.neg_centroid_z[j])/2),norm=Math.sqrt(delta.reduce((s,x)=>s+x*x,0))||1;return delta.reduce((s,x,j)=>s+x*(z[j]-mid[j]),0)/norm}
function topContrib(model,row){const v=vec(row.features),z=v.map((x,j)=>(x-model.global_mean[j])/model.global_std[j]),delta=model.pos_centroid_z.map((x,j)=>x-model.neg_centroid_z[j]),mid=model.pos_centroid_z.map((x,j)=>(x+model.neg_centroid_z[j])/2);return KEYS.map((k,j)=>({feature:k,contribution:delta[j]*(z[j]-mid[j])})).sort((a,b)=>Math.abs(b.contribution)-Math.abs(a.contribution)).slice(0,8)}
async function readJson(env,key){const o=await env.BUCKET.get(key);return o?JSON.parse(await o.text()):null}
export default {async queue(batch,env){for(const m of batch.messages){try{
 let cursor,synthetic=[],shards=0;do{const ls=await env.BUCKET.list({prefix:"benchmarks/playable-card-cardness-features-v1/synthetic/",limit:1000,cursor});for(const x of ls.objects){if(!x.key.endsWith(".json"))continue;const d=await readJson(env,x.key);if(!d)continue;shards++;synthetic.push(...(d.positives||[]),...(d.negatives||[]))}cursor=ls.truncated?ls.cursor:undefined}while(cursor);
 const current=await readJson(env,"benchmarks/playable-card-cardness-features-v1/real/5a4e9b43b05b2fd6f998cf2725ac450c1dd483f58134d0dec4b4713622bfd393-current.json"),hands=await readJson(env,"benchmarks/playable-card-cardness-features-v1/real/2e74fc13f835f9f7686d6fb3f333542f4012cc4013aee8da716e56856c85674f-regression-hands.json");
 if(!current||!hands)throw new Error("real calibration rows missing");
 const currentRows=current.rows||[],handsRow=(hands.rows||[])[0];if(!handsRow)throw new Error("hands row missing");
 const train=[...synthetic,...currentRows],weights=train.map((r,i)=>i<synthetic.length?1:50);
 const allV=train.map(r=>vec(r.features)),sw=weights.reduce((a,b)=>a+b,0),global=weightedMean(train,weights),std=new Array(KEYS.length).fill(0);
 for(let i=0;i<train.length;i++){const v=allV[i],w=weights[i];for(let j=0;j<std.length;j++)std[j]+=w*(v[j]-global[j])*(v[j]-global[j])}for(let j=0;j<std.length;j++)std[j]=Math.max(1e-4,Math.sqrt(std[j]/sw));
 const pos=train.filter(r=>r.label===1),neg=train.filter(r=>r.label===0),posW=[],negW=[];for(let i=0;i<train.length;i++){(train[i].label===1?posW:negW).push(weights[i])}
 const pm=weightedMean(pos,posW),nm=weightedMean(neg,negW),pz=pm.map((x,j)=>(x-global[j])/std[j]),nz=nm.map((x,j)=>(x-global[j])/std[j]);
 const model={version:VERSION,feature_keys:KEYS,global_mean:global,global_std:std,pos_centroid_z:pz,neg_centroid_z:nz,threshold:0,real_anchor_weight:50};
 const synthPos=synthetic.filter(r=>r.label===1),synthNeg=synthetic.filter(r=>r.label===0),tp=synthPos.filter(r=>score(model,r)>=0).length,tn=synthNeg.filter(r=>score(model,r)<0).length;
 const realEval=[...currentRows,handsRow].map(r=>({region_id:r.region_id,label:r.label,source:r.source,score:score(model,r),predicted_card:score(model,r)>=0,top_contributions:topContrib(model,r)}));
 const artifact={schema_version:1,artifact:"playable-card-cardness-model",version:VERSION,synthetic_shard_count:shards,synthetic_sample_count:synthetic.length,synthetic_positive_count:synthPos.length,synthetic_negative_count:synthNeg.length,training_uses_current_real_sgw_and_hud:true,held_out_regression:"previous_trusted_hands_of_time",model,metrics:{synthetic_positive_recall:synthPos.length?tp/synthPos.length:null,synthetic_negative_recall:synthNeg.length?tn/synthNeg.length:null,synthetic_balanced_accuracy:(synthPos.length&&synthNeg.length)?0.5*(tp/synthPos.length+tn/synthNeg.length):null},real_evaluation:realEval,held_out_hands_pass:realEval.find(x=>x.region_id==="region-06")?.predicted_card===true,current_hud_rejected:realEval.find(x=>x.region_id==="region-13")?.predicted_card===false,current_sgw_accepted:realEval.find(x=>x.region_id==="region-22")?.predicted_card===true,semantic_promotion_allowed:false};
 await env.BUCKET.put("benchmarks/playable-card-cardness-features-v1/model.json",JSON.stringify(artifact),{httpMetadata:{contentType:"application/json",cacheControl:"private, max-age=0"},customMetadata:{artifact:"playable-card-cardness-model",version:VERSION,synthetic_shards:String(shards),synthetic_samples:String(synthetic.length),positive_recall:String(artifact.metrics.synthetic_positive_recall??""),negative_recall:String(artifact.metrics.synthetic_negative_recall??""),held_out_hands_pass:String(artifact.held_out_hands_pass),current_hud_rejected:String(artifact.current_hud_rejected),current_sgw_accepted:String(artifact.current_sgw_accepted),real_scores:JSON.stringify(realEval.map(x=>({region_id:x.region_id,label:x.label,score:x.score,predicted_card:x.predicted_card}))),semantic_promotion_allowed:"false"}});
 m.ack();
 }catch(e){const msg=String(e?.stack||e);await env.BUCKET.put("debug/cardness-model-errors/"+Date.now()+".txt",msg,{httpMetadata:{contentType:"text/plain"},customMetadata:{error:msg.slice(0,1000)}});m.ack()}}}};
