function glExactRefShortlist(target,refs,indexed,limit=48){const votes=new Uint32Array(refs.length),seenTarget=Array.from({length:refs.length},()=>new Set());for(let ti=0;ti<target.length;ti++){const d=target[ti].descriptor,touched=new Set();for(let ci=0;ci<indexed.offs.length;ci++){const o=indexed.offs[ci],base=(d[o]<<8)|d[o+1],a=indexed.idx.get((ci<<16)|base);if(!a)continue;for(const code of a)touched.add(Math.floor(code/256));}for(const ri of touched){votes[ri]++;seenTarget[ri].add(ti);}}const rows=[];for(let i=0;i<refs.length;i++)if(votes[i])rows.push({i,v:votes[i],score:votes[i]/Math.sqrt(Math.max(1,target.length*refs[i].features.length))});rows.sort((a,b)=>b.v-a.v||b.score-a.score);return rows.slice(0,Math.max(1,Math.min(limit,rows.length)));}
