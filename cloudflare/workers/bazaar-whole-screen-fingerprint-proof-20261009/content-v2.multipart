async function brVerifyRange(env,start,count){const {image,refs}=await loadProofInputs(env,"perception/inputs/5a4e9b43b05b2fd6f998cf2725ac450c1dd483f58134d0dec4b4713622bfd393.png"),map=await brRefMap(env),boxes=brLocalizerBoxes(),rows=[];start=Math.max(0,Math.min(boxes.length-1,Number(start)||0));count=Math.max(1,Math.min(boxes.length-start,Number(count)||1));for(let i=start;i<start+count;i++){const ranked=brRankOne(image,refs,boxes[i]).slice(0,5),variants=brVariants(boxes[i]).map(v=>({kind:v.kind,box:v.box,features:brNormFeatures(image,v.box)})),checks=[];for(const q of ranked){const ref=map.get(q.asset_path);if(!ref)continue;let best=null;for(const v of variants){const e=lgEstimate(v.features,ref.features),t=e.transform,r={name:q.name,asset_path:q.asset_path,fingerprint_score:q.score,fingerprint_variant:q.variant,variant:v.kind,pair_count:e.pair_count,transform:t};if(!best||(t&&(!best.transform||t.inlier_count>best.transform.inlier_count||(t.inlier_count===best.transform.inlier_count&&t.mean_hamming<best.transform.mean_hamming))))best=r;}checks.push(best);}checks.sort((a,b)=>(b.transform?.inlier_count||0)-(a.transform?.inlier_count||0)||(a.transform?.mean_hamming??999)-(b.transform?.mean_hamming??999)||(a.fingerprint_score-b.fingerprint_score));rows.push({id:i,bbox:boxes[i],fingerprint_best:ranked[0]||null,geometry:checks});}return {version:"localizer-canonical-normalized-geometry-v1",start,count,rows};}




async function materializeFeatureRange(env,si,start,count=48){
  si=Math.max(0,Math.min(7,Number(si)||0));start=Math.max(0,Number(start)||0);count=Math.max(1,Math.min(64,Number(count)||48));
  const bank=await lgLoadBank(env,"debug/whole-screen-local-feature-bank-v1/shards/shard-"+String(si).padStart(2,"0")+".json");
  const refs=bank.refs.slice(start,start+count);let written=0;
  for(const r of refs){
    const sha=String(r.source_sha256||"");if(!sha)continue;
    const features=r.features.map(f=>[f.x,f.y,lgDescToB64(f.descriptor)]);
    const key="catalogue/item-local-features-v2/"+sha+".json";
    await env.BENCHMARK_R2.put(key,JSON.stringify({schema_version:1,asset_path:r.asset_path,source_sha256:sha,width:r.width,height:r.height,feature_count:features.length,features}),{httpMetadata:{contentType:"application/json"},customMetadata:{artifact:"item-local-features-v2",source_sha256:sha,name:basename(r.asset_path||""),feature_count:String(features.length)}});
    written++;
  }
  return {shard_index:si,start,count:refs.length,written,total:bank.refs.length};
}
async function materializeFeatureOne(env,si,sha){
  si=Math.max(0,Math.min(7,Number(si)||0));sha=String(sha||"");
  const bank=await lgLoadBank(env,"debug/whole-screen-local-feature-bank-v1/shards/shard-"+String(si).padStart(2,"0")+".json");
  const r=bank.refs.find(x=>String(x.source_sha256||"")===sha);
  if(!r)return {shard_index:si,found:false,sha};
  const features=r.features.map(f=>[f.x,f.y,lgDescToB64(f.descriptor)]);
  const key="catalogue/item-local-features-v2/"+sha+".json";
  await env.BENCHMARK_R2.put(key,JSON.stringify({schema_version:1,asset_path:r.asset_path,source_sha256:sha,width:r.width,height:r.height,feature_count:features.length,features}),{httpMetadata:{contentType:"application/json"},customMetadata:{artifact:"item-local-features-v2",source_sha256:sha,name:basename(r.asset_path||""),feature_count:String(features.length)}});
  return {shard_index:si,found:true,sha,name:basename(r.asset_path||""),feature_count:features.length};
}
async function materializeFeatureShard(env,si){
  si=Math.max(0,Math.min(7,Number(si)||0));
  const bank=await lgLoadBank(env,"debug/whole-screen-local-feature-bank-v1/shards/shard-"+String(si).padStart(2,"0")+".json");
  let written=0;
  for(const r of bank.refs){
    const sha=String(r.source_sha256||"");if(!sha)continue;
    const features=r.features.map(f=>[f.x,f.y,lgDescToB64(f.descriptor)]);
    const key="catalogue/item-local-features-v2/"+sha+".json";
    await env.BENCHMARK_R2.put(key,JSON.stringify({schema_version:1,asset_path:r.asset_path,source_sha256:sha,width:r.width,height:r.height,feature_count:features.length,features}),{httpMetadata:{contentType:"application/json"},customMetadata:{artifact:"item-local-features-v2",source_sha256:sha,name:basename(r.asset_path||""),feature_count:String(features.length)}});
    written++;
  }
  return {shard_index:si,reference_count:bank.refs.length,written};
}
async function loadCompactRef(env,sha){
  const obj=await env.BENCHMARK_R2.get("catalogue/item-local-features-v2/"+sha+".json");
  if(!obj)throw new Error("compact ref missing "+sha);
  const r=JSON.parse(await new Response(obj.body).text());
  return {asset_path:r.asset_path,width:r.width,height:r.height,features:(r.features||[]).map(f=>({x:f[0],y:f[1],descriptor:lgB64ToDesc(f[2])}))};
}
async function geoCachedBoxCandidate(env,id,vi,sha){
  const target=await brLoadVariantTarget(env,id,vi),ref=await loadCompactRef(env,sha),e=lgEstimate(target.features,ref.features),t=e.transform;
  return {box_index:id,variant_index:vi,variant:target.variant,asset_path:ref.asset_path,pair_count:e.pair_count,transform:t,accepted:!!(t&&((t.inlier_count>=6&&t.mean_hamming<=18&&t.mean_residual<=2.5)||(t.inlier_count>=4&&t.mean_hamming<=4&&t.mean_residual<=1)))};
}
function svStructuralVector(rgb){if(!rgb||rgb.length!==768)throw new Error("struct vector expects 16x16 RGB");let mr=0,mg=0,mb=0;for(let i=0;i<rgb.length;i+=3){mr+=rgb[i];mg+=rgb[i+1];mb+=rgb[i+2];}mr/=256;mg/=256;mb/=256;const centered=new Float64Array(768);let nc=0;for(let i=0;i<rgb.length;i+=3){const r=rgb[i]-mr,g=rgb[i+1]-mg,b=rgb[i+2]-mb;centered[i]=r;centered[i+1]=g;centered[i+2]=b;nc+=r*r+g*g+b*b;}nc=Math.sqrt(Math.max(1e-12,nc));const gray=new Float64Array(256);for(let p=0;p<256;p++){const i=p*3;gray[p]=rgb[i]*0.299+rgb[i+1]*0.587+rgb[i+2]*0.114;}const grad=new Float64Array(392);let k=0,ng=0;for(let y=1;y<15;y++)for(let x=1;x<15;x++){const p=y*16+x,gx=gray[p+1]-gray[p-1],gy=gray[p+16]-gray[p-16];grad[k++]=gx;grad[k++]=gy;ng+=gx*gx+gy*gy;}ng=Math.sqrt(Math.max(1e-12,ng));const wc=Math.sqrt(.32),wg=Math.sqrt(.58),out=new Array(1160);for(let i=0;i<768;i++)out[i]=wc*centered[i]/nc;for(let i=0;i<392;i++)out[768+i]=wg*grad[i]/ng;return out;}
async function svLoadBatch(env,start,count){start=Math.max(0,Number(start)||0);count=Math.max(1,Math.min(150,Number(count)||100));const obj=await env.BENCHMARK_R2.get(SNAPSHOT_KEY);if(!obj)throw new Error("snapshot missing");const snap=JSON.parse(await new Response(obj.body).text()),refs=(snap.fingerprints||[]).filter(r=>/\/items\//i.test(r.asset_path||"")&&r.rgb16),end=Math.min(refs.length,start+count),vectors=[];for(let i=start;i<end;i++){const r=refs[i],rgb=b64bytes(r.rgb16),values=svStructuralVector(rgb);vectors.push({id:String(i),values,metadata:{asset_path:String(r.asset_path||""),name:basename(r.asset_path||""),source_sha256:String(r.source_sha256||"")}});}const result=await env.STRUCT_INDEX.upsert(vectors);return {reference_count:refs.length,start,count:end-start,upserted:vectors.length,result};}
async function svQueryVariant(env,id,vi){id=Math.max(0,Math.min(12,Number(id)||0));vi=Math.max(0,Math.min(3,Number(vi)||0));const box=brLocalizerBoxes()[id],v=brVariants(box)[vi]||brVariants(box)[0],obj=await env.BENCHMARK_R2.get("perception/inputs/5a4e9b43b05b2fd6f998cf2725ac450c1dd483f58134d0dec4b4713622bfd393.png");if(!obj)throw new Error("input missing");const trim={top:Math.max(0,Math.floor(v.box.y)),left:Math.max(0,Math.floor(v.box.x)),width:Math.max(1,Math.floor(v.box.width)),height:Math.max(1,Math.floor(v.box.height))},img=await env.IMAGES.input(obj.body).transform({trim}).transform({width:16,height:16,fit:"squeeze"}).output({format:"image/png"}),png=await decodePng(await img.response().arrayBuffer()),rgb=new Uint8Array(768);let k=0;for(let i=0;i<png.rgba.length;i+=4){rgb[k++]=png.rgba[i];rgb[k++]=png.rgba[i+1];rgb[k++]=png.rgba[i+2];}const values=svStructuralVector(rgb),q=await env.STRUCT_INDEX.query(values,{topK:20,returnMetadata:"all"}),matches=(q.matches||[]).map((m,rank)=>({rank,id:m.id,score:m.score,metadata:m.metadata||{}})),result={schema_version:1,box_index:id,variant_index:vi,variant:v.kind,trim,matches},key="debug/struct-vector-query-v1/b"+String(id).padStart(2,"0")+"-v"+vi+".json";await env.BENCHMARK_R2.put(key,JSON.stringify(result),{httpMetadata:{contentType:"application/json"},customMetadata:{artifact:"struct-vector-query-v1",box_index:String(id),variant_index:String(vi),variant:v.kind,match_count:String(matches.length),top:JSON.stringify(matches.slice(0,10).map(m=>({rank:m.rank,score:m.score,name:m.metadata?.name||basename(m.metadata?.asset_path||"")})))}});return result;}
