  await env.BENCHMARK_R2.put(outputKey,JSON.stringify(artifact),{httpMetadata:{contentType:"application/json"},customMetadata:{artifact:"whole-screen-canonical-fingerprint-v2",chunk_count:String(chunkCount),window_count:String(totalWindows),detection_count:String(detections.length),proposals_used:"false",router_used:"false"}});
  return artifact;
}

async function proofProgress(env,key,stage,extra={}){
  await env.BENCHMARK_R2.put(key,JSON.stringify({stage,extra,at:new Date().toISOString()}),{httpMetadata:{contentType:"application/json"},customMetadata:{artifact:"whole-screen-proof-progress",stage:String(stage),...Object.fromEntries(Object.entries(extra).map(([k,v])=>[k,String(v)]))}});
}
async function runDiagnosticChunk(env,body){
  const inputKey=String(body.input_key||""),progressKey=String(body.progress_key||""),hi=Math.max(0,Math.min(6,Number(body.hf_index)||0)),ai=Math.max(0,Math.min(6,Number(body.ar_index)||0));
