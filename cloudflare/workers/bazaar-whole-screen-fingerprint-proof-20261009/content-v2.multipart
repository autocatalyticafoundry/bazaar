async function glKnownRecall(env){const inputKey="perception/inputs/5a4e9b43b05b2fd6f998cf2725ac450c1dd483f58134d0dec4b4713622bfd393.png",tile={x:950,y:350,width:400,height:400},loaded=await loadProofInputs(env,inputKey),crop=lgCrop(loaded.image,tile),target=lgExtract(crop.data,crop.width,crop.height,260,false,2),bank=await lgLoadBank(env,"debug/whole-screen-local-feature-bank-v1/shards/shard-06.json"),needle=("Stained"+"GlassWindow").toLowerCase(),ri=bank.refs.findIndex(r=>String(r.asset_path||"").toLowerCase().includes(needle));if(ri<0)return {error:"known_ref_not_in_shard",target_features:target.length,reference_count:bank.refs.length};const ref=bank.refs[ri],direct=lgEstimate(target,ref.features),indexed=glCollectPairs(target,bank.refs,glBuildIndex(bank.refs)),rawPairs=indexed[ri]||[],geo=glGeoStats(indexed,bank.refs),geoIndex=geo.findIndex(x=>x.i===ri),geoRow=geoIndex>=0?geo[geoIndex]:null,ranked=glRankRefs(indexed,bank.refs,tile),row=ranked.find(r=>r.asset_path===ref.asset_path)||null;return {target_features:target.length,reference_index:ri,asset_path:ref.asset_path,reference_features:ref.features.length,direct_pair_count:direct.pair_count,direct_transform:direct.transform,indexed_raw_pair_count:rawPairs.length,indexed_distances:rawPairs.slice().sort((a,b)=>a.distance-b.distance).slice(0,24).map(p=>p.distance),geo_rank:geoIndex>=0?geoIndex+1:null,geo_row:geoRow,indexed_row:row};}
function glGeoVote(input){const p=glUniquePairs(input).slice(0,16),bins=new Map();let best=0,valid=0;for(let i=0;i<p.length-1;i++)for(let k=i+1;k<p.length;k++){const t=lgFromTwo(p[i],p[k]);if(!t)continue;valid++;const key=Math.round(t.scale/0.05)+"|"+Math.round(t.rotation_deg/4)+"|"+Math.round(t.tx/20)+"|"+Math.round(t.ty/20),v=(bins.get(key)||0)+1;bins.set(key,v);if(v>best)best=v;}return {pairs:p.length,valid_transforms:valid,geo_votes:best};}
function glGeoStats(perRef,refs){const out=[];for(let i=0;i<refs.length;i++){const g=glGeoVote(perRef[i]);if(g.pairs<4)continue;const u=glUniquePairs(perRef[i]),d=u.map(x=>x.distance).sort((a,b)=>a-b),k=Math.min(12,d.length);out.push({i,name:basename(refs[i].asset_path),geo_votes:g.geo_votes,valid_transforms:g.valid_transforms,pair_count:u.length,strong:u.filter(x=>x.distance<=12).length,very:u.filter(x=>x.distance<=8).length,mean12:k?d.slice(0,k).reduce((s,x)=>s+x,0)/k:999});}out.sort((a,b)=>b.geo_votes-a.geo_votes||b.very-a.very||b.strong-a.strong||a.mean12-b.mean12||b.pair_count-a.pair_count);return out;}
function glRankShortlist(perRef,refs,tile,limit=20){const stats=glPairStats(perRef,refs).slice(0,limit),rows=[];for(const s of stats){const pairs=glUniquePairs(perRef[s.i]).slice(0,24);if(pairs.length<4)continue;const e=glEstimatePairs(pairs),t=e.transform,r=refs[s.i];rows.push({asset_path:r.asset_path,pair_count:e.pair_count,strong:s.strong,very:s.very,mean12:s.mean12,transform:t,bbox:t?lgBoxFromTransform(t,tile,r.width,r.height):null});}rows.sort((a,b)=>((b.transform?b.transform.inlier_count:0)-(a.transform?a.transform.inlier_count:0))||((a.transform?a.transform.mean_hamming:999)-(b.transform?b.transform.mean_hamming:999))||b.strong-a.strong);return {stats,rows};}
function glRankGeoShortlist(perRef,refs,tile,limit=18){const stats=glGeoStats(perRef,refs).slice(0,limit),rows=[];for(const s of stats){const pairs=glUniquePairs(perRef[s.i]).slice(0,24);if(pairs.length<4)continue;const e=glEstimatePairs(pairs),t=e.transform,r=refs[s.i];rows.push({asset_path:r.asset_path,pair_count:e.pair_count,geo_votes:s.geo_votes,strong:s.strong,very:s.very,mean12:s.mean12,transform:t,bbox:t?lgBoxFromTransform(t,tile,r.width,r.height):null});}rows.sort((a,b)=>((b.transform?b.transform.inlier_count:0)-(a.transform?a.transform.inlier_count:0))||b.geo_votes-a.geo_votes||((a.transform?a.transform.mean_hamming:999)-(b.transform?b.transform.mean_hamming:999)));return {stats,rows};}
