  const raw=JSON.parse(await new Response(obj.body).text()),refs=(raw.rows||[]).map(r=>({asset_path:r.asset_path,source_sha256:r.source_sha256,width:r.width,height:r.height,features:(r.features||[]).map(f=>({x:f[0],y:f[1],descriptor:lgB64ToDesc(f[2])}))}));
