function brLocalizerBoxes(){return [[174,526,223,217],[404,526,68,217],[478,526,68,217],[548,526,68,217],[618,526,68,217],[688,526,68,217],[758,526,68,217],[828,526,68,217],[404,286,68,200],[478,286,164,200],[642,286,68,200],[166,794,134,200],[826,784,150,210]].map((b,i)=>({id:i,x:b[0]*2.048,y:b[1]*1.409,width:b[2]*2.048,height:b[3]*1.409}));}
function brVariants(b){const out=[{kind:"full",box:b}],s=Math.min(b.width,b.height);if(b.height>=b.width){for(const [k,f] of [["top",0],["center",.5],["bottom",1]]){let y=b.y+(b.height-s)*f;out.push({kind:k,box:{x:b.x,y,width:s,height:s}});}}else{for(const [k,f] of [["left",0],["center",.5],["right",1]]){let x=b.x+(b.width-s)*f;out.push({kind:k,box:{x,y:b.y,width:s,height:s}});}}return out;}
function brCoarse(sample4,ref){const m=meanRgb(sample4),d=(Math.abs(m[0]-ref.mean[0])+Math.abs(m[1]-ref.mean[1])+Math.abs(m[2]-ref.mean[2]))/(3*255);return mae(sample4,ref.rgb4)*.88+d*.12;}
function brRankOne(image,refs,b){const cand=[];for(const v of brVariants(b)){const s4=sampleGrid(image,v.box,4),top=[];for(const ref of refs){const c=brCoarse(s4,ref);if(top.length<36){top.push({ref,c});if(top.length===36)top.sort((a,b)=>a.c-b.c);}else if(c<top[35].c){top[35]={ref,c};top.sort((a,b)=>a.c-b.c);}}const s16=sampleGrid(image,v.box,16);for(const q of top){const z=structuralScore(s16,q.ref.rgb16);cand.push({name:q.ref.display_name,asset_path:q.ref.asset_path,variant:v.kind,bbox:v.box,coarse:q.c,...z});}}cand.sort((a,b)=>a.score-b.score||a.coarse-b.coarse);const out=[],seen=new Set();for(const q of cand){if(seen.has(q.asset_path))continue;seen.add(q.asset_path);out.push(q);if(out.length>=8)break;}return out;}
async function brRefMap(env){const m=new Map();for(let si=0;si<8;si++){const b=await lgLoadBank(env,"debug/whole-screen-local-feature-bank-v1/shards/shard-"+String(si).padStart(2,"0")+".json");for(const r of b.refs)m.set(r.asset_path,r);}return m;}
function brNormFeatures(image,box){const c=lgCrop(image,box),r=lgResizeNearest(c.data,c.width,c.height,256/Math.max(1,c.width));let d=r;if(r.height!==256){const out=new Uint8ClampedArray(256*256*4);for(let y=0;y<256;y++){const sy=Math.min(r.height-1,Math.floor(y*r.height/256));for(let x=0;x<256;x++){const si=(sy*r.width+x)*4,di=(y*256+x)*4;out[di]=r.data[si];out[di+1]=r.data[si+1];out[di+2]=r.data[si+2];out[di+3]=r.data[si+3];}}d={data:out,width:256,height:256};}return lgExtract(d.data,d.width,d.height,220,false,1,true,1);}


async function brAggregateCached(env){
  const listed=await env.BENCHMARK_R2.list({prefix:"debug/normalized-cached-v1/",limit:1000,include:["customMetadata"]});
  const objs=listed.objects||[];
  const byBox=Array.from({length:13},()=>({done:0,hits:new Map()}));
  let positiveArtifacts=0;
  for(const o of objs){
    const m=o.customMetadata||{};
    const b=Number(m.box_index);
    if(!Number.isInteger(b)||b<0||b>=13)continue;
    byBox[b].done++;
    const n=Number(m.accepted_count||0);
    if(n<=0)continue;
    positiveArtifacts++;
    const obj=await env.BENCHMARK_R2.get(o.key);
    if(!obj)continue;
    const row=JSON.parse(await new Response(obj.body).text());
    for(const q of row.accepted||[]){
      const name=basename(q.asset_path||"");
      let h=byBox[b].hits.get(name);
      if(!h){h={name,asset_path:q.asset_path,support_variants:new Set(),support_shards:new Set(),occurrences:0,best:null};byBox[b].hits.set(name,h);}
      h.support_variants.add(Number(row.variant_index));
      h.support_shards.add(Number(row.shard_index));
      h.occurrences++;
      const t=q.transform||null;
      if(t){
        const cand={inliers:Number(t.inlier_count||0),h:Number(t.mean_hamming??999),res:Number(t.mean_residual??999),scale:Number(t.scale??0),variant:row.variant,variant_index:row.variant_index,shard_index:row.shard_index};
        const cur=h.best;
        if(!cur||cand.inliers>cur.inliers||(cand.inliers===cur.inliers&&cand.h<cur.h)||(cand.inliers===cur.inliers&&cand.h===cur.h&&cand.res<cur.res))h.best=cand;
      }
    }
  }
  const boxes=byBox.map((b,id)=>{
    const identities=[...b.hits.values()].map(h=>({name:h.name,asset_path:h.asset_path,support_variants:h.support_variants.size,support_shards:h.support_shards.size,occurrences:h.occurrences,best:h.best})).sort((a,b)=>(b.best?.inliers||0)-(a.best?.inliers||0)||b.support_variants-a.support_variants||(a.best?.h??999)-(b.best?.h??999)||(a.best?.res??999)-(b.best?.res??999));
    return {box_index:id,done:b.done,complete:b.done===32,identity_count:identities.length,identities};
  });
  return {schema_version:1,version:"normalized-cached-aggregate-v1",artifact_count:objs.length,expected_artifact_count:416,complete:objs.length===416,positive_artifact_count:positiveArtifacts,boxes};
}
async function brBuildVariantTarget(env,id,vi){
  id=Math.max(0,Math.min(12,Number(id)||0));
  vi=Math.max(0,Math.min(3,Number(vi)||0));
  const loaded=await loadProofInputs(env,"perception/inputs/5a4e9b43b05b2fd6f998cf2725ac450c1dd483f58134d0dec4b4713622bfd393.png");
  const box=brLocalizerBoxes()[id];
  const v=brVariants(box)[vi];
  const features=brNormFeatures(loaded.image,v.box);
  const rows=features.map(f=>[f.x,f.y,lgDescToB64(f.descriptor)]);
  const key="debug/normalized-target-v1/b"+String(id).padStart(2,"0")+"-v"+vi+".json";
  await env.BENCHMARK_R2.put(key,JSON.stringify({schema_version:1,box_index:id,variant_index:vi,variant:v.kind,bbox:box,feature_count:features.length,features:rows}),{httpMetadata:{contentType:"application/json"},customMetadata:{artifact:"normalized-target-v1",box_index:String(id),variant_index:String(vi),variant:v.kind,feature_count:String(features.length)}});
  return {box_index:id,variant_index:vi,variant:v.kind,feature_count:features.length};
}
async function brLoadVariantTarget(env,id,vi){
  const key="debug/normalized-target-v1/b"+String(id).padStart(2,"0")+"-v"+vi+".json";
  const obj=await env.BENCHMARK_R2.get(key);
  if(!obj)throw new Error("normalized target missing "+id+"/"+vi);
  const r=JSON.parse(await new Response(obj.body).text());
  return {box:r.bbox,variant:r.variant,features:(r.features||[]).map(f=>({x:f[0],y:f[1],descriptor:lgB64ToDesc(f[2])}))};
}


async function brMatchCachedPart12(env,id,si,vi,pi){
  id=Math.max(0,Math.min(12,Number(id)||0));
  si=Math.max(0,Math.min(7,Number(si)||0));
  vi=Math.max(0,Math.min(3,Number(vi)||0));
  pi=Math.max(0,Math.min(15,Number(pi)||0));
  const target=await brLoadVariantTarget(env,id,vi);
  const bank=await lgLoadBank(env,"debug/whole-screen-local-feature-bank-v1/shards/shard-"+String(si).padStart(2,"0")+".json");
  const refs=bank.refs.slice(pi*12,pi*12+12);
  const index=glBuildIndex(refs);
  const per=glCollectPairsSelective(target.features,refs,index,96);
  const rank=glRankGeoShortlist(per,refs,{x:0,y:0},12);
  const all=rank.rows.map(q=>({...q,variant:target.variant,shard_index:si,variant_index:vi,part_index:pi}));
  const accepted=all.filter(r=>{const x=r.transform;if(!x)return false;return (x.inlier_count>=6&&x.mean_hamming<=18&&x.mean_residual<=2.5)||(x.inlier_count>=4&&x.mean_hamming<=4&&x.mean_residual<=1);});
  const result={schema_version:1,version:"normalized-cached-part12-v1",box_index:id,shard_index:si,variant_index:vi,part_index:pi,variant:target.variant,bbox:target.box,reference_count:refs.length,accepted_count:accepted.length,accepted:accepted.slice(0,6),top:all.slice(0,12)};
  const key="debug/normalized-cached-part12-v1/b"+String(id).padStart(2,"0")+"-s"+si+"-v"+vi+"-p"+String(pi).padStart(2,"0")+".json";
  const q=all[0];
  const best=q?{name:basename(q.asset_path),inliers:q.transform?.inlier_count||0,h:q.transform?.mean_hamming??null,res:q.transform?.mean_residual??null}:null;
  const acc=accepted.slice(0,4).map(r=>({name:basename(r.asset_path),inliers:r.transform?.inlier_count||0,h:r.transform?.mean_hamming??null,res:r.transform?.mean_residual??null,variant:target.variant,variant_index:vi,shard_index:si,part_index:pi}));
  await env.BENCHMARK_R2.put(key,JSON.stringify(result),{httpMetadata:{contentType:"application/json"},customMetadata:{artifact:"normalized-cached-part12-v1",box_index:String(id),shard_index:String(si),variant_index:String(vi),part_index:String(pi),variant:target.variant,reference_count:String(refs.length),accepted_count:String(accepted.length),best:JSON.stringify(best),accepted:JSON.stringify(acc)}});
  return result;
}
