  }
  if(chunkCount!==49)throw new Error("aggregate requires 49 chunks; found "+chunkCount);
  all.sort((a,b)=>a.score-b.score);
  const detections=[];
  for(const p of all){
    if(detections.some(d=>iou(d.bbox,p.bbox)>=0.50))continue;
    const nearby=all.filter(q=>iou(p.bbox,q.bbox)>=0.42).sort((a,b)=>a.score-b.score),candidates=[],seen=new Set();
    for(const q of nearby){if(seen.has(q.asset_path))continue;seen.add(q.asset_path);candidates.push({asset_path:q.asset_path,display_name:q.display_name,render_mode:q.render_mode,bbox:q.bbox,score:q.score,gradient_distance:q.gradient_distance,centered_rgb_distance:q.centered_rgb_distance,raw_rgb_mae:q.raw_rgb_mae,coarse_score:q.coarse_score});if(candidates.length>=6)break;}
    detections.push({bbox:p.bbox,score:p.score,candidates});if(detections.length>=50)break;
