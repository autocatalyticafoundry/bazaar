    if(!bestCluster){bestCluster={anchor_bbox:p.bbox,members:[]};clusters.push(bestCluster);}bestCluster.members.push(p);if(p.best_score<Math.min(...bestCluster.members.map(m=>m.best_score))+1e-12)bestCluster.anchor_bbox=p.bbox;
  }
