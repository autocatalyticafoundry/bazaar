async function lgReference(env,sha){if(localRefCache.has(sha))return localRefCache.get(sha);const p=(async()=>{const obj=await env.BENCHMARK_R2.get("catalogue/item-visual-normalized-v1/"+sha+".png");if(!obj)throw new Error("reference missing "+sha);const dec0=await decodePng(await new Response(obj.body).arrayBuffer()),dec=lgBoundReferenceImage(dec0,320),features=lgExtract(dec.rgba,dec.width,dec.height,180,true,2);return {width:dec.width,height:dec.height,features};})();localRefCache.set(sha,p);return p.catch(e=>{localRefCache.delete(sha);throw e;});}
