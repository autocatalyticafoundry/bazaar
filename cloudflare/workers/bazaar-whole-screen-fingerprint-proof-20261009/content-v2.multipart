let lgBankCacheKey=null,lgBankCache=null;
function lgDescToB64(d){let s="";for(let i=0;i<d.length;i++)s+=String.fromCharCode(d[i]);return btoa(s);}
function lgB64ToDesc(s){const b=atob(s),d=new Uint8Array(b.length);for(let i=0;i<b.length;i++)d[i]=b.charCodeAt(i);return d;}
async function lgItemSnapshotRows(env){
  const obj=await env.BENCHMARK_R2.get(SNAPSHOT_KEY);if(!obj)throw new Error("screen-native snapshot missing");
  const snap=JSON.parse(await new Response(obj.body).text());
  return (snap.fingerprints||[]).filter(r=>/\/items\//i.test(String(r.asset_path||""))&&r.source_sha256);
}
async function lgBankManifest(env,body){
  const out=String(body.output_key||""),batchSize=Math.max(1,Math.min(32,Number(body.batch_size)||12));
  const rows=await lgItemSnapshotRows(env),result={schema_version:1,bank_version:"whole-screen-local-feature-bank-v1",item_reference_count:rows.length,batch_size:batchSize,batch_count:Math.ceil(rows.length/batchSize)};
  await env.BENCHMARK_R2.put(out,JSON.stringify(result),{httpMetadata:{contentType:"application/json"},customMetadata:{artifact:"whole-screen-local-feature-bank-manifest-v1",item_reference_count:String(rows.length),batch_size:String(batchSize),batch_count:String(result.batch_count)}});
  return result;
}
async function lgBuildBankBatch(env,body){
  const out=String(body.output_key||""),offset=Math.max(0,Number(body.offset)||0),limit=Math.max(1,Math.min(32,Number(body.limit)||12));
  const rows=await lgItemSnapshotRows(env),selected=rows.slice(offset,offset+limit),built=[],failures=[];
  for(const r of selected){
    try{
      const ref=await lgReference(env,String(r.source_sha256));
      built.push({asset_path:r.asset_path,source_sha256:r.source_sha256,width:ref.width,height:ref.height,features:ref.features.map(f=>[f.x,f.y,lgDescToB64(f.descriptor)])});
    }catch(e){failures.push({asset_path:r.asset_path,error:e instanceof Error?e.message:String(e)});}
  }
  const result={schema_version:1,bank_version:"whole-screen-local-feature-bank-v1",offset,limit,attempted:selected.length,built_count:built.length,failure_count:failures.length,rows:built,failures};
  await env.BENCHMARK_R2.put(out,JSON.stringify(result),{httpMetadata:{contentType:"application/json"},customMetadata:{artifact:"whole-screen-local-feature-bank-batch-v1",offset:String(offset),attempted:String(selected.length),built_count:String(built.length),failure_count:String(failures.length)}});
  return result;
}
async function lgAggregateBank(env,body){
  const base=String(body.base_key||""),out=String(body.output_key||""),batchCount=Math.max(1,Number(body.batch_count)||1),rows=[],failures=[];
  for(let i=0;i<batchCount;i++){
    const key=base+"/batch-"+String(i).padStart(3,"0")+".json",obj=await env.BENCHMARK_R2.get(key);if(!obj){failures.push({batch:i,error:"missing"});continue;}
    const part=JSON.parse(await new Response(obj.body).text());rows.push(...(part.rows||[]));failures.push(...(part.failures||[]).map(x=>({...x,batch:i})));
  }
  const result={schema_version:1,bank_version:"whole-screen-local-feature-bank-v1",reference_count:rows.length,batch_count:batchCount,failure_count:failures.length,rows,failures};
  await env.BENCHMARK_R2.put(out,JSON.stringify(result),{httpMetadata:{contentType:"application/json"},customMetadata:{artifact:"whole-screen-local-feature-bank-v1",reference_count:String(rows.length),batch_count:String(batchCount),failure_count:String(failures.length)}});
  lgBankCacheKey=null;lgBankCache=null;return result;
}
async function lgLoadBank(env,key){
  if(lgBankCacheKey===key&&lgBankCache)return lgBankCache;
