  await proofProgress(env,progressKey,"refs_prepared",{refs:refs.length});
  const hfs=[0.075,0.10,0.135,0.18,0.24,0.32,0.40],ars=[0.52,0.62,0.72,0.82,0.94,1.08,1.24],minDim=Math.min(image.width,image.height),height=Math.max(72,Math.round(minDim*hfs[hi])),ar=ars[ai],width=Math.max(48,Math.round(height*ar));
