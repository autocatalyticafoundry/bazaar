  for(const p of pairs.slice(0,360)){const key=[p.bbox.x,p.bbox.y,p.bbox.width,p.bbox.height].join(",");let s=cache.get(key);if(!s){s=sampleGrid(image,p.bbox,16);cache.set(key,s);}const ref=refByPath.get(p.asset_path);if(!ref)continue;exact.push({...p,...structuralScore(s,ref.rgb16)});scored++;if(scored%100===0)await proofProgress(env,progressKey,"exact_progress",{scored});}
  await proofProgress(env,progressKey,"complete",{windows,exact:exact.length});
  return {windows,exact:exact.length};
}

function evalIou(a,b){return iou(a,b);}
async function evaluateExistingChunks(env,body){
  const base=String(body.base_key||""),out=String(body.output_key||"");
  const sgwTruth={x:997,y:339,width:311,height:494},hudTruth={x:119,y:668,width:165,height:210};
  const all=[];let chunkCount=0,totalWindows=0;
  for(let h=0;h<7;h++)for(let a=0;a<7;a++){
    const obj=await env.BENCHMARK_R2.get(base+"/chunk-"+h+"-"+a+".json");if(!obj)continue;
    const row=JSON.parse(await new Response(obj.body).text());chunkCount++;totalWindows+=Number(row.searched_window_count||0);
    for(const c of row.exact_candidates||[])all.push({...c,hf_index:h,ar_index:a});
  }
  const norm=s=>String(s||"").toLowerCase().replace(/[^a-z0-9]/g,"");
  const sgw=all.filter(c=>norm(c.asset_path).includes("stainedglasswindow")).sort((a,b)=>a.score-b.score);
  const hands=all.filter(c=>norm(c.asset_path).includes("handsoftime")).sort((a,b)=>a.score-b.score);
  const global=[...all].sort((a,b)=>a.score-b.score);
  const clusters=[];
  for(const c of global){
    if(clusters.some(x=>evalIou(x.bbox,c.bbox)>=0.5))continue;
    clusters.push(c);if(clusters.length>=30)break;
  }
  const s=sgw[0]||null,h=hands[0]||null;
  const topAssets=[];const seen=new Set();
  for(const c of global){if(seen.has(c.asset_path))continue;seen.add(c.asset_path);topAssets.push({name:c.display_name,path:c.asset_path,score:c.score,bbox:c.bbox});if(topAssets.length>=12)break;}
  const result={schema_version:1,evaluation_version:"whole-screen-reference-proof-v2-partial-eval",generated_at:new Date().toISOString(),chunk_count:chunkCount,total_windows:totalWindows,total_exact_candidates:all.length,sgw_best:s?{asset_path:s.asset_path,display_name:s.display_name,score:s.score,bbox:s.bbox,truth_iou:evalIou(s.bbox,sgwTruth),hf_index:s.hf_index,ar_index:s.ar_index}:null,hands_best:h?{asset_path:h.asset_path,display_name:h.display_name,score:h.score,bbox:h.bbox,hud_iou:evalIou(h.bbox,hudTruth),hf_index:h.hf_index,ar_index:h.ar_index}:null,top_spatial_clusters:clusters.slice(0,20),top_unique_assets:topAssets};
  await env.BENCHMARK_R2.put(out,JSON.stringify(result),{httpMetadata:{contentType:"application/json"},customMetadata:{artifact:"whole-screen-reference-proof-v2-partial-eval",chunk_count:String(chunkCount),window_count:String(totalWindows),exact_candidates:String(all.length),sgw_found:String(!!s),sgw_score:s?String(s.score):"",sgw_bbox:s?JSON.stringify(s.bbox):"",sgw_truth_iou:s?String(evalIou(s.bbox,sgwTruth)):"",sgw_chunk:s?String(s.hf_index)+","+String(s.ar_index):"",hands_found:String(!!h),hands_score:h?String(h.score):"",hands_bbox:h?JSON.stringify(h.bbox):"",hands_hud_iou:h?String(evalIou(h.bbox,hudTruth)):"",hands_chunk:h?String(h.hf_index)+","+String(h.ar_index):"",top_assets:topAssets.slice(0,5).map(x=>x.name+":"+x.score.toFixed(4)).join("|")}});
  return result;
}

async function evaluateOneChunk(env,body){
  const chunkKey=String(body.chunk_key||""),out=String(body.output_key||"");
  const obj=await env.BENCHMARK_R2.get(chunkKey);if(!obj)throw new Error("chunk missing");
  const row=JSON.parse(await new Response(obj.body).text());
  const candidates=Array.isArray(row.exact_candidates)?row.exact_candidates:[];
  const norm=s=>String(s||"").toLowerCase().replace(/[^a-z0-9]/g,"");
  const sgw=candidates.filter(c=>norm(c.asset_path).includes("stainedglasswindow")).sort((a,b)=>a.score-b.score);
  const hands=candidates.filter(c=>norm(c.asset_path).includes("handsoftime")).sort((a,b)=>a.score-b.score);
  const truth={x:997,y:339,width:311,height:494},hud={x:119,y:668,width:165,height:210};
  const top=[...candidates].sort((a,b)=>a.score-b.score).slice(0,10);
  const s=sgw[0]||null,h=hands[0]||null;
  const result={schema_version:1,evaluation_version:"whole-screen-reference-proof-v2-chunk-eval",chunk_key:chunkKey,window_count:row.searched_window_count||0,candidate_count:candidates.length,sgw_best:s?{...s,truth_iou:iou(s.bbox,truth)}:null,hands_best:h?{...h,hud_iou:iou(h.bbox,hud)}:null,top};
  await env.BENCHMARK_R2.put(out,JSON.stringify(result),{httpMetadata:{contentType:"application/json"},customMetadata:{artifact:"whole-screen-reference-proof-v2-chunk-eval",chunk_key:chunkKey.slice(-32),window_count:String(row.searched_window_count||0),candidate_count:String(candidates.length),sgw_found:String(!!s),sgw_score:s?String(s.score):"",sgw_bbox:s?JSON.stringify(s.bbox):"",sgw_iou:s?String(iou(s.bbox,truth)):"",hands_found:String(!!h),hands_score:h?String(h.score):"",hands_bbox:h?JSON.stringify(h.bbox):"",hands_iou:h?String(iou(h.bbox,hud)):"",top_names:top.slice(0,6).map(x=>String(x.display_name||"")+"@"+Number(x.score).toFixed(4)).join("|")}});
  return result;
}

function verifierGrid2(data,width,height,rect,gridSize=24){
  const rgb=new Float64Array(gridSize*gridSize*3),alpha=new Float64Array(gridSize*gridSize);let out=0,ai=0;
  for(let gy=0;gy<gridSize;gy++){const sy=Math.max(0,Math.min(height-1,rect.y+(gy+0.5)*rect.height/gridSize-0.5)),y0=Math.floor(sy),y1=Math.min(height-1,y0+1),fy=sy-y0;
    for(let gx=0;gx<gridSize;gx++){const sx=Math.max(0,Math.min(width-1,rect.x+(gx+0.5)*rect.width/gridSize-0.5)),x0=Math.floor(sx),x1=Math.min(width-1,x0+1),fx=sx-x0,i00=(y0*width+x0)*4,i10=(y0*width+x1)*4,i01=(y1*width+x0)*4,i11=(y1*width+x1)*4;
      for(let c=0;c<3;c++){const top=data[i00+c]*(1-fx)+data[i10+c]*fx,bottom=data[i01+c]*(1-fx)+data[i11+c]*fx;rgb[out++]=top*(1-fy)+bottom*fy;}
      const topA=data[i00+3]*(1-fx)+data[i10+3]*fx,bottomA=data[i01+3]*(1-fx)+data[i11+3]*fx;alpha[ai++]=(topA*(1-fy)+bottomA*fy)/255;
    }
  }return {rgb,alpha};
}
function verifierGray2(grid){const out=new Float64Array(grid.alpha.length);for(let p=0;p<out.length;p++){const i=p*3;out[p]=grid.rgb[i]*0.299+grid.rgb[i+1]*0.587+grid.rgb[i+2]*0.114;}return out;}
function verifierHog2(grid,mask,gridSize=24,cells=4,bins=8){const gray=verifierGray2(grid),d=new Float64Array(cells*cells*bins),cellSize=gridSize/cells;for(let y=1;y<gridSize-1;y++)for(let x=1;x<gridSize-1;x++){const p=y*gridSize+x,gx=gray[p+1]-gray[p-1],gy=gray[p+gridSize]-gray[p-gridSize],mag=Math.sqrt(gx*gx+gy*gy);if(mag<=1e-6)continue;let angle=Math.atan2(gy,gx);if(angle<0)angle+=Math.PI;if(angle>=Math.PI)angle-=Math.PI;const bin=Math.min(bins-1,Math.floor(angle/Math.PI*bins)),cx=Math.min(cells-1,Math.floor(x/cellSize)),cy=Math.min(cells-1,Math.floor(y/cellSize)),w=Math.max(0.04,mask[p]);d[(cy*cells+cx)*bins+bin]+=mag*w;}for(let cell=0;cell<cells*cells;cell++){let n=0,start=cell*bins;for(let b=0;b<bins;b++)n+=d[start+b]*d[start+b];n=Math.sqrt(n)+1e-9;for(let b=0;b<bins;b++)d[start+b]/=n;}return d;}
function verifierHogDistance2(reference,screenshot){const mask=new Float64Array(reference.alpha.length),am=reference.alpha.reduce((s,v)=>s+v,0)/Math.max(1,reference.alpha.length);for(let i=0;i<mask.length;i++)mask[i]=am<0.985?Math.max(0.04,reference.alpha[i]**1.5):1;const a=verifierHog2(reference,mask),b=verifierHog2(screenshot,mask);let dot=0,an=0,bn=0;for(let i=0;i<a.length;i++){dot+=a[i]*b[i];an+=a[i]*a[i];bn+=b[i]*b[i];}const den=Math.sqrt(an*bn),cos=den>1e-9?Math.max(-1,Math.min(1,dot/den)):0;return (1-cos)/2;}
function verifierScore2(reference,screenshot){let wt=0;const rm=[0,0,0],sm=[0,0,0],weights=new Float64Array(reference.alpha.length),am=reference.alpha.reduce((s,v)=>s+v,0)/Math.max(1,reference.alpha.length);for(let p=0;p<reference.alpha.length;p++){const w=am<0.985?Math.max(0.04,reference.alpha[p]**1.5):1;weights[p]=w;wt+=w;for(let c=0;c<3;c++){rm[c]+=reference.rgb[p*3+c]*w;sm[c]+=screenshot.rgb[p*3+c]*w;}}for(let c=0;c<3;c++){rm[c]/=Math.max(1e-9,wt);sm[c]/=Math.max(1e-9,wt);}let raw=0,centered=0,dot=0,rn=0,sn=0;for(let p=0;p<weights.length;p++){const w=weights[p];let rg=0,sg=0;for(let c=0;c<3;c++){const ri=reference.rgb[p*3+c],si=screenshot.rgb[p*3+c];raw+=Math.abs(ri-si)*w;centered+=Math.abs(ri-rm[c]-(si-sm[c]))*w;const gw=c===0?0.299:c===1?0.587:0.114;rg+=(ri-rm[c])*gw;sg+=(si-sm[c])*gw;}dot+=rg*sg*w;rn+=rg*rg*w;sn+=sg*sg*w;}const den=Math.sqrt(rn*sn),corr=den>1e-9?Math.max(-1,Math.min(1,dot/den)):0,rawMae=raw/(Math.max(1e-9,wt)*3*255),centeredMae=centered/(Math.max(1e-9,wt)*3*255),corrLoss=(1-corr)/2,hog=verifierHogDistance2(reference,screenshot);return {score:hog*0.68+centeredMae*0.22+rawMae*0.07+corrLoss*0.03,raw_rgb_mae:rawMae,centered_rgb_mae:centeredMae,correlation_loss:corrLoss,hog_distance:hog};}
function cropRgba2(image,box){const x=Math.max(0,Math.floor(box.x)),y=Math.max(0,Math.floor(box.y)),width=Math.max(1,Math.min(image.width-x,Math.floor(box.width))),height=Math.max(1,Math.min(image.height-y,Math.floor(box.height))),rgba=new Uint8ClampedArray(width*height*4);for(let r=0;r<height;r++){const a=((y+r)*image.width+x)*4;rgba.set(image.rgba.subarray(a,a+width*4),r*width*4);}return {rgba,width,height};}
function verifyOneReference2(crop,refImage){
  const reference=verifierGrid2(refImage.rgba,refImage.width,refImage.height,{x:0,y:0,width:refImage.width,height:refImage.height}),refAspect=refImage.width/Math.max(1,refImage.height),cropAspect=crop.width/Math.max(1,crop.height);let baseWidth,baseHeight;
  if(cropAspect>=refAspect){baseHeight=crop.height;baseWidth=baseHeight*refAspect;}else{baseWidth=crop.width;baseHeight=baseWidth/Math.max(1e-9,refAspect);}
  let best=null;const evalRect=(rect,scale,centerY,mode)=>{const shot=verifierGrid2(crop.rgba,crop.width,crop.height,rect),s=verifierScore2(reference,shot),row={...s,scale,center_y_fraction:centerY,mode};if(!best||row.score<best.score)best=row;};
  evalRect({x:0,y:0,width:crop.width,height:crop.height},1,0.5,"stretch_full");
  for(const scale of [0.58,0.7,0.82,0.94])for(const centerY of [0.38,0.46,0.54,0.62]){const width=Math.max(8,baseWidth*scale),height=Math.max(8,baseHeight*scale),x=Math.max(0,Math.min(crop.width-width,(crop.width-width)/2)),y=Math.max(0,Math.min(crop.height-height,crop.height*centerY-height/2));evalRect({x,y,width,height},scale,centerY,"aspect_window");}
  return best;
}
async function verifyDiscoveredBox(env,body){
  const inputKey=String(body.input_key||""),chunkKey=String(body.chunk_key||""),out=String(body.output_key||""),bbox=body.bbox;
  const input=await env.BENCHMARK_R2.get(inputKey);if(!input)throw new Error("input missing");const png=await decodePng(await new Response(input.body).arrayBuffer()),image={width:png.width,height:png.height,rgba:png.rgba},crop=cropRgba2(image,bbox);
  const chunkObj=await env.BENCHMARK_R2.get(chunkKey);if(!chunkObj)throw new Error("chunk missing");const chunk=JSON.parse(await new Response(chunkObj.body).text()),near=(chunk.exact_candidates||[]).filter(c=>iou(c.bbox,bbox)>=0.42).sort((a,b)=>a.score-b.score);
  const paths=[];for(const c of near){if(!paths.includes(c.asset_path)){paths.push(c.asset_path);if(paths.length>=8)break;}}
  const snapObj=await env.BENCHMARK_R2.get(SNAPSHOT_KEY);if(!snapObj)throw new Error("snapshot missing");const snapshot=JSON.parse(await new Response(snapObj.body).text()),fpByPath=new Map((snapshot.fingerprints||[]).map(r=>[r.asset_path,r]));
  const sgwPath=(snapshot.fingerprints||[]).find(r=>String(r.asset_path||"").toLowerCase().includes("stainedglasswindow"))?.asset_path||null;if(sgwPath&&!paths.includes(sgwPath))paths.push(sgwPath);
  const rows=[];
  for(const path of paths){const fp=fpByPath.get(path);if(!fp||!fp.source_sha256){rows.push({asset_path:path,available:false,reason:"fingerprint_sha_missing"});continue;}const key="catalogue/item-visual-normalized-v1/"+fp.source_sha256+".png",obj=await env.BENCHMARK_R2.get(key);if(!obj){rows.push({asset_path:path,available:false,reason:"normalized_reference_missing",key});continue;}const ref=await decodePng(await new Response(obj.body).arrayBuffer()),score=verifyOneReference2(crop,ref);rows.push({asset_path:path,available:true,key,...score});}
  const ranked=rows.filter(r=>r.available&&typeof r.score==="number").sort((a,b)=>a.score-b.score),sgw=ranked.find(r=>String(r.asset_path).toLowerCase().includes("stainedglasswindow"))||null;
  const result={schema_version:1,proof_version:"whole-screen-reference-proof-v3-hog-verify",bbox,candidate_paths:paths,ranked,sgw_rank:sgw?ranked.indexOf(sgw)+1:null,sgw};
  await env.BENCHMARK_R2.put(out,JSON.stringify(result),{httpMetadata:{contentType:"application/json"},customMetadata:{artifact:"whole-screen-reference-proof-v3-hog-verify",bbox:JSON.stringify(bbox),candidate_count:String(paths.length),available_count:String(ranked.length),best_asset_path:ranked[0]?.asset_path||"",best_score:ranked[0]?String(ranked[0].score):"",margin:ranked[0]&&ranked[1]?String(ranked[1].score-ranked[0].score):"",sgw_rank:sgw?String(ranked.indexOf(sgw)+1):"",sgw_score:sgw?String(sgw.score):"",top3:ranked.slice(0,3).map(r=>basename(r.asset_path)+"@"+r.score.toFixed(4)).join("|")}});
  return result;
}

async function nearbyCandidatesJob(env,body){
  const chunkKey=String(body.chunk_key||""),out=String(body.output_key||""),bbox=body.bbox;
  const obj=await env.BENCHMARK_R2.get(chunkKey);if(!obj)throw new Error("chunk missing");const chunk=JSON.parse(await new Response(obj.body).text()),near=(chunk.exact_candidates||[]).filter(c=>iou(c.bbox,bbox)>=0.42).sort((a,b)=>a.score-b.score);
  const paths=[];for(const c of near){if(!paths.includes(c.asset_path)){paths.push(c.asset_path);if(paths.length>=8)break;}}
  const snapObj=await env.BENCHMARK_R2.get(SNAPSHOT_KEY);if(!snapObj)throw new Error("snapshot missing");const snap=JSON.parse(await new Response(snapObj.body).text()),map=new Map((snap.fingerprints||[]).map(r=>[r.asset_path,r]));
  const sgw=(snap.fingerprints||[]).find(r=>String(r.asset_path||"").toLowerCase().includes("stainedglasswindow"))?.asset_path||null;if(sgw&&!paths.includes(sgw))paths.push(sgw);
  const candidates=paths.map(path=>({asset_path:path,source_sha256:map.get(path)?.source_sha256||null}));
  await env.BENCHMARK_R2.put(out,JSON.stringify({schema_version:1,bbox,candidates}),{httpMetadata:{contentType:"application/json"},customMetadata:{artifact:"whole-screen-reference-proof-nearby-candidates",bbox:JSON.stringify(bbox),candidate_count:String(candidates.length),candidates:JSON.stringify(candidates)}});
  return candidates;
}
async function verifyOneReferenceJob(env,body){
  const inputKey=String(body.input_key||""),out=String(body.output_key||""),assetPath=String(body.asset_path||""),sha=String(body.source_sha256||""),bbox=body.bbox;if(!assetPath||!sha)throw new Error("asset_path/source_sha256 required");
  const input=await env.BENCHMARK_R2.get(inputKey);if(!input)throw new Error("input missing");const png=await decodePng(await new Response(input.body).arrayBuffer()),image={width:png.width,height:png.height,rgba:png.rgba},crop=cropRgba2(image,bbox);
  const key="catalogue/item-visual-normalized-v1/"+sha+".png",obj=await env.BENCHMARK_R2.get(key);if(!obj)throw new Error("normalized reference missing: "+key);const ref=await decodePng(await new Response(obj.body).arrayBuffer()),score=verifyOneReference2(crop,ref);
