async function vxLoadBatch(env,start,count){
  start=Math.max(0,Number(start)||0);
  count=Math.max(1,Math.min(150,Number(count)||100));
  const obj=await env.BENCHMARK_R2.get(SNAPSHOT_KEY);
  if(!obj)throw new Error("snapshot missing");
  const snap=JSON.parse(await new Response(obj.body).text());
  const refs=(snap.fingerprints||[]).filter(r=>/\/items\//i.test(r.asset_path||"")&&r.rgb16);
  const end=Math.min(refs.length,start+count),vectors=[];
  for(let i=start;i<end;i++){
    const r=refs[i],bytes=b64bytes(r.rgb16),values=Array.from(bytes,x=>x/255);
    vectors.push({id:String(i),values,metadata:{asset_path:String(r.asset_path||""),name:basename(r.asset_path||""),source_sha256:String(r.source_sha256||"")}});
  }
  const result=await env.VISUAL_INDEX.upsert(vectors);
  return {reference_count:refs.length,start,count:end-start,upserted:vectors.length,result};
}
function vxCropVector(image,box){
  const b=sampleGrid(image,box,16),v=new Array(b.length);
  for(let i=0;i<b.length;i++)v[i]=b[i]/255;
  return v;
}



function vxPreferredVariant(box){
  const vars=brVariants(box);
  return vars.find(v=>v.kind==="center")||vars[0];
}
async function vxCrop16VariantJob(env,id,vi){id=Math.max(0,Math.min(12,Number(id)||0));vi=Math.max(0,Math.min(3,Number(vi)||0));const box=brLocalizerBoxes()[id],vars=brVariants(box),v=vars[vi]||vars[0],obj=await env.BENCHMARK_R2.get("perception/inputs/5a4e9b43b05b2fd6f998cf2725ac450c1dd483f58134d0dec4b4713622bfd393.png");if(!obj)throw new Error("input missing");const trim={top:Math.max(0,Math.floor(v.box.y)),left:Math.max(0,Math.floor(v.box.x)),width:Math.max(1,Math.floor(v.box.width)),height:Math.max(1,Math.floor(v.box.height))},out=await env.IMAGES.input(obj.body).transform({trim}).transform({width:16,height:16,fit:"squeeze"}).output({format:"image/png"}),resp=out.response(),png=await decodePng(await resp.arrayBuffer()),values=new Array(16*16*3);let k=0;for(let i=0;i<png.rgba.length;i+=4){values[k++]=png.rgba[i]/255;values[k++]=png.rgba[i+1]/255;values[k++]=png.rgba[i+2]/255;}const q=await env.VISUAL_INDEX.query(values,{topK:12,returnMetadata:"all"}),matches=(q.matches||[]).map((m,rank)=>({rank,id:m.id,score:m.score,metadata:m.metadata||{}})),result={schema_version:1,box_index:id,variant_index:vi,variant:v.kind,trim,output:{width:png.width,height:png.height},matches},key="debug/vector-crop16-v2/b"+String(id).padStart(2,"0")+"-v"+vi+".json";await env.BENCHMARK_R2.put(key,JSON.stringify(result),{httpMetadata:{contentType:"application/json"},customMetadata:{artifact:"vector-crop16-v2",box_index:String(id),variant_index:String(vi),variant:v.kind,match_count:String(matches.length),top:JSON.stringify(matches.slice(0,6).map(m=>({rank:m.rank,score:m.score,name:m.metadata?.name||basename(m.metadata?.asset_path||"")})))}});return result;}
async function vxCrop16Box(env,id){
  id=Math.max(0,Math.min(12,Number(id)||0));
  const box=brLocalizerBoxes()[id],v=vxPreferredVariant(box);
  const obj=await env.BENCHMARK_R2.get("perception/inputs/5a4e9b43b05b2fd6f998cf2725ac450c1dd483f58134d0dec4b4713622bfd393.png");
  if(!obj)throw new Error("input missing");
  const trim={top:Math.max(0,Math.floor(v.box.y)),left:Math.max(0,Math.floor(v.box.x)),width:Math.max(1,Math.floor(v.box.width)),height:Math.max(1,Math.floor(v.box.height))};
  const out=await env.IMAGES.input(obj.body).transform({trim}).transform({width:16,height:16,fit:"squeeze"}).output({format:"image/png"});
  const resp=out.response(),png=await decodePng(await resp.arrayBuffer()),values=new Array(16*16*3);
  let k=0;for(let i=0;i<png.rgba.length;i+=4){values[k++]=png.rgba[i]/255;values[k++]=png.rgba[i+1]/255;values[k++]=png.rgba[i+2]/255;}
  const q=await env.VISUAL_INDEX.query(values,{topK:12,returnMetadata:"all"});
  return {box_index:id,variant:v.kind,trim,output:{width:png.width,height:png.height},matches:(q.matches||[]).map(m=>({id:m.id,score:m.score,metadata:m.metadata||{}}))};
}
async function vxLoadScaledImage(env,width=384){
  width=Math.max(128,Math.min(768,Number(width)||384));
  const obj=await env.BENCHMARK_R2.get("perception/inputs/5a4e9b43b05b2fd6f998cf2725ac450c1dd483f58134d0dec4b4713622bfd393.png");
  if(!obj)throw new Error("input missing");
  const out=await env.IMAGES.input(obj.body).transform({width,fit:"scale-down"}).output({format:"image/png"});
  const resp=out.response(),ab=await resp.arrayBuffer(),png=await decodePng(ab);
  return {image:{width:png.width,height:png.height,rgba:png.rgba},source_width:2048,source_height:1409};
}
function vxScaleBoxToImage(box,scaled){
  const sx=scaled.image.width/scaled.source_width,sy=scaled.image.height/scaled.source_height;
  return {x:box.x*sx,y:box.y*sy,width:box.width*sx,height:box.height*sy};
}
async function vxQueryBoxScaled(env,id,width=384){
  id=Math.max(0,Math.min(12,Number(id)||0));
  const scaled=await vxLoadScaledImage(env,width),box0=brLocalizerBoxes()[id],box=vxScaleBoxToImage(box0,scaled),rows=[];
  for(const v of brVariants(box)){
    const q=await env.VISUAL_INDEX.query(vxCropVector(scaled.image,v.box),{topK:8,returnMetadata:"all"});
    for(const m of q.matches||[])rows.push({variant:v.kind,score:m.score,id:m.id,metadata:m.metadata||{}});
  }
  rows.sort((a,b)=>a.score-b.score);
  const out=[],seen=new Set();
  for(const r of rows){const p=String(r.metadata?.asset_path||r.id);if(seen.has(p))continue;seen.add(p);out.push(r);if(out.length>=12)break;}
  return {box_index:id,scaled_width:scaled.image.width,scaled_height:scaled.image.height,bbox:box,top:out};
}
async function vxVerifyBox(env,id,limit=5){
  id=Math.max(0,Math.min(12,Number(id)||0));limit=Math.max(1,Math.min(8,Number(limit)||5));
  const loaded=await loadProofInputs(env,"perception/inputs/5a4e9b43b05b2fd6f998cf2725ac450c1dd483f58134d0dec4b4713622bfd393.png");
  const box=brLocalizerBoxes()[id],vars=brVariants(box),all=[];
  for(const v of vars){
    const q=await env.VISUAL_INDEX.query(vxCropVector(loaded.image,v.box),{topK:8,returnMetadata:"all"});
    for(const m of q.matches||[])all.push({variant:v.kind,vector_score:m.score,id:m.id,metadata:m.metadata||{}});
  }
  all.sort((a,b)=>a.vector_score-b.vector_score);
  const candidates=[],seen=new Set();
  for(const r of all){const p=String(r.metadata?.asset_path||r.id);if(seen.has(p))continue;seen.add(p);candidates.push(r);if(candidates.length>=limit)break;}
  const tf=new Map(),geometry=[];
  for(const c of candidates){
    const v=vars.find(x=>x.kind===c.variant)||vars[0];
    let target=tf.get(v.kind);if(!target){target=brNormFeatures(loaded.image,v.box);tf.set(v.kind,target);}
    const sha=String(c.metadata?.source_sha256||"");if(!sha){geometry.push({...c,error:"missing sha"});continue;}
    const ref=await lgReference(env,sha),e=lgEstimate(target,ref.features),t=e.transform;
    geometry.push({...c,pair_count:e.pair_count,transform:t,accepted:!!(t&&((t.inlier_count>=6&&t.mean_hamming<=18&&t.mean_residual<=2.5)||(t.inlier_count>=4&&t.mean_hamming<=4&&t.mean_residual<=1)))});
  }
  geometry.sort((a,b)=>(b.transform?.inlier_count||0)-(a.transform?.inlier_count||0)||(a.transform?.mean_hamming??999)-(b.transform?.mean_hamming??999)||(a.transform?.mean_residual??999)-(b.transform?.mean_residual??999));
  return {box_index:id,bbox:box,candidate_count:candidates.length,candidates,geometry};
}
async function vxQueryBox(env,id){
  id=Math.max(0,Math.min(12,Number(id)||0));
  const loaded=await loadProofInputs(env,"perception/inputs/5a4e9b43b05b2fd6f998cf2725ac450c1dd483f58134d0dec4b4713622bfd393.png");
  const box=brLocalizerBoxes()[id],rows=[];
  for(const v of brVariants(box)){
    const q=await env.VISUAL_INDEX.query(vxCropVector(loaded.image,v.box),{topK:8,returnMetadata:"all"});
    for(const m of q.matches||[])rows.push({variant:v.kind,score:m.score,id:m.id,metadata:m.metadata||{}});
  }
  rows.sort((a,b)=>a.score-b.score);
  const out=[],seen=new Set();
  for(const r of rows){const p=String(r.metadata?.asset_path||r.id);if(seen.has(p))continue;seen.add(p);out.push(r);if(out.length>=12)break;}
  return {box_index:id,bbox:box,top:out};
}
async function brRankBoxJob(env,id){
  id=Math.max(0,Math.min(12,Number(id)||0));
  const r=await brRankRange(env,id,1);
  const row=r.rows&&r.rows[0]?r.rows[0]:null;
  const key="debug/fingerprint-rank-v1/b"+String(id).padStart(2,"0")+".json";
  await env.BENCHMARK_R2.put(key,JSON.stringify({schema_version:1,...r}),{httpMetadata:{contentType:"application/json"},customMetadata:{
    artifact:"fingerprint-rank-v1",
    box_index:String(id),
    best:JSON.stringify(row&&row.best?{name:row.best.name,score:row.best.score,variant:row.best.variant}:null),
