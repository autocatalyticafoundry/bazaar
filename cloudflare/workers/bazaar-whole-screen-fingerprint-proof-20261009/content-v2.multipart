function basename(path) { const s=path.split("/").pop()||path; return s.replace(/\.[^.]+$/,""); }


const proofInputCache=new Map();
async function loadProofInputs(env,inputKey){
  if(proofInputCache.has(inputKey)) return proofInputCache.get(inputKey);
  const promise=(async()=>{
    const input=await env.BENCHMARK_R2.get(inputKey); if(!input)throw new Error("input missing");
    const png=await decodePng(await new Response(input.body).arrayBuffer());
    const image={width:png.width,height:png.height,rgba:png.rgba};
    const catObj=await env.BENCHMARK_R2.get(SNAPSHOT_KEY); if(!catObj)throw new Error("screen-native snapshot missing");
    const snapshot=JSON.parse(await new Response(catObj.body).text());
    const refs=(snapshot.fingerprints||[]).filter(r=>/\/items\//i.test(r.asset_path)&&r.rgb16).map(r=>{const rgb16=b64bytes(r.rgb16);return {asset_path:r.asset_path,display_name:basename(r.asset_path),render_mode:r.render_mode,source_sha256:r.source_sha256||null,rgb16,rgb4:block4(rgb16),mean:[Number(r.mean_r),Number(r.mean_g),Number(r.mean_b)]};});
    return {png,image,refs};
  })().catch(e=>{proofInputCache.delete(inputKey);throw e;});
  proofInputCache.set(inputKey,promise);
  return promise;
}
async function runChunk(env,body){
