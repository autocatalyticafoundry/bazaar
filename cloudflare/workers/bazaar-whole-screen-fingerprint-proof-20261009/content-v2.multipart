async function lgScanBankTile(env,body){
  const inputKey=String(body.input_key||""),bankKey=String(body.bank_key||""),out=String(body.output_key||""),tile=body.tile,shortlistN=Math.max(8,Math.min(96,Number(body.shortlist)||48));
  const loaded=await loadProofInputs(env,inputKey),crop=lgCrop(loaded.image,tile),target=lgExtract(crop.data,crop.width,crop.height,260,false,2),bank=await lgLoadBank(env,bankKey),votes=new Float64Array(bank.refs.length),offs=[0,4,8,12];
  for(const f of target)for(let bi=0;bi<offs.length;bi++){const o=offs[bi],base=(f.descriptor[o]<<8)|f.descriptor[o+1],prefix=bi<<16;const exact=bank.index.get(prefix|base);if(exact)for(const ri of exact)votes[ri]+=2;for(let bit=0;bit<16;bit++){const arr=bank.index.get(prefix|(base^(1<<bit)));if(arr)for(const ri of arr)votes[ri]+=1;}}
  const rankedVotes=Array.from(votes,(v,i)=>({i,v,n:bank.refs[i].features.length,score:v/Math.sqrt(Math.max(1,target.length*bank.refs[i].features.length))})).sort((a,b)=>b.score-a.score||b.v-a.v).slice(0,shortlistN);
