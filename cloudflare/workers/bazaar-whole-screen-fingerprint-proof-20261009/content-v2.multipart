  const minDim=Math.min(image.width,image.height),height=Math.max(72,Math.round(minDim*hfs[hi])),ar=ars[ai],width=Math.max(48,Math.round(height*ar));
  if(width>=image.width||height>=image.height)throw new Error("chunk geometry outside source");
  const xs=positions(image.width-width,Math.max(34,Math.round(width*0.76))),ys=positions(image.height-height,Math.max(42,Math.round(height*0.66)));
  const pairs=[];let windows=0;
  for(const y of ys)for(const x of xs){
    const bbox={x,y,width,height},rgb4=sampleGrid(image,bbox,4),m=meanRgb(rgb4),color=[];
    for(const ref of refs){
      const d=(Math.abs(m[0]-ref.mean[0])+Math.abs(m[1]-ref.mean[1])+Math.abs(m[2]-ref.mean[2]))/(3*255);
      if(color.length<72){color.push({ref,d});if(color.length===72)color.sort((a,b)=>a.d-b.d);}
      else if(d<color[71].d){color[71]={ref,d};color.sort((a,b)=>a.d-b.d);}
    }
    const top=color.map(({ref,d})=>({ref,coarse:mae(rgb4,ref.rgb4)*0.88+d*0.12})).sort((a,b)=>a.coarse-b.coarse).slice(0,8);
    for(const t of top)pairs.push({bbox,asset_path:t.ref.asset_path,display_name:t.ref.display_name,render_mode:t.ref.render_mode,coarse_score:t.coarse});
    windows++;
  }
  pairs.sort((a,b)=>a.coarse_score-b.coarse_score);
  const refByPath=new Map(refs.map(r=>[r.asset_path,r])),cache=new Map(),exact=[];
  for(const p of pairs.slice(0,360)){
    const key=[p.bbox.x,p.bbox.y,p.bbox.width,p.bbox.height].join(",");
    let s=cache.get(key);if(!s){s=sampleGrid(image,p.bbox,16);cache.set(key,s);}
