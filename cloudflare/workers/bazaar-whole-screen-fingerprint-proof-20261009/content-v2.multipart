async function runAggregate(env,body){
  const base=String(body.base_key||""),outputKey=String(body.output_key||"");const all=[];let chunkCount=0,totalWindows=0,referenceCount=null,sourceDimensions=null;
  for(let hi=0;hi<7;hi++)for(let ai=0;ai<7;ai++){
    const key=base+"/chunk-"+hi+"-"+ai+".json",obj=await env.BENCHMARK_R2.get(key);if(!obj)continue;
    const row=JSON.parse(await new Response(obj.body).text());chunkCount++;totalWindows+=Number(row.searched_window_count||0);referenceCount??=row.item_reference_count;sourceDimensions??=row.source_dimensions;
