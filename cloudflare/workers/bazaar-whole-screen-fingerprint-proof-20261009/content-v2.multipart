function glBuildIndex4(refs){const idx=new Map(),offs=[0,4,8,12];for(let ri=0;ri<refs.length;ri++)for(let fi=0;fi<refs[ri].features.length;fi++){const d=refs[ri].features[fi].descriptor,code=ri*256+fi;for(let ci=0;ci<offs.length;ci++){const o=offs[ci],k=(ci<<16)|(d[o]<<8)|d[o+1];let a=idx.get(k);if(!a){a=[];idx.set(k,a);}a.push(code);}}return {idx,offs};}
function glCollectPairsSelective4(target,refs,indexed,maxCandidates=96){const perRef=Array.from({length:refs.length},()=>[]);for(let ti=0;ti<target.length;ti++){const d=target[ti].descriptor,candidates=new Set();for(let ci=0;ci<indexed.offs.length;ci++){const o=indexed.offs[ci],base=(d[o]<<8)|d[o+1],prefix=ci<<16,exact=indexed.idx.get(prefix|base);if(exact)for(const code of exact)candidates.add(code);for(let bit=0;bit<16;bit++){const ar=indexed.idx.get(prefix|(base^(1<<bit)));if(ar)for(const code of ar)candidates.add(code);}}if(candidates.size>maxCandidates)continue;for(const code of candidates){const ri=Math.floor(code/256),fi=code%256,rf=refs[ri]?.features[fi];if(!rf)continue;const distance=lgHam(d,rf.descriptor);if(distance>22)continue;perRef[ri].push({ti,ri:fi,reference_x:rf.x,reference_y:rf.y,target_x:target[ti].x,target_y:target[ti].y,distance});}}return perRef;}
function glBuildIndex(refs){const idx=new Map(),offs=[0,2,4,6,8,10,12,14];for(let ri=0;ri<refs.length;ri++)for(let fi=0;fi<refs[ri].features.length;fi++){const d=refs[ri].features[fi].descriptor,code=ri*256+fi;for(let ci=0;ci<offs.length;ci++){const o=offs[ci],k=(ci<<16)|(d[o]<<8)|d[o+1];let a=idx.get(k);if(!a){a=[];idx.set(k,a);}a.push(code);}}return {idx,offs};}
function glCollectPairs(target,refs,indexed){const perRef=Array.from({length:refs.length},()=>[]);for(let ti=0;ti<target.length;ti++){const d=target[ti].descriptor,candidates=new Set();for(let ci=0;ci<indexed.offs.length;ci++){const o=indexed.offs[ci],base=(d[o]<<8)|d[o+1],prefix=ci<<16,exact=indexed.idx.get(prefix|base);if(exact)for(const code of exact)candidates.add(code);for(let bit=0;bit<16;bit++){const a=indexed.idx.get(prefix|(base^(1<<bit)));if(a)for(const code of a)candidates.add(code);}}for(const code of candidates){const ri=Math.floor(code/256),fi=code%256,rf=refs[ri]?.features[fi];if(!rf)continue;const distance=lgHam(d,rf.descriptor);if(distance>22)continue;perRef[ri].push({ti,ri:fi,reference_x:rf.x,reference_y:rf.y,target_x:target[ti].x,target_y:target[ti].y,distance});}}return perRef;}
function glCollectPairsSelectiveFast(target,refs,indexed,maxCandidates=128){const perRef=Array.from({length:refs.length},()=>[]),cap=refs.length*256,seen=new Uint32Array(cap),codes=new Uint32Array(Math.min(cap,maxCandidates+1));let stamp=1;outer:for(let ti=0;ti<target.length;ti++){stamp++;if(stamp===0xffffffff){seen.fill(0);stamp=1;}const d=target[ti].descriptor;let nc=0,overflow=false;for(let ci=0;ci<indexed.offs.length&&!overflow;ci++){const o=indexed.offs[ci],base=(d[o]<<8)|d[o+1],prefix=ci<<16,exact=indexed.idx.get(prefix|base);if(exact)for(const code of exact){if(code>=cap)continue;if(seen[code]!==stamp){seen[code]=stamp;if(nc>maxCandidates){overflow=true;break;}codes[nc++]=code;if(nc>maxCandidates){overflow=true;break;}}}if(overflow)break;for(let bit=0;bit<16&&!overflow;bit++){const ar=indexed.idx.get(prefix|(base^(1<<bit)));if(!ar)continue;for(const code of ar){if(code>=cap)continue;if(seen[code]!==stamp){seen[code]=stamp;codes[nc++]=code;if(nc>maxCandidates){overflow=true;break;}}}}}if(overflow)continue;for(let ci=0;ci<nc;ci++){const code=codes[ci],ri=Math.floor(code/256),fi=code%256,rf=refs[ri]?.features[fi];if(!rf)continue;const distance=lgHam(d,rf.descriptor);if(distance>22)continue;perRef[ri].push({ti,ri:fi,reference_x:rf.x,reference_y:rf.y,target_x:target[ti].x,target_y:target[ti].y,distance});}}return perRef;}
function glCollectPairsSelective(target,refs,indexed,maxCandidates=128){const perRef=Array.from({length:refs.length},()=>[]);for(let ti=0;ti<target.length;ti++){const d=target[ti].descriptor,candidates=new Set();for(let ci=0;ci<indexed.offs.length;ci++){const o=indexed.offs[ci],base=(d[o]<<8)|d[o+1],prefix=ci<<16,exact=indexed.idx.get(prefix|base);if(exact)for(const code of exact)candidates.add(code);for(let bit=0;bit<16;bit++){const ar=indexed.idx.get(prefix|(base^(1<<bit)));if(ar)for(const code of ar)candidates.add(code);}}if(candidates.size>maxCandidates)continue;for(const code of candidates){const ri=Math.floor(code/256),fi=code%256,rf=refs[ri]?.features[fi];if(!rf)continue;const distance=lgHam(d,rf.descriptor);if(distance>22)continue;perRef[ri].push({ti,ri:fi,reference_x:rf.x,reference_y:rf.y,target_x:target[ti].x,target_y:target[ti].y,distance});}}return perRef;}
function glCollectPairsRatio(target,refs,indexed){const perRef=Array.from({length:refs.length},()=>[]);for(let ti=0;ti<target.length;ti++){const d=target[ti].descriptor,cand=new Set();for(let ci=0;ci<indexed.offs.length;ci++){const o=indexed.offs[ci],base=(d[o]<<8)|d[o+1],prefix=ci<<16,ex=indexed.idx.get(prefix|base);if(ex)for(const code of ex)cand.add(code);for(let bit=0;bit<16;bit++){const a=indexed.idx.get(prefix|(base^(1<<bit)));if(a)for(const code of a)cand.add(code);}}const best=new Map();for(const code of cand){const ri=Math.floor(code/256),fi=code%256,rf=refs[ri]?.features[fi];if(!rf)continue;const hd=lgHam(d,rf.descriptor);let q=best.get(ri);if(!q){q={d1:129,d2:129,fi:-1};best.set(ri,q);}if(hd<q.d1){q.d2=q.d1;q.d1=hd;q.fi=fi;}else if(hd<q.d2)q.d2=hd;}for(const [ri,q] of best){if(q.fi<0||q.d2>=129||q.d1>40||q.d1+6>q.d2)continue;const rf=refs[ri].features[q.fi];perRef[ri].push({ti,ri:q.fi,reference_x:rf.x,reference_y:rf.y,target_x:target[ti].x,target_y:target[ti].y,distance:q.d1});}}return perRef;}
function glUniquePairs(p){p=[...p].sort((a,b)=>a.distance-b.distance);const u1=new Set(),u2=new Set(),out=[];for(const x of p){if(u1.has(x.ti)||u2.has(x.ri))continue;u1.add(x.ti);u2.add(x.ri);out.push(x);if(out.length===48)break;}return out;}
function glPairStats(perRef,refs){const rows=[];for(let i=0;i<refs.length;i++){const p=glUniquePairs(perRef[i]);if(p.length<4)continue;const d=p.map(x=>x.distance).sort((a,b)=>a-b),k=Math.min(12,d.length);rows.push({i,name:basename(refs[i].asset_path),pairs:p,strong:p.filter(x=>x.distance<=12).length,very:p.filter(x=>x.distance<=8).length,mean12:d.slice(0,k).reduce((s,x)=>s+x,0)/k});}rows.sort((a,b)=>b.strong-a.strong||b.very-a.very||a.mean12-b.mean12||b.pairs.length-a.pairs.length);return rows;}
function glRankRefs24Range(perRef,refs,tile,start,end){const rows=[];start=Math.max(0,start|0);end=Math.min(refs.length,end|0);for(let ri=start;ri<end;ri++){const pairs=glUniquePairs(perRef[ri]||[]).slice(0,24);if(pairs.length<4)continue;const e=glEstimatePairs(pairs),t=e.transform,r=refs[ri];rows.push({asset_path:r.asset_path,pair_count:e.pair_count,transform:t,bbox:t?lgBoxFromTransform(t,tile,r.width,r.height):null});}rows.sort((a,b)=>((b.transform?b.transform.inlier_count:0)-(a.transform?a.transform.inlier_count:0))||((a.transform?a.transform.mean_hamming:999)-(b.transform?b.transform.mean_hamming:999)));return rows;}
function glRankRefs24(perRef,refs,tile){const rows=[];for(let ri=0;ri<refs.length;ri++){const pairs=glUniquePairs(perRef[ri]).slice(0,24);if(pairs.length<4)continue;const e=glEstimatePairs(pairs),t=e.transform,r=refs[ri];rows.push({asset_path:r.asset_path,pair_count:e.pair_count,transform:t,bbox:t?lgBoxFromTransform(t,tile,r.width,r.height):null});}rows.sort((a,b)=>((b.transform?b.transform.inlier_count:0)-(a.transform?a.transform.inlier_count:0))||((a.transform?a.transform.mean_hamming:999)-(b.transform?b.transform.mean_hamming:999)));return rows;}
function glRankRefs(perRef,refs,tile){const rows=[];for(let ri=0;ri<refs.length;ri++){const pairs=glUniquePairs(perRef[ri]).slice(0,12);if(pairs.length<4)continue;const e=glEstimatePairs(pairs),t=e.transform,r=refs[ri];rows.push({asset_path:r.asset_path,pair_count:e.pair_count,transform:t,bbox:t?lgBoxFromTransform(t,tile,r.width,r.height):null});}rows.sort((a,b)=>((b.transform?b.transform.inlier_count:0)-(a.transform?a.transform.inlier_count:0))||((a.transform?a.transform.mean_hamming:999)-(b.transform?b.transform.mean_hamming:999)));return rows;}
