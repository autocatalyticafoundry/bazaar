async function aggregateReducedClusters(env,body){
  const base=String(body.reduced_base_key||""),out=String(body.output_key||""),proposals=[];let reducedCount=0,totalWindows=0;
  for(let h=0;h<7;h++)for(let a=0;a<7;a++){const obj=await env.BENCHMARK_R2.get(base+"/reduce-"+h+"-"+a+".json");if(!obj)continue;const row=JSON.parse(await new Response(obj.body).text());reducedCount++;totalWindows+=Number(row.searched_window_count||0);for(const p of row.proposals||[])if(Number(p.best_score)<=0.48)proposals.push({...p,hf_index:h,ar_index:a});}
