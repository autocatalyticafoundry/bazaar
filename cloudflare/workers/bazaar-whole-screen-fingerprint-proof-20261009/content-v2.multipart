  const accepted=verified.filter(r=>(r.transform?.inlier_count||0)>=6&&(r.transform?.mean_hamming??999)<=18&&(r.transform?.mean_residual??999)<=2.5);
  const result={schema_version:1,scan_version:"whole-screen-local-feature-bank-scan-v1",input_key:inputKey,bank_key:bankKey,tile,target_feature_count:target.length,reference_count:bank.refs.length,shortlist_count:rankedVotes.length,accepted_count:accepted.length,accepted,verified:verified.slice(0,shortlistN)};
  await env.BENCHMARK_R2.put(out,JSON.stringify(result),{httpMetadata:{contentType:"application/json"},customMetadata:{artifact:"whole-screen-local-feature-bank-scan-v2-hamming1",tile:JSON.stringify(tile),target_features:String(target.length),reference_count:String(bank.refs.length),accepted_count:String(accepted.length),top_verified:JSON.stringify(verified.slice(0,6).map(r=>({name:basename(r.asset_path),votes:r.votes,vote_score:r.vote_score,inliers:r.transform?.inlier_count||0,mean_hamming:r.transform?.mean_hamming??null,mean_residual:r.transform?.mean_residual??null,bbox:r.bbox}))) }});
  return result;
}

async function lgAggregateBankHybrid(env,body){const originalBase=String(body.original_base_key||""),splitBase=String(body.split_base_key||""),out=String(body.output_key||""),batchCount=Math.max(1,Number(body.batch_count)||124),rows=[],failures=[],missing=[];for(let i=0;i<batchCount;i++){const ok=originalBase+"/batch-"+String(i).padStart(3,"0")+".json";let obj=await env.BENCHMARK_R2.get(ok);if(obj){const part=JSON.parse(await new Response(obj.body).text());rows.push(...(part.rows||[]));failures.push(...(part.failures||[]).map(x=>({...x,batch:i,source:"original"})));continue;}for(let s=0;s<4;s++){const sk=splitBase+"/batch-"+String(i).padStart(3,"0")+"-"+s+".json";obj=await env.BENCHMARK_R2.get(sk);if(!obj){missing.push({batch:i,split:s,key:sk});continue;}const part=JSON.parse(await new Response(obj.body).text());rows.push(...(part.rows||[]));failures.push(...(part.failures||[]).map(x=>({...x,batch:i,split:s,source:"split"})));}}if(missing.length)throw new Error("hybrid bank missing "+missing.length+" split artifacts");const dedup=[],seen=new Set();for(const r of rows){const k=String(r.asset_path||"");if(!k||seen.has(k))continue;seen.add(k);dedup.push(r);}const result={schema_version:1,bank_version:"whole-screen-local-feature-bank-v1",aggregation:"hybrid-original-plus-splits",reference_count:dedup.length,batch_count:batchCount,failure_count:failures.length,rows:dedup,failures};await env.BENCHMARK_R2.put(out,JSON.stringify(result),{httpMetadata:{contentType:"application/json"},customMetadata:{artifact:"whole-screen-local-feature-bank-v1",aggregation:"hybrid",reference_count:String(dedup.length),batch_count:String(batchCount),failure_count:String(failures.length)}});lgBankCacheKey=null;lgBankCache=null;return result;}

async function lgFindBankReference(env,body){const keys=Array.isArray(body.bank_keys)?body.bank_keys.map(String):[String(body.bank_key||"")],needle=String(body.name||"").toLowerCase().replace(/[^a-z0-9]/g,""),out=String(body.output_key||""),matches=[];for(const key of keys){if(!key)continue;const obj=await env.BENCHMARK_R2.get(key);if(!obj)continue;const root=JSON.parse(await new Response(obj.body).text());for(let i=0;i<(root.rows||[]).length;i++){const row=root.rows[i],n=basename(String(row.asset_path||"")).toLowerCase().replace(/[^a-z0-9]/g,"");if(n.includes(needle))matches.push({bank_key:key,index:i,asset_path:row.asset_path,source_sha256:row.source_sha256,width:row.width,height:row.height,feature_count:Array.isArray(row.features)?row.features.length:0});}}await env.BENCHMARK_R2.put(out,JSON.stringify({schema_version:1,name:body.name,matches}),{httpMetadata:{contentType:"application/json"},customMetadata:{artifact:"whole-screen-local-feature-bank-find-v1",name:String(body.name||""),match_count:String(matches.length),matches:JSON.stringify(matches)}});return matches;}


