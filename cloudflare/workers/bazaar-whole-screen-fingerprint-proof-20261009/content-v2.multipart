// Repair previously failed normalized references into a versioned bank/index.
// All writes stay under v2 prefixes; v1 packed geometry baseline is untouched.
const GL_REPAIR_V2_PREFIX="debug/whole-screen-local-feature-bank-v2/";
const GL_INDEX_V2_PREFIX="debug/global-local-packed-index-v2/";
function glRepairBatchKeyV2(start){return GL_REPAIR_V2_PREFIX+"repair-"+String(start).padStart(2,"0")+".json";}
async function glRepairBatchV2(env,body){
  const start=Math.max(0,Math.min(25,Number(body.start)||0));
  const count=Math.max(1,Math.min(4,Number(body.count)||4));
  const baseline=await env.BENCHMARK_R2.get("debug/whole-screen-local-feature-bank-v1/bank.json");
  if(!baseline)throw new Error("v1 reference bank missing");
  const v1=JSON.parse(await new Response(baseline.body).text()),failures=v1.failures||[];
  if(v1.failure_count!==26||failures.length!==26)throw new Error("unexpected repair manifest");
  const rows=[],errors=[];
  for(const fail of failures.slice(start,start+count)){
    const sha=String(fail.error||"").match(/\b[a-f0-9]{64}\b/)?.[0];
    if(!sha){errors.push({asset_path:fail.asset_path,error:"SHA unavailable"});continue;}
    try {
      const ref=await lgReference(env,sha);
      rows.push({asset_path:fail.asset_path,source_sha256:sha,width:ref.width,
        height:ref.height,features:ref.features.map(f=>[f.x,f.y,lgDescToB64(f.descriptor)])});
    }catch(e){errors.push({asset_path:fail.asset_path,error:String(e)});}
  }
  const key=glRepairBatchKeyV2(start);
  const report={schema_version:1,repair_version:"v2",start,count,rows,
    built:rows.length,errors,failed:errors.length};
  await env.BENCHMARK_R2.put(key,JSON.stringify(report),{
    httpMetadata:{contentType:"application/json"},
    customMetadata:{artifact:"bank-repair-v2",built:String(rows.length),failed:String(errors.length)}});
  return {key,built:rows.length,errors};
}
async function glAssembleBankV2(env){
  const base="debug/whole-screen-local-feature-bank-v1/bank.json";
  const o=await env.BENCHMARK_R2.get(base);
  if(!o)throw new Error("baseline bank unavailable");
  const v1=JSON.parse(await new Response(o.body).text());
  const all=[...v1.rows],seen=new Set(all.map(r=>r.asset_path));
  for(let start=0;start<26;start+=4){
    const key=glRepairBatchKeyV2(start),r=await env.BENCHMARK_R2.get(key);
    if(!r)throw new Error("missing repair part "+key);
    const p=JSON.parse(await new Response(r.body).text());
    if(p.failed||!p.rows?.length)throw new Error("failed repair part "+key);
    for(const row of p.rows){if(seen.has(row.asset_path))throw new Error("duplicate "+row.asset_path);
      seen.add(row.asset_path);all.push(row);}
  }
  const manifest=await lgItemSnapshotRows(env);
  const expected=new Map(manifest.map((r,i)=>[r.asset_path,{sha:r.source_sha256,index:i}]));
  if(expected.size!==1483||all.length!==1483)throw new Error("reference count mismatch "+expected.size+"/"+all.length);
  for(const row of all) {
    const known=expected.get(row.asset_path);
    if(!known||known.sha!==row.source_sha256)throw new Error("catalogue identity/hash mismatch "+row.asset_path);
    if(!row.features?.length||row.features.length>256)throw new Error("invalid features "+row.asset_path);
  }
  all.sort((a,b)=>expected.get(a.asset_path).index-expected.get(b.asset_path).index);
  const writes=[];
  // Shards are individually read by Workers. No RANSAC thresholds or v1 source changes.
  for(let si=0;si<8;si++){
    const rows=all.slice(si*192,(si+1)*192),key=GL_REPAIR_V2_PREFIX+"shards/shard-"+String(si).padStart(2,"0")+".json";
    if(!rows.length)throw new Error("empty shard");
    await env.BENCHMARK_R2.put(key,JSON.stringify({
      schema_version:1,bank_version:"whole-screen-local-feature-bank-v2",shard_index:si,
      reference_count:rows.length,start_reference:si*192,rows
    }),{httpMetadata:{contentType:"application/json"},customMetadata:{artifact:"whole-screen-local-feature-bank-v2",reference_count:String(rows.length),shard:String(si)}});
    writes.push({key,reference_count:rows.length});
  }
  const result={schema_version:1,bank_version:"whole-screen-local-feature-bank-v2",
    baseline_count:v1.reference_count,repaired_count:26,reference_count:all.length,
    failure_count:0,catalogue_count:expected.size,shards:writes,
    source_bank_key:base,rows:all};
  const key=GL_REPAIR_V2_PREFIX+"bank.json";
  await env.BENCHMARK_R2.put(key,JSON.stringify(result),{
    httpMetadata:{contentType:"application/json"},
    customMetadata:{artifact:"whole-screen-local-feature-bank-v2",reference_count:String(all.length),failure_count:"0"}});
  return {key,reference_count:all.length,repaired_count:26,shards:writes};
}
async function glBuildPackedIndexV2(env,body){
  const si=Math.max(0,Math.min(7,Number(body.shard_index)||0));
  const version=Number(body.bank_version)===3?3:2;
  const bank=await lgLoadBank(env,"debug/whole-screen-local-feature-bank-v"+version+"/shards/shard-"+String(si).padStart(2,"0")+".json");
  const refs=bank.refs,offs=[0,2,4,6,8,10,12,14],counts=new Uint32Array(8*65536);
  if(!refs.length||refs.length>192)throw new Error("invalid v2 shard size");
  let featureCount=0;
  for(let ri=0;ri<refs.length;ri++)for(let fi=0;fi<refs[ri].features.length;fi++){
    if(fi>=256)throw new Error("feature ID overflow");
    featureCount++;const d=refs[ri].features[fi].descriptor;
    for(let ci=0;ci<8;ci++)counts[ci*65536+(d[offs[ci]]<<8)+d[offs[ci]+1]]++;
  }
  const heads=new Uint32Array(8*65537);
  let total=0;
  for(let ci=0;ci<8;ci++){const hb=ci*65537,cb=ci*65536;heads[hb]=total;
    for(let v=0;v<65536;v++){total+=counts[cb+v];heads[hb+v+1]=total;}}
  const codes=new Uint32Array(total),cursor=new Uint32Array(8*65536);
  for(let ci=0;ci<8;ci++){const hb=ci*65537,cb=ci*65536;
    for(let v=0;v<65536;v++)cursor[cb+v]=heads[hb+v];}
  for(let ri=0;ri<refs.length;ri++)for(let fi=0;fi<refs[ri].features.length;fi++){
    const d=refs[ri].features[fi].descriptor,code=ri*256+fi;
    for(let ci=0;ci<8;ci++){const k=ci*65536+(d[offs[ci]]<<8)+d[offs[ci]+1];
      codes[cursor[k]++]=code;}
  }
  if(total!==featureCount*8)throw new Error("packed code count mismatch");
  const buf=new ArrayBuffer(16+heads.byteLength+codes.byteLength),hdr=new Uint32Array(buf,0,4);
  hdr[0]=0x42495831;hdr[1]=refs.length;hdr[2]=codes.length;hdr[3]=heads.length;
  new Uint32Array(buf,16,heads.length).set(heads);
  new Uint32Array(buf,16+heads.byteLength,codes.length).set(codes);
  const key="debug/global-local-packed-index-v"+version+"/shard-"+String(si).padStart(2,"0")+".bin";
  await env.BENCHMARK_R2.put(key,buf,{
    httpMetadata:{contentType:"application/octet-stream"},
    customMetadata:{artifact:"global-local-packed-index-v2",reference_count:String(refs.length),
      feature_count:String(featureCount),index_entries:String(total)}});
  return {key,shard_index:si,bank_version:version,reference_count:refs.length,feature_count:featureCount,index_entries:total,bytes:buf.byteLength};
}
const glPackedV2Cache=new Map();
async function glLoadPackedIndexV2(env,si,version=2){
  const cacheKey=version+"-"+si;
  if(glPackedV2Cache.has(cacheKey))return glPackedV2Cache.get(cacheKey);
  const promise=(async()=>{
    const key="debug/global-local-packed-index-v"+version+"/shard-"+String(si).padStart(2,"0")+".bin";
    const obj=await env.BENCHMARK_R2.get(key);
    if(!obj)throw new Error("missing packed index v2 "+si);
    const buf=await new Response(obj.body).arrayBuffer(),hdr=new Uint32Array(buf,0,4);
    if(hdr[0]!==0x42495831||hdr[3]!==8*65537)throw new Error("bad packed v2 index "+si);
    const heads=new Uint32Array(buf,16,hdr[3]),codes=new Uint32Array(buf,16+hdr[3]*4,hdr[2]);
    return {reference_count:hdr[1],heads,codes,offs:[0,2,4,6,8,10,12,14]};
  })();
  glPackedV2Cache.set(cacheKey,promise);
  return promise.catch(e=>{glPackedV2Cache.delete(cacheKey);throw e;});
}


// Descriptor v3: 128 independent deterministic BRIEF pixel tests.
// Descriptor geometry is rebuilt from canonical pixels at the same native
// keypoint coordinates as v2. No screenshot-specific visual rule is involved.
function glV3Mix32(x) {
  x^=x>>>16;x=Math.imul(x,0x7feb352d);
  x^=x>>>15;x=Math.imul(x,0x846ca68b);
  return (x^(x>>>16))>>>0;
}
const GL_V3_PAIRS=(()=>{
  const pairs=[],seen=new Set();
  for(let nonce=0;nonce<10000&&pairs.length<128;nonce++){
    const a=glV3Mix32((nonce*4+1+0x13579bdf)>>>0),
      b=glV3Mix32((nonce*4+3+0x2468ace0)>>>0);
    const ax=a%17-8,ay=(a>>>8)%17-8,bx=b%17-8,by=(b>>>8)%17-8;
    if((ax-bx)**2+(ay-by)**2<16)continue;
    const p=[ax,ay,bx,by],forward=p.join(","),reverse=[bx,by,ax,ay].join(",");
    if(seen.has(forward)||seen.has(reverse))continue;
    pairs.push(p);seen.add(forward);seen.add(reverse);
  }
  if(pairs.length!==128)throw new Error("v3 descriptor cannot generate 128 unique tests");
  return pairs;
})();
function glRedescribeV3(data,w,h,features,scale=1) {
  const gray=new Float32Array(w*h);
  for(let p=0;p<gray.length;p++){const o=p*4;gray[p]=lgGray(data[o],data[o+1],data[o+2]);}
  return features.map(f=>{
    const d=new Uint8Array(16);
    for(let bit=0;bit<128;bit++){
      const [u,v,s,t]=GL_V3_PAIRS[bit],ax=Math.round(u*scale),ay=Math.round(v*scale),
        bx=Math.round(s*scale),by=Math.round(t*scale);
      if(lgPatchMean(gray,w,h,f.x+ax,f.y+ay)<lgPatchMean(gray,w,h,f.x+bx,f.y+by))
        d[bit>>>3]|=1<<(bit&7);
    }
    return {x:f.x,y:f.y,descriptor:d};
  });
}
const GL_V3_BANK="debug/whole-screen-local-feature-bank-v3/";
function glV3PartKey(si,start){
  return GL_V3_BANK+"parts/s"+String(si).padStart(2,"0")+"-p"+String(start).padStart(3,"0")+".json";
}
async function glV3BankPart(env,body) {
  const si=Math.max(0,Math.min(7,Number(body.shard_index)||0)),
    start=Math.max(0,Math.min(191,Number(body.start)||0)),
    count=Math.max(1,Math.min(12,Number(body.count)||12)),
    key="debug/whole-screen-local-feature-bank-v2/shards/shard-"+String(si).padStart(2,"0")+".json";
  const obj=await env.BENCHMARK_R2.get(key);
  if(!obj)throw new Error("v2 shard missing");
  const shard=JSON.parse(await new Response(obj.body).text()),rows=[],errors=[];
  for(const row of shard.rows.slice(start,start+count)){
    try{
      const normalized=await env.BENCHMARK_R2.get("catalogue/item-visual-normalized-v1/"+row.source_sha256+".png");
      if(!normalized)throw new Error("normalized reference missing");
      const png=await decodePng(await new Response(normalized.body).arrayBuffer()),
        im=(png.width===row.width&&png.height===row.height)?png:lgBoundReferenceImage(png,320);
      if(im.width!==row.width||im.height!==row.height)
        throw new Error("canonical dimension mismatch expected="+row.width+"x"+row.height+
          " original="+png.width+"x"+png.height+" resized="+im.width+"x"+im.height);
      const original=row.features.map(f=>({x:f[0],y:f[1]})),
        features=glRedescribeV3(im.rgba,im.width,im.height,original,1);
      rows.push({...row,features:features.map(f=>[f.x,f.y,lgDescToB64(f.descriptor)])});
    }catch(e){errors.push({asset_path:row.asset_path,error:String(e)});}
  }
  const report={schema_version:1,descriptor_version:"brief128-v3",shard_index:si,start,
    attempted:Math.min(count,shard.rows.length-start),built:rows.length,errors,rows};
  const out=glV3PartKey(si,start);
  await env.BENCHMARK_R2.put(out,JSON.stringify(report),{httpMetadata:{contentType:"application/json"},
    customMetadata:{artifact:"brief128-v3-bank-part",built:String(rows.length),errors:String(errors.length)}});
  return {key:out,attempted:report.attempted,built:report.built,errors};
}
async function glV3AssembleShard(env,body) {
  const si=Math.max(0,Math.min(7,Number(body.shard_index)||0)),
    source="debug/whole-screen-local-feature-bank-v2/shards/shard-"+String(si).padStart(2,"0")+".json";
  const obj=await env.BENCHMARK_R2.get(source);
  if(!obj)throw new Error("v2 bank shard missing "+si);
  const old=JSON.parse(await new Response(obj.body).text());
  const rows=[];
  for(let start=0;start<old.rows.length;start+=12) {
    const targetCount=Math.min(12,old.rows.length-start);
    const key=glV3PartKey(si,start),o=await env.BENCHMARK_R2.get(key);
    const batch=o?JSON.parse(await new Response(o.body).text()):null;
    if(batch&&!batch.errors?.length&&batch.built===targetCount&&batch.attempted===targetCount){
      rows.push(...batch.rows);continue;
    }
    // Fallback supports bounded four-reference repairs when a 12-reference
    // extraction fails under the free Worker CPU budget.
    for(let sub=start;sub<start+targetCount;sub+=4){
      const subkey=glV3PartKey(si,sub),subobj=await env.BENCHMARK_R2.get(subkey);
      if(!subobj)throw new Error("missing v3 subbatch "+subkey);
      const part=JSON.parse(await new Response(subobj.body).text());
      const count=Math.min(4,start+targetCount-sub);
      if(part.errors?.length||part.built!==count||part.attempted!==count)
        throw new Error("incomplete v3 subbatch "+subkey);
      rows.push(...part.rows);
    }
  }
  if(rows.length!==old.rows.length)throw new Error("v3 shard count mismatch");
  for(let i=0;i<rows.length;i++)if(rows[i].asset_path!==old.rows[i].asset_path||
      rows[i].source_sha256!==old.rows[i].source_sha256||
      rows[i].features.length!==old.rows[i].features.length)
    throw new Error("v3 shard identity/keypoint mismatch "+i);
  const result={schema_version:1,bank_version:"whole-screen-local-feature-bank-v3",
    descriptor_version:"brief128-v3",shard_index:si,reference_count:rows.length,
    start_reference:si*192,rows};
  const out=GL_V3_BANK+"shards/shard-"+String(si).padStart(2,"0")+".json";
  await env.BENCHMARK_R2.put(out,JSON.stringify(result),{
    httpMetadata:{contentType:"application/json"},
    customMetadata:{artifact:"whole-screen-local-feature-bank-v3",reference_count:String(rows.length),
      descriptor_version:"brief128-v3"}});
  return {key:out,reference_count:rows.length};
}
async function glV3AssembleBank(env) {
  const rows=[],shards=[];
  for(let si=0;si<8;si++){
    const key=GL_V3_BANK+"shards/shard-"+String(si).padStart(2,"0")+".json",
      o=await env.BENCHMARK_R2.get(key);
    if(!o)throw new Error("missing v3 bank shard "+si);
    const s=JSON.parse(await new Response(o.body).text());
    if(s.descriptor_version!=="brief128-v3")throw new Error("wrong descriptor version");
    rows.push(...s.rows);shards.push({key,reference_count:s.rows.length});
  }
  if(rows.length!==1483||new Set(rows.map(r=>r.asset_path)).size!==1483)
    throw new Error("v3 complete bank count/uniqueness mismatch");
  const result={schema_version:1,bank_version:"whole-screen-local-feature-bank-v3",
    descriptor_version:"brief128-v3",reference_count:rows.length,failure_count:0,shards,rows};
  const out=GL_V3_BANK+"bank.json";
  await env.BENCHMARK_R2.put(out,JSON.stringify(result),{
    httpMetadata:{contentType:"application/json"},
    customMetadata:{artifact:"whole-screen-local-feature-bank-v3",reference_count:"1483",
      failure_count:"0",descriptor_version:"brief128-v3"}});
  return {key:out,reference_count:rows.length,shards};
}
async function glV3Screenshot(env,inputKey,ds) {
  // Only immutable content-addressed PNGs are cached. Arbitrary input remains
  // programmatic and native-resolution without assumptions about the scene.
  const match=/^perception\/inputs\/([a-f0-9]{64})\.png$/.exec(inputKey);
  const tag=Math.round(ds*100);
  const cacheKey=match?"debug/global-local-full-target-brief-v3/"+match[1]+"/d"+tag+".json":null;
  if(cacheKey){
    const hit=await env.BENCHMARK_R2.get(cacheKey);
    if(hit){const obj=JSON.parse(await new Response(hit.body).text());
      if(obj.descriptor_version==="brief128-v3"&&obj.input_key===inputKey)
        return {width:obj.width,height:obj.height,descriptor_scale:ds,
          descriptor_version:"brief128-v3",
          features:obj.features.map(f=>({x:f[0],y:f[1],descriptor:lgB64ToDesc(f[2])}))};
    }
  }
  const loaded=await loadProofInputs(env,inputKey),im=loaded.image,
    positions=lgExtractSpatialFastGrid(im.rgba,im.width,im.height,16,12,32,2,ds),
    features=glRedescribeV3(im.rgba,im.width,im.height,positions,ds);
  if(cacheKey){
    await env.BENCHMARK_R2.put(cacheKey,JSON.stringify({schema_version:1,
      descriptor_version:"brief128-v3",input_key:inputKey,width:im.width,
      height:im.height,descriptor_scale:ds,feature_count:features.length,
      features:features.map(f=>[f.x,f.y,lgDescToB64(f.descriptor)])}),{
        httpMetadata:{contentType:"application/json"},
        customMetadata:{artifact:"native-fullframe-brief128-v3",feature_count:String(features.length),
          descriptor_scale:String(ds)}});
  }
  return {width:im.width,height:im.height,descriptor_scale:ds,
    descriptor_version:"brief128-v3",features};
}


// Reusable native-screenshot rarity ranking. This avoids recomputing the
// same 5,560-feature full-frame descriptor votes for every pool partition.
// The cache is keyed by immutable input, bank version and shard.
async function glBuildRarityCacheV1(env,body){
  const si=Math.max(0,Math.min(7,Number(body.shard_index)||0));
  const version=3,ds=Math.max(.45,Math.min(1.25,Number(body.scale)||1));
  const inputKey=String(body.input_key||
    "perception/inputs/5a4e9b43b05b2fd6f998cf2725ac450c1dd483f58134d0dec4b4713622bfd393.png");
  const key=String(body.output_key||
    "debug/global-local-v7-rarity-cache/d"+Math.round(ds*100)+"-s"+si+".json");
  if(!key.startsWith("debug/")||!key.endsWith(".json"))
    throw new Error("invalid rarity-cache output path");
  const target=await glV3Screenshot(env,inputKey,ds);
  const bank=await lgLoadBank(env,"debug/whole-screen-local-feature-bank-v3/shards/shard-"+
    String(si).padStart(2,"0")+".json");
  const idx=await glLoadPackedIndexV2(env,si,version);
  if(bank.refs.length!==idx.reference_count)throw new Error("packed reference mismatch");
  const maxBucket=Math.max(8,Math.min(96,Number(body.max_bucket)||48));
  const rows=glRareVotePacked(target.features,bank.refs,idx,bank.refs.length,maxBucket)
    .map(row=>({...row,asset_path:bank.refs[row.i].asset_path}));
  const out={schema_version:1,cache_version:"rarity-rank-v1",bank_version:version,
    input_key:inputKey,descriptor_scale:ds,shard_index:si,
    max_bucket:maxBucket,target_feature_count:target.features.length,
    reference_count:bank.refs.length,ranked_reference_count:rows.length,rows};
  await env.BENCHMARK_R2.put(key,JSON.stringify(out),{
    httpMetadata:{contentType:"application/json"},
    customMetadata:{artifact:"rarity-rank-v1",reference_count:String(bank.refs.length),
      ranked_count:String(rows.length),target_features:String(target.features.length)}
  });
  return {key,ranked:rows.length};
}
async function glReadRarityCacheV1(env,key,params){
  if(!key.startsWith("debug/")||!key.endsWith(".json"))throw new Error("invalid rank cache key");
  const f=await env.BENCHMARK_R2.get(key);
  if(!f)throw new Error("missing rank cache "+key);
  const v=JSON.parse(await new Response(f.body).text());
  const {si,version,ds,inputKey,bank,maxBucket,targetCount}=params;
  if(v.cache_version!=="rarity-rank-v1"||v.shard_index!==si||
    v.bank_version!==version||v.descriptor_scale!==ds||
    v.input_key!==inputKey||v.max_bucket!==maxBucket||
    v.reference_count!==bank.refs.length||v.target_feature_count!==targetCount||
    v.ranked_reference_count!==v.rows?.length)throw new Error("incompatible rank cache");
  const visited=new Set();
  for(const x of v.rows){
    if(!Number.isInteger(x.i)||x.i<0||x.i>=bank.refs.length||
       visited.has(x.i)||bank.refs[x.i].asset_path!==x.asset_path)
      throw new Error("corrupt rank cache reference");
    visited.add(x.i);
  }
  return v.rows;
}


// Dense native-resolution, packed-index retrieval experiment.
// Uses one vote per screenshot feature per canonical reference, weighted by
// inverse square root of packed head-table bucket occupancy.
// This file is injected into the proof Worker, never the production Worker.
function glDenseRarePairsV1(target, bank, idx, shortlist, maxBucket=64, maxCandidates=192) {
  const selected = shortlist.map(q => q.i);
  const local = new Int16Array(bank.refs.length); local.fill(-1);
  for (let j=0;j<selected.length;j++) local[selected[j]]=j;
  const per = Array.from({length:selected.length},()=>[]);
  const seen = new Uint32Array(bank.refs.length*256);
  let stamp=1, sampled=0, capped=0, verified=0, near=0;
  for (let ti=0;ti<target.length;ti++) {
    stamp++;
    if (stamp===0xffffffff) {seen.fill(0);stamp=1;}
    const d=target[ti].descriptor;
    // Head-table lengths are global corpus rarity, not shortlist frequency.
    const buckets = [];
    for (let ci=0;ci<8;ci++) {
      const o=idx.offs[ci], base=(d[o]<<8)|d[o+1], hb=ci*65537;
      for (let b=-1;b<16;b++) {
        const v=b<0?base:base^(1<<b),s=idx.heads[hb+v],e=idx.heads[hb+v+1],n=e-s;
        if (n>0&&n<=maxBucket) buckets.push({s,e,n,exact:b<0});
      }
    }
    // Examine rarer buckets first to prevent common textures from exhausting
    // the cheap candidate cap; exact hits win ties.
    buckets.sort((a,b)=>a.n-b.n || Number(b.exact)-Number(a.exact));
    let count=0;
    for (const bucket of buckets) {
      for (let k=bucket.s;k<bucket.e;k++) {
        const code=idx.codes[k],ri=Math.floor(code/256),fi=code%256;
        if (ri>=local.length || local[ri]<0 || fi>=bank.refs[ri].features.length) continue;
        if (seen[code]===stamp) continue;
        seen[code]=stamp;
        sampled++;
        const rf=bank.refs[ri].features[fi];
        const dist=glHamFast(d,rf.descriptor);verified++;
        if (dist<=22) {
          near++;
          per[local[ri]].push({
            ti,ri:fi,reference_x:rf.x,reference_y:rf.y,
            target_x:target[ti].x,target_y:target[ti].y,distance:dist
          });
        }
        count++;
        if (count>=maxCandidates) break;
      }
      if (count>=maxCandidates) {capped++;break;}
    }
  }
  return {per,selected,stats:{sampled,capped_target_features:capped,hamming_evaluations:verified,near_pairs:near}};
}

function glDenseExactRankV1(target,refs,idx) {
  // Confirm all 128 bits, not just a common 16-bit bucket.
  // Count distinct matched reference features to suppress repetitive UI art.
  const hits=new Uint32Array(refs.length),unique=Array.from({length:refs.length},()=>new Set());
  const seen=new Uint32Array(refs.length);
  let tested=0,exact=0,skipped_very_common=0;
  for(let ti=0;ti<target.length;ti++) {
    const d=target[ti].descriptor,base=(d[0]<<8)|d[1],
      start=idx.heads[base],end=idx.heads[base+1];
    if(end-start>384){skipped_very_common++;continue;}
    for(let j=start;j<end;j++){
      const code=idx.codes[j],ri=Math.floor(code/256),fi=code%256;
      if(ri>=refs.length)continue;
      const rd=refs[ri].features[fi]?.descriptor;
      if(!rd)continue;
      tested++;let equal=true;
      for(let byte=2;byte<16;byte++) if(d[byte]!==rd[byte]){equal=false;break;}
      if(!equal)continue;
      exact++;unique[ri].add(fi);
      if(seen[ri]!==ti+1){seen[ri]=ti+1;hits[ri]++;}
    }
  }
  const rows=[];
  for(let i=0;i<refs.length;i++)if(hits[i])rows.push({i,hits:hits[i],
    distinct_ref_features:unique[i].size,
    score:(hits[i]+3*unique[i].size)/Math.sqrt(Math.max(1,refs[i].features.length))});
  rows.sort((a,b)=>b.score-a.score||b.distinct_ref_features-a.distinct_ref_features||b.hits-a.hits);
  return {rows,diagnostics:{tested,exact,skipped_very_common,refs_with_exact:rows.length}};
}


function glHoughShortlistV1(pairsByRef,poolVotes,refs,limit=24){
  // Vote for mutually consistent translations at a small, generic set of
  // plausible image scales. This is a CHEAP shortlist, not RANSAC verification.
  const scales=[0.65,0.8,0.95,1.1,1.25,1.4,1.6],
    bin=48,shifts=[0,24],rows=[];
  for(let n=0;n<poolVotes.length;n++){
    const ref=poolVotes[n],raw=pairsByRef[n]||[],
      bestPairs=raw.filter(p=>p.distance<=22)
        .sort((a,b)=>a.distance-b.distance||a.ti-b.ti).slice(0,160),
      bins=new Map();
    for(const p of bestPairs){
      for(let k=0;k<scales.length;k++){
        const scale=scales[k],dx=p.target_x-scale*p.reference_x,
          dy=p.target_y-scale*p.reference_y;
        for(let sh=0;sh<shifts.length;sh++){
          const q=shifts[sh],bx=Math.floor((dx+q)/bin),by=Math.floor((dy+q)/bin),
            key=k+":"+sh+":"+bx+":"+by;
          let entry=bins.get(key);
          if(!entry){entry={count:0,targets:new Set(),references:new Set(),sum_distance:0,scale,dx,dy};bins.set(key,entry);}
          if(entry.targets.has(p.ti)||entry.references.has(p.ri))continue;
          entry.targets.add(p.ti);entry.references.add(p.ri);
          entry.count++;entry.sum_distance+=p.distance;
        }
      }
    }
    let peak=null;
    for(const v of bins.values())if(!peak||v.count>peak.count||
      (v.count===peak.count&&v.sum_distance/v.count<peak.sum_distance/peak.count))peak=v;
    const peakCount=peak?.count||0,peakH=peakCount?peak.sum_distance/peakCount:128;
    rows.push({...ref,score:peakCount*10-peakH*0.03+Math.log1p(raw.length)*0.01,
      hough_peak:peakCount,hough_scale:peak?.scale||null,
      hough_mean_hamming:peakCount?peakH:null,raw_pairs:raw.length,pool_position:n});
  }
  rows.sort((a,b)=>b.score-a.score||b.hough_peak-a.hough_peak||a.pool_position-b.pool_position);
  return rows.slice(0,Math.max(8,Math.min(64,limit)));
}

async function glDenseRareShardV1(env, body) {
  const si=Math.max(0,Math.min(7,Number(body.shard_index)||0));
  const ds=Math.max(.45,Math.min(1.25,Number(body.scale)||1));
  const inputKey=String(body.input_key||"perception/inputs/5a4e9b43b05b2fd6f998cf2725ac450c1dd483f58134d0dec4b4713622bfd393.png");
  const benchmark="perception/inputs/5a4e9b43b05b2fd6f998cf2725ac450c1dd483f58134d0dec4b4713622bfd393.png";
  // General input path keeps the native image dimensions and avoids resizing.
  const version=[2,3].includes(Number(body.bank_version))?Number(body.bank_version):1;
  const tr=version===3?await glV3Screenshot(env,inputKey,ds):
    inputKey===benchmark&&body.fresh!==true?await glLoadFullTargetDense(env,ds):
    await (async()=>{const loaded=await loadProofInputs(env,inputKey),im=loaded.image;
      return {width:im.width,height:im.height,descriptor_scale:ds,
        features:lgExtractSpatialFastGrid(im.rgba,im.width,im.height,16,12,32,2,ds)};})();
  const bankKey="debug/whole-screen-local-feature-bank-v"+version+"/shards/shard-"+String(si).padStart(2,"0")+".json";
  const bank=await lgLoadBank(env,bankKey);
  const idx=version===1?await glLoadPackedIndex(env,si):await glLoadPackedIndexV2(env,si,version);
  if(idx.reference_count!==bank.refs.length) throw new Error("packed index/bank reference mismatch for shard "+si);
  const topN=Math.max(8,Math.min(40,Number(body.shortlist)||24));
  const maxBucket=Math.max(8,Math.min(96,Number(body.max_bucket)||48));
  const rarityCacheKey=String(body.rarity_ranking_key||"");
  const rarity=rarityCacheKey?await glReadRarityCacheV1(env,rarityCacheKey,{
    si,version,ds,inputKey,bank,maxBucket,targetCount:tr.features.length
  }):glRareVotePacked(tr.features,bank.refs,idx,bank.refs.length,maxBucket);
  const exact=rarityCacheKey?{rows:[],diagnostics:{skipped_due_to_rarity_cache:true}}:
    glDenseExactRankV1(tr.features,bank.refs,idx);
  const mode=String(body.ranking||"rarity");
  const houghMode=mode==="hough";
  const allVotes=mode==="exact"?exact.rows:rarity;
  const poolN=houghMode?Math.max(topN,Math.min(bank.refs.length,Number(body.pool)||64)):topN;
  const poolStart=houghMode?Math.max(0,Math.floor(Number(body.pool_start)||0)):0;
  const preliminary=allVotes.slice(poolStart,poolStart+poolN);
  if(!preliminary.length)throw new Error("empty rarity pool slice "+poolStart);
  const stride=body.diagnostic_only===true?Math.max(1,Math.min(4,Math.floor(Number(body.candidate_stride)||1))):1;
  const candidateTarget=stride===1?tr.features:tr.features.filter((_,i)=>i%stride===0);
  const foundPool=glDenseRarePairsV1(candidateTarget,bank,idx,preliminary,maxBucket,192);
  const votes=houghMode?glHoughShortlistV1(foundPool.per,preliminary,bank.refs,topN):preliminary;
  const positions=new Map(preliminary.map((v,i)=>[v.i,i]));
  const found=houghMode?{...foundPool,
    selected:votes.map(v=>v.i),per:votes.map(v=>foundPool.per[positions.get(v.i)])}:foundPool;
  const baselinePairs=body.pair_mode==="baseline"?
    glCollectPairsSelectivePackedFast(tr.features,bank.refs,idx,128):null;
  const verifyPairs=baselinePairs?
    found.selected.map(i=>baselinePairs[i]):found.per;
  const refs=found.selected.map(i=>bank.refs[i]);
  // Only the selected references are geometrically estimated.
  const rows=body.diagnostic_only===true?[]:glRankRefs24(verifyPairs,refs,{x:0,y:0});
  const accepted=rows.filter(r=>{const t=r.transform;
    return !!t&&((t.inlier_count>=6&&t.mean_hamming<=18&&t.mean_residual<=2.5)
      ||(t.inlier_count>=4&&t.mean_hamming<=4&&t.mean_residual<=1));});
  const shortlist=votes.map((v,rank)=>({rank:rank+1,name:basename(bank.refs[v.i].asset_path),
    asset_path:bank.refs[v.i].asset_path,score:v.score,votes:v.votes,hits:v.hits,
    raw_pairs:verifyPairs[rank].length,
    hough_peak:v.hough_peak??null,hough_scale:v.hough_scale??null}));
  const result={
    schema_version:1,proof_version:"dense-rare-shortlist-v1",input_key:inputKey,
    shard_index:si,bank_version:version,descriptor_scale:ds,target_feature_count:tr.features.length,
    reference_count:bank.refs.length,shortlist_count:shortlist.length,
    rank_sgw:allVotes.findIndex(v=>basename(bank.refs[v.i].asset_path).includes("StainedGlassWindow"))+1 || null,
    rank_hands:allVotes.findIndex(v=>basename(bank.refs[v.i].asset_path).includes("HandsOfTime"))+1 || null,
    fresh_extraction:body.fresh===true,full_ranking_count:allVotes.length,
    ranking_mode:mode,pool_count:poolN,pool_start:poolStart,diagnostic_only:body.diagnostic_only===true,
    rarity_cache_key:rarityCacheKey||null,
    pair_mode:body.pair_mode==="baseline"?"baseline":"rarity",
    candidate_reference_count:rows.length,geometry_executed_count:rows.length,
    accepted_count:accepted.length,accepted,top:rows.slice(0,24),shortlist,
    diagnostics:{...found.stats,exact:exact.diagnostics,
      candidate_stride:stride,candidate_feature_count:candidateTarget.length},
    exact_rank_sgw:exact.rows.findIndex(v=>basename(bank.refs[v.i].asset_path).includes("StainedGlassWindow"))+1||null,
    exact_hits_sgw:exact.rows.find(v=>basename(bank.refs[v.i].asset_path).includes("StainedGlassWindow"))||null,
    exact_top:exact.rows.slice(0,12).map(v=>({...v,name:basename(bank.refs[v.i].asset_path)}))
  };
  const tag=Math.round(ds*100);
  const out=String(body.output_key||("debug/global-local-full-dense-v4-rare-shortlist/d"+tag+"-s"+si+".json"));
  if(!out.startsWith("debug/"))throw new Error("output must be under debug/");
  await env.BENCHMARK_R2.put(out,JSON.stringify(result),{
    httpMetadata:{contentType:"application/json"},
    customMetadata:{artifact:"dense-rare-shortlist-v1",shard_index:String(si),
      target_features:String(tr.features.length),shortlist_count:String(shortlist.length),
      accepted_count:String(accepted.length),
      accepted:JSON.stringify(accepted.slice(0,12).map(x=>({
        name:basename(x.asset_path),inliers:x.transform?.inlier_count,
        h:x.transform?.mean_hamming,res:x.transform?.mean_residual,bbox:x.bbox})))}
  });
  return result;
}


// Screenshot-level aggregation for verified canonical visual detections.
// No screenshot-specific identity rules or HUD hardcoding.
function glOverlapIoUV1(a,b){
  const x=Math.max(0,Math.min(a.x+a.width,b.x+b.width)-Math.max(a.x,b.x));
  const y=Math.max(0,Math.min(a.y+a.height,b.y+b.height)-Math.max(a.y,b.y));
  const intersection=x*y,union=a.width*a.height+b.width*b.height-intersection;
  return union>0?intersection/union:0;
}
function glValidArtBoxV1(b,w,h){
  return b&&[b.x,b.y,b.width,b.height].every(Number.isFinite)&&b.width>3&&b.height>3&&
    b.x+b.width>0&&b.y+b.height>0&&b.x<w&&b.y<h;
}
async function glAggregateScreenV1(env,body){
  const keys=Array.isArray(body.shard_keys)?body.shard_keys:[],
    out=String(body.output_key||"");
  if(keys.length<1||keys.length>8||new Set(keys).size!==keys.length||
    keys.some(k=>typeof k!=="string"||!k.startsWith("debug/")||!k.endsWith(".json")))
    throw new Error("require 1-8 distinct debug shard result keys");
  if(!out.startsWith("debug/")||!out.endsWith(".json"))throw new Error("invalid aggregate output");
  const results=[];
  for(const key of keys){
    const obj=await env.BENCHMARK_R2.get(key);
    if(!obj)throw new Error("missing shard result "+key);
    const z=JSON.parse(await new Response(obj.body).text());
    if(z.bank_version!==3||z.proof_version!=="dense-rare-shortlist-v1")
      throw new Error("unsupported shard experiment "+key);
    results.push({key,record:z});
  }
  const inputKey=results[0].record.input_key;
  if(results.some(z=>z.record.input_key!==inputKey))throw new Error("mixed screenshot results");
  const tr=await glV3Screenshot(env,inputKey,results[0].record.descriptor_scale);
  const candidateRows=[],loadedShards=new Map();
  for(const {key,record} of results){
    for(const hit of record.accepted||[]){
      if(!glValidArtBoxV1(hit.bbox,tr.width,tr.height)||!hit.transform)continue;
      let index=loadedShards.get(record.shard_index);
      if(!index){
        const bankKey="debug/whole-screen-local-feature-bank-v3/shards/shard-"+
          String(record.shard_index).padStart(2,"0")+".json";
        const b=await env.BENCHMARK_R2.get(bankKey);
        if(!b)throw new Error("missing reference provenance "+bankKey);
        const ref=JSON.parse(await new Response(b.body).text());
        index=new Map(ref.rows.map(row=>[row.asset_path,row]));
        loadedShards.set(record.shard_index,index);
      }
      const ref=index.get(hit.asset_path);
      if(!ref)throw new Error("unresolved accepted visual "+hit.asset_path);
      const t=hit.transform;
      candidateRows.push({
        canonical_visual_asset:hit.asset_path,source_sha256:ref.source_sha256,
        bbox:hit.bbox,instance_state:{bbox:hit.bbox,art_scale:t.scale,rotation_deg:t.rotation_deg},
        proof:{inlier_count:t.inlier_count,mean_residual_px:t.mean_residual,
          mean_hamming:t.mean_hamming,shard_index:record.shard_index,
          source_result_key:key},
        identity_scope:"verified_visual_reference"
      });
    }
  }
  candidateRows.sort((a,b)=>b.proof.inlier_count-a.proof.inlier_count||
    a.proof.mean_residual_px-b.proof.mean_residual_px||
    a.proof.mean_hamming-b.proof.mean_hamming);
  const kept=[],suppressed=[];
  for(const row of candidateRows){
    const prev=kept.find(p=>glOverlapIoUV1(row.bbox,p.bbox)>=0.4);
    if(!prev)kept.push(row);
    else suppressed.push({canonical_visual_asset:row.canonical_visual_asset,
      duplicate_of:prev.canonical_visual_asset,iou:glOverlapIoUV1(row.bbox,prev.bbox),
      identity_conflict:row.canonical_visual_asset!==prev.canonical_visual_asset});
  }
  const result={
    schema_version:1,aggregation_version:"screen-dedupe-v1",
    input_key:inputKey,width:tr.width,height:tr.height,
    descriptors:"brief128-v3",input_shard_keys:keys,
    candidate_count:candidateRows.length,detection_count:kept.length,
    duplicate_count:suppressed.length,detections:kept,suppressed_duplicates:suppressed,
    important_limit:"Visual reference identities and artwork bboxes only; semantic game data and unseen cards not inferred."
  };
  await env.BENCHMARK_R2.put(out,JSON.stringify(result),{
    httpMetadata:{contentType:"application/json"},
    customMetadata:{artifact:"screen-dedupe-v1",detection_count:String(kept.length),
      input_shard_count:String(keys.length),duplicate_count:String(suppressed.length)}});
  return {key:out,detections:kept.length,duplicates:suppressed.length};
}


// Ranks all references by descriptor-verified spatial consistency, without
// running RANSAC in individual pool partitions. Geometric verification only
// runs on the final bounded shortlist.
// Relies on the fixed v3 native-resolution descriptor and versioned bank.
async function glHoughReduceShardV1(env,body){
  const si=Math.max(0,Math.min(7,Math.floor(Number(body.shard_index)||0)));
  const poolSize=24,topN=Math.max(8,Math.min(40,Number(body.shortlist)||24));
  const prefix=String(body.part_prefix||"debug/global-local-v7-pool24/");
  const outputKey=String(body.output_key||"debug/global-local-v7-pool24/reduced-shard-"+String(si).padStart(2,"0")+".json");
  if(!prefix.startsWith("debug/")||!outputKey.startsWith("debug/")||!outputKey.endsWith(".json"))
    throw new Error("invalid experimental artifact path");
  const bankKey="debug/whole-screen-local-feature-bank-v3/shards/shard-"+String(si).padStart(2,"0")+".json";
  const bank=await lgLoadBank(env,bankKey);
  const expected=bank.refs.length,parts=[],scores=[],allRarityRanked=new Set();
  let first=null,rankedCount=null;
  for(let start=0;start<expected;start+=poolSize){
    const key=prefix+"shard-"+String(si).padStart(2,"0")+"-p"+String(start).padStart(3,"0")+".json";
    const f=await env.BENCHMARK_R2.get(key);
    if(!f)throw new Error("missing ranking partition "+key);
    const v=JSON.parse(await new Response(f.body).text());
    if(v.error)throw new Error("failed ranking partition "+key+": "+v.error);
    if(v.bank_version!==3||v.shard_index!==si||v.pool_start!==start||
       v.pool_count!==poolSize||v.ranking_mode!=="hough"||v.diagnostic_only!==true||
       v.geometry_executed_count!==0||!Array.isArray(v.shortlist))
      throw new Error("incompatible ranking partition "+key);
    if(first && (first.input_key!==v.input_key||first.descriptor_scale!==v.descriptor_scale))
      throw new Error("inconsistent partition target "+key);
    first=first||v;
    if(rankedCount===null)rankedCount=v.full_ranking_count;
    if(rankedCount!==v.full_ranking_count)throw new Error("inconsistent ranked reference count");
    const shortlist=v.shortlist;
    for(const x of shortlist){
      if(!x.asset_path||!Number.isFinite(x.hough_peak))throw new Error("invalid pool shortlist");
      const prev=scores.find(y=>y.asset_path===x.asset_path);
      if(prev)throw new Error("reference repeated across rarity partitions "+x.asset_path);
      const sampleStride=Math.max(1,Math.min(4,Number(v.diagnostics?.candidate_stride)||1));
      scores.push({...x,source_part:key,source_pool_start:start,
        candidate_stride:sampleStride,
        normalized_hough_peak:x.hough_peak*sampleStride});
    }
    parts.push({key,considered:Math.min(poolSize,Math.max(0,rankedCount-start)),
      winners:shortlist.length,top_peak:shortlist[0]?.hough_peak||0});
    if(start+poolSize>=rankedCount)break;
  }
  if(!first||!parts.length||parts.reduce((sum,p)=>sum+p.considered,0)!==rankedCount)
    throw new Error("incomplete Hough pool coverage");
  const pathToIndex=new Map(bank.refs.map((r,i)=>[r.asset_path,i]));
  scores.sort((a,b)=>b.normalized_hough_peak-a.normalized_hough_peak||
    a.hough_mean_hamming-b.hough_mean_hamming||
    b.score-a.score||a.asset_path.localeCompare(b.asset_path));
  const unique=scores.slice(0,topN).map(row=>{
    const i=pathToIndex.get(row.asset_path);
    if(i===undefined)throw new Error("unknown canonical visual "+row.asset_path);
    return {i,...row};
  });
  const tr=await glV3Screenshot(env,first.input_key,first.descriptor_scale);
  const idx=await glLoadPackedIndexV2(env,si,3);
  if(idx.reference_count!==bank.refs.length)throw new Error("v3 packed mismatch");
  const found=glDenseRarePairsV1(tr.features,bank,idx,unique,48,192);
  const refs=unique.map(v=>bank.refs[v.i]),rows=glRankRefs24(found.per,refs,{x:0,y:0});
  const accepted=rows.filter(row=>{
    const t=row.transform;
    return !!t&&((t.inlier_count>=6&&t.mean_hamming<=18&&t.mean_residual<=2.5)||
      (t.inlier_count>=4&&t.mean_hamming<=4&&t.mean_residual<=1));
  });
  const out={
    schema_version:1,proof_version:"dense-rare-shortlist-v1",
    retrieval_version:"exhaustive-24-pool-hough-v1",
    shard_index:si,bank_version:3,input_key:first.input_key,
    descriptor_scale:first.descriptor_scale,target_feature_count:tr.features.length,
    reference_count:bank.refs.length,ranked_reference_count:rankedCount,
    partition_count:parts.length,partitions:parts,
    hough_candidates_considered:scores.length,
    ranking_note:"Hough peaks scaled by candidate keypoint sampling stride; trust still comes only from full-feature geometry",
    candidate_reference_count:rows.length,geometry_executed_count:rows.length,
    shortlist_count:unique.length,
    shortlist:unique.map((x,rank)=>({rank:rank+1,name:basename(x.asset_path),
      asset_path:x.asset_path,hough_peak:x.hough_peak,
      normalized_hough_peak:x.normalized_hough_peak,candidate_stride:x.candidate_stride,
      hough_mean_hamming:x.hough_mean_hamming,score:x.score,
      source_pool_start:x.source_pool_start,raw_pairs:found.per[rank]?.length||0})),
    accepted_count:accepted.length,accepted,top:rows.slice(0,24),
    diagnostics:found.stats
  };
  await env.BENCHMARK_R2.put(outputKey,JSON.stringify(out),{
    httpMetadata:{contentType:"application/json"},
    customMetadata:{artifact:"exhaustive-24-pool-hough-v1",
      reference_count:String(bank.refs.length),ranked_reference_count:String(rankedCount),
      candidate_count:String(scores.length),accepted_count:String(accepted.length)}});
  return {key:outputKey,shortlisted:unique.length,accepted:accepted.length};
}



// Experimental-only screenshot ingestion. Browser/client uploads BYTES ONLY;
// all recognition and visual feature extraction remain server-side.
// This endpoint is disabled unless env.BAZAAR_SCREENSHOT_UPLOAD_TOKEN exists.
const BAZAAR_MAX_SCREENSHOT_BYTES=10*1024*1024;
async function bzScreenshotUploadV1(request,env){
  if(!env.BAZAAR_SCREENSHOT_UPLOAD_TOKEN) return new Response(JSON.stringify({
    ok:false,error:"upload_not_configured"
  }),{status:503,headers:{"content-type":"application/json","cache-control":"no-store"}});
  const authorization=request.headers.get("authorization")||"";
  const expected="Bearer "+env.BAZAAR_SCREENSHOT_UPLOAD_TOKEN;
  // Avoid direct early character-by-character leaks.
  const encoder=new TextEncoder(),actual=encoder.encode(authorization),target=encoder.encode(expected);
  let diff=actual.length^target.length;
  for(let i=0;i<Math.max(actual.length,target.length);i++)
    diff|=(actual[i]||0)^(target[i]||0);
  if(diff!==0)return new Response(JSON.stringify({ok:false,error:"unauthorized"}),{
    status:401,headers:{"content-type":"application/json","cache-control":"no-store"}});
  const media=(request.headers.get("content-type")||"").split(";")[0].trim().toLowerCase();
  if(media!=="image/png")return new Response(JSON.stringify({ok:false,error:"png_required"}),{
    status:415,headers:{"content-type":"application/json","cache-control":"no-store"}});
  const n=Number(request.headers.get("content-length")||0);
  if(n>BAZAAR_MAX_SCREENSHOT_BYTES)return new Response(JSON.stringify({ok:false,error:"image_too_large"}),{
    status:413,headers:{"content-type":"application/json","cache-control":"no-store"}});
  const ab=await request.arrayBuffer();
  if(ab.byteLength<33||ab.byteLength>BAZAAR_MAX_SCREENSHOT_BYTES)
    return new Response(JSON.stringify({ok:false,error:"invalid_image_size"}),{
      status:413,headers:{"content-type":"application/json","cache-control":"no-store"}});
  const bytes=new Uint8Array(ab);
  const sig=[137,80,78,71,13,10,26,10];
  if(sig.some((b,i)=>bytes[i]!==b)||String.fromCharCode(...bytes.slice(12,16))!=="IHDR")
    return new Response(JSON.stringify({ok:false,error:"invalid_png"}),{
      status:415,headers:{"content-type":"application/json","cache-control":"no-store"}});
  const view=new DataView(ab);
  const width=view.getUint32(16),height=view.getUint32(20);
  if(width<64||height<64||width>8192||height>8192||
     width*height>24000000) return new Response(JSON.stringify({
       ok:false,error:"invalid_dimensions"
     }),{status:422,headers:{"content-type":"application/json","cache-control":"no-store"}});
  const sha=Array.from(new Uint8Array(await crypto.subtle.digest("SHA-256",ab)),
    x=>x.toString(16).padStart(2,"0")).join("");
  const key="perception/inputs/"+sha+".png";
  const prior=await env.BENCHMARK_R2.head(key);
  if(!prior)await env.BENCHMARK_R2.put(key,ab,{
    httpMetadata:{contentType:"image/png"},customMetadata:{
      artifact:"experimental-native-screenshot",sha256:sha,
      width:String(width),height:String(height),bytes:String(ab.byteLength)
    }});
  let recognition_status="stored_no_queue",queued_count=0;
  if(env.SCREENSHOT_QUEUE){
    const shardJobs=Array.from({length:8},(_,si)=>({
      body:{kind:"global_full_dense_rare_shortlist",
        bank_version:3,shard_index:si,input_key:key,scale:1,
        shortlist:24,pool:64,ranking:"hough",pair_mode:"rarity",
        max_bucket:48,output_key:bzExperimentShardKeyV1(sha,si)}
    }));
    await env.SCREENSHOT_QUEUE.sendBatch(shardJobs);
    recognition_status="queued";
    queued_count=shardJobs.length;
  }
  if(env.REGION_QUEUE){
    await env.REGION_QUEUE.send({kind:"fullcatalog_start_v2",input_key:key,
      output_key:bzFullConvBaseV1(key)+"error-start.json"});
    queued_count++;
    recognition_status="full_catalogue_localization_and_matching_queued";
  }
  const response={schema_version:1,ok:true,input_key:key,sha256:sha,
    width,height,bytes:ab.byteLength,previously_present:!!prior,
    recognition_status,queued_count,runtime:"Cloudflare server-side"};
  return new Response(JSON.stringify(response),{
    status:201,headers:{"content-type":"application/json","cache-control":"no-store"}});
}

function bzExperimentShardKeyV1(sha,si){
  return "debug/experimental-screenshot-v1/"+sha+"/shard-"+String(si).padStart(2,"0")+".json";
}
function bzResultHeadersV1(){return {"content-type":"application/json","cache-control":"no-store"};}
async function bzExperimentalScreenshotStatusV1(request,env,sha){
  if(!env.BAZAAR_SCREENSHOT_UPLOAD_TOKEN)return new Response(JSON.stringify({error:"upload_not_configured"}),{
    status:503,headers:bzResultHeadersV1()});
  const actual=new TextEncoder().encode(request.headers.get("authorization")||""),
    expected=new TextEncoder().encode("Bearer "+env.BAZAAR_SCREENSHOT_UPLOAD_TOKEN);
  let diff=actual.length^expected.length;
  for(let i=0;i<Math.max(actual.length,expected.length);i++)
    diff|=(actual[i]||0)^(expected[i]||0);
  if(diff!==0)return new Response(JSON.stringify({error:"unauthorized"}),{
    status:401,headers:bzResultHeadersV1()});
  if(!/^[a-f0-9]{64}$/.test(sha))return new Response(JSON.stringify({error:"invalid_sha"}),{
    status:400,headers:bzResultHeadersV1()});
  const source=await env.BENCHMARK_R2.head("perception/inputs/"+sha+".png");
  if(!source)return new Response(JSON.stringify({error:"screenshot_not_found"}),{
    status:404,headers:bzResultHeadersV1()});
  const status=[],shardKeys=[];
  for(let si=0;si<8;si++){
    const key=bzExperimentShardKeyV1(sha,si),obj=await env.BENCHMARK_R2.get(key);
    if(!obj){status.push({shard_index:si,status:"pending"});continue;}
    const v=JSON.parse(await new Response(obj.body).text());
    if(v.error)status.push({shard_index:si,status:"failed",error:v.error});
    else if(v.bank_version===3&&v.shard_index===si&&v.input_key==="perception/inputs/"+sha+".png"){
      status.push({shard_index:si,status:"completed",accepted_count:v.accepted_count});
      shardKeys.push(key);
    }else status.push({shard_index:si,status:"invalid_result"});
  }
  const allComplete=status.every(x=>x.status==="completed"),
    aggregateKey="debug/experimental-screenshot-v1/"+sha+"/aggregated.json";
  let aggregate=null;
  if(allComplete){
    const existing=await env.BENCHMARK_R2.get(aggregateKey);
    if(existing)aggregate=JSON.parse(await new Response(existing.body).text());
    else if(request.method==="POST"){
      aggregate=await glAggregateScreenV1(env,{
        shard_keys:shardKeys,output_key:aggregateKey
      });
      const saved=await env.BENCHMARK_R2.get(aggregateKey);
      aggregate=saved?JSON.parse(await new Response(saved.body).text()):aggregate;
    }
  }
  const fullcatalog=await bzFullcatalogStatusV2(env,"perception/inputs/"+sha+".png");
  const fullcatalogKey=bzFullConvBaseV1("perception/inputs/"+sha+".png")+"result.json";
  const fullcatalogObject=await env.BENCHMARK_R2.get(fullcatalogKey);
  const fullcatalogResult=fullcatalogObject?JSON.parse(await new Response(fullcatalogObject.body).text()):null;
  const regionKey=bzRegionBaseV1(sha)+"result.json";
  const regionObject=await env.BENCHMARK_R2.get(regionKey);
  const regionResult=regionObject?JSON.parse(await new Response(regionObject.body).text()):null;
  return new Response(JSON.stringify({schema_version:1,sha256:sha,
    region_result_key:regionKey,region_ready:!!regionResult,
    region_count:regionResult?.region_count||0,
    verified_region_count:regionResult?.verified_region_count||0,
    region_result:regionResult,
    fullcatalog_status:fullcatalog,fullcatalog_ready:!!fullcatalogResult,
    fullcatalog_result:fullcatalogResult,
    identity_probabilities_calibrated:false,
    input_key:"perception/inputs/"+sha+".png",all_complete:allComplete,
    complete_shards:shardKeys.length,status,
    aggregate_ready:!!aggregate,aggregate}),{
      status:(allComplete||fullcatalog.complete)?200:202,headers:bzResultHeadersV1()});
}



// Reassemble exact screenshot bytes transferred through the connector into R2.
// This is strictly server-side and verifies the full-file SHA before saving.
async function bzAssembleTransportV1(env,body){
  const sha=String(body.sha256||"").toLowerCase();
  if(!/^[a-f0-9]{64}$/.test(sha))throw new Error("invalid expected sha256");
  const num=Math.floor(Number(body.part_count));
  if(num<1||num>96)throw new Error("invalid part_count");
  const expected=Math.floor(Number(body.expected_bytes));
  if(expected<33||expected>10*1024*1024)throw new Error("invalid byte count");
  const prefix="debug/experimental-screenshot-v1/"+sha+"/";
  const resultKey=prefix+"assembly.json";
  const chunks=[];
  let len=0;
  for(let i=0;i<num;i++){
    const key=prefix+"transport-"+String(i).padStart(2,"0")+".bin";
    const obj=await env.BENCHMARK_R2.get(key);
    if(!obj)throw new Error("missing transfer chunk "+i);
    const bytes=new Uint8Array(await obj.arrayBuffer());
    if(!bytes.length)throw new Error("zero-sized transport chunk "+i);
    chunks.push(bytes);len+=bytes.length;
    if(len>expected)throw new Error("transfer oversized");
  }
  if(len!==expected)throw new Error("transfer length mismatch: "+len+" != "+expected);
  const full=new Uint8Array(len);
  let off=0;
  for(const bytes of chunks){full.set(bytes,off);off+=bytes.length;}
  const png=[137,80,78,71,13,10,26,10];
  if(png.some((v,i)=>full[i]!==v)||String.fromCharCode(...full.slice(12,16))!=="IHDR")
    throw new Error("reassembled bytes not PNG");
  const hash=Array.from(new Uint8Array(await crypto.subtle.digest("SHA-256",full)),
      n=>n.toString(16).padStart(2,"0")).join("");
  if(hash!==sha)throw new Error("SHA-256 checksum mismatch");
  const key="perception/inputs/"+sha+".png";
  await env.BENCHMARK_R2.put(key,full,{
    httpMetadata:{contentType:"image/png"},
    customMetadata:{artifact:"native-screenshot-exact-original",sha256:hash,
      bytes:String(len),part_count:String(num)}
  });
  const data={schema_version:1,sha256:hash,bytes:len,
    width:new DataView(full.buffer).getUint32(16),
    height:new DataView(full.buffer).getUint32(20),
    part_count:num,verified:true,input_key:key,
    assembled_at:new Date().toISOString()};
  await env.BENCHMARK_R2.put(resultKey,JSON.stringify(data),{
    httpMetadata:{contentType:"application/json"}
  });
  return data;
}



// Region-first screenshot recognition, native resolution, Cloudflare Worker only.
// Proposals are discovered using repeatable vertical art-frame boundaries,
// not hero, merchant, screen, or item hard-coded coordinates.
function bzRegionBaseV1(sha){return "debug/region-hypotheses-v1/"+sha+"/";}
function bzRegionImageShaV1(inputKey){
  const m=/^perception\/inputs\/([a-f0-9]{64})\.png$/.exec(String(inputKey));
  if(!m)throw new Error("region recognizer requires immutable PNG input SHA");
  return m[1];
}
function bzMedianV1(values){
  const a=[...values].sort((x,y)=>x-y);
  return a.length?a[Math.floor(a.length/2)]:0;
}
function bzRegionsFromPixelsV1(im){
  const {width:w,height:h,rgba:data}=im;
  if(w<320||h<320||w*h>24000000)throw new Error("unsupported region localization dimensions");
  const gray=new Uint8Array(w*h),lineSegments=[];
  for(let p=0;p<gray.length;p++){
    const k=p*4;gray[p]=Math.round(0.299*data[k]+0.587*data[k+1]+0.114*data[k+2]);
  }
  const stepX=Math.max(1,Math.round(w/683)),gapY=Math.max(6,Math.round(h*.012));
  const minL=Math.max(75,Math.round(h*.127)),maxL=Math.round(h*.30);
  for(let x=4;x<w-4;x+=stepX){
    let first=-1,prev=-1,n=0;
    const finish=()=>{
      if(first<0)return;
      const len=prev-first;
      if(len>=minL&&len<=maxL&&n/(len+1)>.40)
        lineSegments.push({x,y0:first,y1:prev,len,n});
    };
    for(let y=0;y<h;y++){
      const p=y*w+x;
      if(Math.abs(gray[p-2]-gray[p+2])<40)continue;
      if(prev>=0&&y-prev>gapY){finish();first=y;n=0;}
      if(first<0)first=y;
      prev=y;n++;
    }
    finish();
  }
  const yHalf=Math.max(6,Math.round(h*.0105)),votes=new Float32Array(h);
  for(const seg of lineSegments){
    const v=seg.n/(seg.len+1);
    for(let y=Math.max(0,seg.y0-yHalf);y<=Math.min(h-1,seg.y0+yHalf);y++)votes[y]+=v;
  }
  const minPeakDistance=Math.max(45,Math.round(h*.067));
  const peaks=[];
  for(let y=1;y<h-1;y++)if(votes[y]>=2.5&&votes[y]>=votes[y-1]&&votes[y]>votes[y+1])
    peaks.push({y,v:votes[y]});
  peaks.sort((a,b)=>b.v-a.v||a.y-b.y);
  const chosen=[];
  for(const peak of peaks){
    if(chosen.length>=10)break;
    if(chosen.every(p=>Math.abs(p.y-peak.y)>=minPeakDistance))chosen.push(peak);
  }
  const proposals=[],bands=[],rejectedBands=[];
  for(const peak of chosen.sort((a,b)=>a.y-b.y)){
    const yBand=peak.y,near=Math.max(14,Math.round(h*.024));
    const s0=lineSegments.filter(t=>Math.abs(t.y0-yBand)<=near);
    if(s0.length<5)continue;
    const medianL=bzMedianV1(s0.map(t=>t.len));
    const consistent=s0.filter(t=>Math.abs(t.len-medianL)<=Math.max(24,Math.round(h*.045)))
      .sort((a,b)=>a.x-b.x);
    const groups=[],nearX=Math.max(9,Math.round(w*.0115));
    for(const t of consistent){
      if(!groups.length||t.x-groups[groups.length-1].at(-1).x>nearX)groups.push([t]);
      else groups[groups.length-1].push(t);
    }
    const centers=groups.map(g=>{
      const mass=g.reduce((z,t)=>z+t.n,0);
      return {x:Math.round(g.reduce((z,t)=>z+t.x*t.n,0)/mass),
        mass,count:g.length,y0:bzMedianV1(g.map(t=>t.y0)),
        y1:bzMedianV1(g.map(t=>t.y1))};
    }).sort((a,b)=>a.x-b.x);
    const regions=[];
    for(let k=0;k<centers.length-1;k++){
      const a=centers[k],b=centers[k+1],span=b.x-a.x;
      if(span<Math.max(65,Math.round(w*.049))||span>Math.round(w*.205))continue;
      // The frame boundary contains ornaments; take the artwork interior.
      const inX=Math.max(3,Math.round(w*.0034)),inY=Math.max(3,Math.round(h*.006));
      const box={x:Math.max(0,a.x+inX),y:Math.max(0,yBand+inY),
        width:Math.min(w-a.x-inX,span-2*inX),
        height:Math.min(h-yBand-inY,medianL-Math.round(h*.011))};
      if(box.width<55||box.height<80)continue;
      // Local gray variance distinguishes textured art from empty backdrop.
      let count=0,sum=0,sq=0,edge=0;
      const sx=Math.max(1,Math.floor(box.width/42)),sy=Math.max(1,Math.floor(box.height/48));
      for(let y=box.y+3;y<box.y+box.height-3;y+=sy)
        for(let x=box.x+3;x<box.x+box.width-3;x+=sx){
          const p=y*w+x,g=gray[p];sum+=g;sq+=g*g;edge+=Math.abs(g-gray[p-2]);
          count++;
        }
      const deviation=Math.sqrt(Math.max(0,sq/count-(sum/count)**2)),
        edgeContrast=edge/count;
      if(deviation<24||edgeContrast<2)continue;
      const region={bbox:box,proposal_score:Number((deviation+2*edgeContrast).toFixed(3)),
        border_evidence:{left_x:a.x,right_x:b.x,row_y:yBand,segment_height:medianL},
        texture_stddev:Number(deviation.toFixed(3))};
      regions.push(region);
    }
    // A single rectangle from HUD decoration is not considered an item row.
    if(regions.length<3){rejectedBands.push({y:yBand,proposal_count:regions.length,edge_votes:Number(peak.v.toFixed(3)),frame_edges:centers.map(c=>({x:c.x,y0:c.y0,y1:c.y1,count:c.count})),candidates:regions.map(p=>p.bbox)});continue;}
    bands.push({y:yBand,proposal_count:regions.length,edge_votes:Number(peak.v.toFixed(3)),frame_edges:centers.map(c=>({x:c.x,count:c.count,mass:c.mass,y0:c.y0,y1:c.y1})),candidate_spans:centers.slice(1).map((c,i)=>({left:centers[i].x,right:c.x,width:c.x-centers[i].x}))});
    proposals.push(...regions);
  }
  proposals.sort((a,b)=>a.bbox.y-b.bbox.y||a.bbox.x-b.bbox.x);
  const unique=[];
  for(const p of proposals){
    const b=p.bbox;
    if(unique.some(q=>{
      const c=q.bbox,x=Math.max(0,Math.min(b.x+b.width,c.x+c.width)-Math.max(b.x,c.x)),
        y=Math.max(0,Math.min(b.y+b.height,c.y+c.height)-Math.max(b.y,c.y));
      return x*y/(b.width*b.height+c.width*c.height-x*y)>0.66;
    }))continue;
    unique.push({...p,region_id:"region-"+String(unique.length+1).padStart(2,"0")});
  }
  return {regions:unique.slice(0,36),bands,rejected_bands:rejectedBands,
    diagnostics:{vertical_segments:lineSegments.length,band_candidates:chosen.length,
      accepted_row_bands:bands.length,method:"native-boundary-repetition-v1"}};
}
async function bzLocalizeRegionsV1(env,body){
  const inputKey=String(body.input_key||""),
    sha=bzRegionImageShaV1(inputKey),base=bzRegionBaseV1(sha),
    obj=await env.BENCHMARK_R2.get(inputKey);
  if(!obj)throw new Error("region screenshot absent");
  const png=await decodePng(await new Response(obj.body).arrayBuffer());
  const result=bzRegionsFromPixelsV1(png);
  const artifact={schema_version:1,detector_version:"boundary-repetition-v1",
    input_key:inputKey,sha256:sha,width:png.width,height:png.height,
    ...result,generated_at:new Date().toISOString()};
  await env.BENCHMARK_R2.put(base+"regions.json",JSON.stringify(artifact),{
    httpMetadata:{contentType:"application/json"},
    customMetadata:{artifact:"screenshot-regions-v1",region_count:String(result.regions.length)}});
  if(body.dispatch!==false&&(env.REGION_QUEUE||env.SCREENSHOT_QUEUE)){
    await (env.REGION_QUEUE||env.SCREENSHOT_QUEUE).sendBatch(Array.from({length:8},(_,si)=>({
      body:{kind:"region_rank_shard_v1",input_key:inputKey,shard_index:si}
    })));
  }
  return {region_count:result.regions.length,regions_key:base+"regions.json",bands:result.bands};
}
async function bzRankRegionsShardV1(env,body){
  const inputKey=String(body.input_key||""),sha=bzRegionImageShaV1(inputKey),
    base=bzRegionBaseV1(sha),si=Math.floor(Number(body.shard_index));
  if(!Number.isInteger(si)||si<0||si>7)throw new Error("invalid shard");
  const proposal=await env.BENCHMARK_R2.get(base+"regions.json");
  if(!proposal)throw new Error("region proposals missing");
  const obj=JSON.parse(await new Response(proposal.body).text());
  if(obj.input_key!==inputKey||!Array.isArray(obj.regions))throw new Error("region source mismatch");
  const bank=await lgLoadBank(env,"debug/whole-screen-local-feature-bank-v3/shards/shard-"+
    String(si).padStart(2,"0")+".json"),
    idx=await glLoadPackedIndexV2(env,si,3),tr=await glV3Screenshot(env,inputKey,1);
  const rows=[];
  for(const reg of obj.regions){
    const box=reg.bbox,pad=6,
      local=tr.features.filter(p=>p.x>=box.x+pad&&p.y>=box.y+pad&&
        p.x<box.x+box.width-pad&&p.y<box.y+box.height-pad);
    const votes=local.length>=4?glRareVotePacked(local,bank.refs,idx,Math.min(12,bank.refs.length),48):[];
    rows.push({region_id:reg.region_id,feature_count:local.length,
      shortlist:votes.map(v=>({canonical_visual_asset:bank.refs[v.i].asset_path,
        raw_score:Number(v.score.toFixed(5)),votes:Number(v.votes.toFixed(4)),
        hits:v.hits,reference_features:bank.refs[v.i].features.length,shard_index:si}))});
  }
  const output={schema_version:1,ranker_version:"region-brief128-v3-rarity-v1",
    input_key:inputKey,region_source_key:base+"regions.json",shard_index:si,
    reference_count:bank.refs.length,descriptor_scale:1,regions:rows};
  await env.BENCHMARK_R2.put(base+"rank-shard-"+String(si).padStart(2,"0")+".json",
    JSON.stringify(output),{httpMetadata:{contentType:"application/json"}});
  let finished=true;
  for(let k=0;k<8;k++){
    if(!await env.BENCHMARK_R2.head(base+"rank-shard-"+String(k).padStart(2,"0")+".json")){
      finished=false;break;
    }
  }
  if(finished)await bzAggregateRegionsV1(env,{input_key:inputKey});
  return {shard_index:si,region_count:rows.length,complete:finished};
}
function bzRegionIoUV1(b,c){
  if(!b||!c)return 0;
  const x=Math.max(0,Math.min(b.x+b.width,c.x+c.width)-Math.max(b.x,c.x)),
    y=Math.max(0,Math.min(b.y+b.height,c.y+c.height)-Math.max(b.y,c.y));
  return x*y/(b.width*b.height+c.width*c.height-x*y)||0;
}
async function bzAggregateRegionsV1(env,body){
  const inputKey=String(body.input_key||""),sha=bzRegionImageShaV1(inputKey),
    base=bzRegionBaseV1(sha),obj=await env.BENCHMARK_R2.get(base+"regions.json");
  if(!obj)throw new Error("regions missing for aggregation");
  const loc=JSON.parse(await new Response(obj.body).text());
  const rs=[];
  for(let si=0;si<8;si++){
    const key=base+"rank-shard-"+String(si).padStart(2,"0")+".json",
      o=await env.BENCHMARK_R2.get(key);
    if(!o)throw new Error("ranking shard absent "+si);
    const x=JSON.parse(await new Response(o.body).text());
    if(x.shard_index!==si||x.input_key!==inputKey)throw new Error("mixed ranking shards");
    rs.push(x);
  }
  const old=await env.BENCHMARK_R2.get(
    "debug/experimental-screenshot-v1/"+sha+"/aggregated.json");
  const accepted=old?JSON.parse(await new Response(old.body).text()).detections||[]:[];
  const rows=loc.regions.map(reg=>{
    const region=reg.region_id,b=reg.bbox;
    const all=rs.flatMap(sh=>sh.regions.find(x=>x.region_id===region)?.shortlist||[]);
    const unique=new Map();
    for(const c of all){
      const key=c.canonical_visual_asset,old=unique.get(key);
      if(!old||old.raw_score<c.raw_score)unique.set(key,c);
    }
    const ordered=[...unique.values()].sort((a,b)=>b.raw_score-a.raw_score||
      a.canonical_visual_asset.localeCompare(b.canonical_visual_asset));
    const pin=accepted.map(a=>({...a,iou:bzRegionIoUV1(b,a.bbox)}))
      .sort((a,b)=>b.iou-a.iou)[0];
    const verified=pin?.iou>=.50?{
      canonical_visual_asset:pin.canonical_visual_asset,
      proof:pin.proof,overlap_iou:Number(pin.iou.toFixed(4))
    }:null;
    if(verified){
      const at=ordered.findIndex(c=>c.canonical_visual_asset===verified.canonical_visual_asset);
      if(at>0)ordered.unshift(ordered.splice(at,1)[0]);
      else if(at<0)ordered.unshift({
        canonical_visual_asset:verified.canonical_visual_asset,raw_score:null,
        votes:null,hits:null,shard_index:pin.proof?.shard_index});
    }
    const top=ordered.slice(0,6),finite=top.filter(c=>Number.isFinite(c.raw_score));
    const max=finite.length?Math.max(...finite.map(c=>c.raw_score)):0;
    const temp=Math.max(.6,max*.17);
    const exp=top.map(c=>Number.isFinite(c.raw_score)?
      Math.exp((c.raw_score-max)/temp):0),norm=exp.reduce((a,b)=>a+b,0);
    return {region_id:region,bbox:b,proposal_score:reg.proposal_score,
      target_feature_count:rs[0].regions.find(x=>x.region_id===region)?.feature_count||0,
      status:verified?"verified_visual_reference":"unverified_hypotheses",
      verified,top_candidates:top.map((c,i)=>({
        rank:i+1,canonical_visual_asset:c.canonical_visual_asset,
        raw_score:c.raw_score,relative_support_pct:norm?
          Number((100*exp[i]/norm).toFixed(2)):null,
        votes:c.votes,hits:c.hits,shard_index:c.shard_index,
        verification:verified?.canonical_visual_asset===c.canonical_visual_asset?
          "accepted_geometry":"unverified"
      }))};
  });
  const result={schema_version:1,version:"region-first-candidate-sets-v1",
    input_key:inputKey,sha256:sha,width:loc.width,height:loc.height,
    region_count:rows.length,regions:rows,
    catalogue_reference_count:rs.reduce((a,s)=>a+s.reference_count,0),
    verified_region_count:rows.filter(r=>r.verified).length,
    metrics:{localizer:loc.diagnostics,region_count:rows.length,
      shard_count:rs.length,ranked_region_shard_pairs:rs.reduce((n,s)=>n+s.regions.length,0)},
    score_semantics:{
      raw_score:"rare BRIEF128 feature votes, normalized for reference feature count",
      relative_support_pct:"softmax-normalized weight within top candidates ONLY, not a calibrated probability",
      unknown_class:"not estimated; missing candidates and artwork absence remain possible",
      probability_calibrated:false,
      verification:"accepted geometric verification only, never inferred from candidate scores"
    },generated_at:new Date().toISOString()};
  await env.BENCHMARK_R2.put(base+"result.json",JSON.stringify(result),{
    httpMetadata:{contentType:"application/json"},
    customMetadata:{artifact:"region-first-candidate-sets-v1",
      proposal_count:String(rows.length),verified_count:String(result.verified_region_count)}});
  return {result_key:base+"result.json",region_count:rows.length,
    verified_region_count:result.verified_region_count};
}



// Experimental non-neural convolution + anisotropic PDE comparison of crop-aware artwork.
// Region boxes are programmatic and candidates come only from the existing learned shortlist.
// Neither benchmark ground-truth labels nor scene-specific coordinates are consulted.
function bzAffineBaseV1(key){
  return "debug/region-affine-convolution-v1/"+bzRegionImageShaV1(key)+"/";
}
function bzAffineClampV1(x,lo,hi){return Math.max(lo,Math.min(hi,x));}
function bzAffineSampleV1(data,w,h,x,y){
  x=bzAffineClampV1(x,0,w-1);y=bzAffineClampV1(y,0,h-1);
  const x0=Math.floor(x),y0=Math.floor(y),x1=Math.min(w-1,x0+1),y1=Math.min(h-1,y0+1);
  const u=x-x0,v=y-y0,a=(y0*w+x0)*4,b=(y0*w+x1)*4,
    c=(y1*w+x0)*4,d=(y1*w+x1)*4,arr=[];
  for(let j=0;j<3;j++)arr.push(
    ((data[a+j]*(1-u)+data[b+j]*u)*(1-v)+
    (data[c+j]*(1-u)+data[d+j]*u)*v)/255);
  return arr;
}
function bzAffineGridV1(im,box,W=32,H=48,mode="target",shift=0){
  const {width:w,height:h,rgba:data}=im,out=new Float32Array(W*H*3);
  const padx=mode==="target"?Math.max(3,box.width*.024):0;
  const pady=mode==="target"?Math.max(3,box.height*.027):0;
  const aspect=box.width/box.height;
  // Reference cover means center-cropping surplus landscape width to portrait art.
  // This tests crop, not deform, against independent x/y scale (stretch).
  let ox=0,oy=0,cw=w,ch=h;
  if(mode==="cover"){
    if(w/h>aspect){cw=h*aspect;ox=(w-cw)*(.5+shift);}
    else{ch=w/aspect;oy=(h-ch)*(.5+shift);}
  }
  for(let y=0;y<H;y++)for(let x=0;x<W;x++){
    const u=(x+.5)/W,v=(y+.5)/H;
    const xx=mode==="target"?box.x+padx+u*(box.width-2*padx):ox+u*cw,
      yy=mode==="target"?box.y+pady+v*(box.height-2*pady):oy+v*ch;
    const col=bzAffineSampleV1(data,w,h,xx,yy);
    const i=3*(y*W+x);out[i]=col[0];out[i+1]=col[1];out[i+2]=col[2];
  }
  return out;
}
function bzAffineGrayV1(rgb){
  const out=new Float32Array(rgb.length/3);
  for(let i=0;i<out.length;i++)out[i]=rgb[3*i]*.299+rgb[3*i+1]*.587+rgb[3*i+2]*.114;
  return out;
}
function bzAffineGaussianV1(gray,W,H){
  // Separable 3x3 Gaussian convolution, kernel [1,2,1]/4.
  const tmp=new Float32Array(gray.length),out=new Float32Array(gray.length);
  for(let y=0;y<H;y++)for(let x=0;x<W;x++){
    const a=gray[y*W+Math.max(0,x-1)],b=gray[y*W+x],
      c=gray[y*W+Math.min(W-1,x+1)];
    tmp[y*W+x]=(a+2*b+c)*.25;
  }
  for(let y=0;y<H;y++)for(let x=0;x<W;x++){
    const a=tmp[Math.max(0,y-1)*W+x],b=tmp[y*W+x],
      c=tmp[Math.min(H-1,y+1)*W+x];
    out[y*W+x]=(a+2*b+c)*.25;
  }
  return out;
}
function bzAffineDiffusionV1(gray,W,H,n=4,kappa=.09){
  // Explicit nonlinear anisotropic heat equation (Perona-Malik style).
  // dt=.16 <= .25 stability bound for a 4-neighbor grid.
  let u=new Float32Array(gray);
  for(let z=0;z<n;z++){
    const out=new Float32Array(u.length);
    for(let y=0;y<H;y++)for(let x=0;x<W;x++){
      const i=y*W+x,mid=u[i];
      let flow=0;
      const offsets=[y>0?i-W:i,y<H-1?i+W:i,x>0?i-1:i,x<W-1?i+1:i];
      for(let j=0;j<4;j++){
        const d=u[offsets[j]]-mid;
        flow+=d/(1+(d/kappa)*(d/kappa));
      }
      out[i]=bzAffineClampV1(mid+.16*flow,0,1);
    }
    u=out;
  }
  return u;
}
function bzAffineCorrV1(a,b){
  if(a.length!==b.length||a.length===0)throw new Error("size mismatch");
  let ma=0,mb=0;for(let i=0;i<a.length;i++){ma+=a[i];mb+=b[i];}
  ma/=a.length;mb/=b.length;
  let aa=0,bb=0,ab=0;
  for(let i=0;i<a.length;i++){const x=a[i]-ma,y=b[i]-mb;aa+=x*x;bb+=y*y;ab+=x*y;}
  return aa*bb>1e-9?ab/Math.sqrt(aa*bb):0;
}
function bzAffineHogV1(gray,W,H){
  const cellsX=4,cellsY=6,bins=8,hist=new Float32Array(cellsX*cellsY*bins);
  for(let y=1;y<H-1;y++)for(let x=1;x<W-1;x++){
    const p=y*W+x,dx=gray[p+1]-gray[p-1],dy=gray[p+W]-gray[p-W],
      mag=Math.hypot(dx,dy);
    if(mag<.001)continue;
    const ang=(Math.atan2(dy,dx)+Math.PI)%(Math.PI),bin=Math.min(bins-1,Math.floor(bins*ang/Math.PI)),
      cx=Math.min(cellsX-1,Math.floor(x*cellsX/W)),
      cy=Math.min(cellsY-1,Math.floor(y*cellsY/H));
    hist[(cy*cellsX+cx)*bins+bin]+=mag;
  }
  // Local L2 normalize to prevent brightness/contrast bias.
  for(let c=0;c<cellsX*cellsY;c++){
    let norm=.0001;for(let j=0;j<bins;j++)norm+=hist[c*bins+j]**2;
    norm=Math.sqrt(norm);for(let j=0;j<bins;j++)hist[c*bins+j]/=norm;
  }
  return hist;
}
function bzAffineHogCosineV1(a,b){
  let dot=0,na=0,nb=0;
  for(let i=0;i<a.length;i++){dot+=a[i]*b[i];na+=a[i]**2;nb+=b[i]**2;}
  return dot/Math.sqrt((na+.000001)*(nb+.000001));
}
function bzAffineChromaV1(rgb){
  const a=new Float32Array(rgb.length);
  for(let i=0;i<rgb.length;i+=3){
    const mean=(rgb[i]+rgb[i+1]+rgb[i+2])/3;
    a[i]=rgb[i]-mean;a[i+1]=rgb[i+1]-mean;a[i+2]=rgb[i+2]-mean;
  }
  return a;
}
function bzAffineSummaryV1(grid,W,H){
  const gray=bzAffineGrayV1(grid),blur=bzAffineGaussianV1(gray,W,H),
    diffusion=bzAffineDiffusionV1(blur,W,H);
  return {gray:blur,pde:diffusion,hog:bzAffineHogV1(blur,W,H),
    pdeHog:bzAffineHogV1(diffusion,W,H),chroma:bzAffineChromaV1(grid)};
}
function bzAffineCompareV1(x,y){
  const ga=(bzAffineCorrV1(x.gray,y.gray)+1)*.5,
    chroma=(bzAffineCorrV1(x.chroma,y.chroma)+1)*.5,
    h=bzAffineHogCosineV1(x.hog,y.hog),
    ph=bzAffineHogCosineV1(x.pdeHog,y.pdeHog),
    pd=(bzAffineCorrV1(x.pde,y.pde)+1)*.5;
  // Convolution/PDE jointly, no geometry override or absolute confidence.
  const score=.28*ga+.22*chroma+.24*h+.13*ph+.13*pd;
  return {score,ga,chroma,hog:h,pde_hog:ph,pde_correlation:pd};
}
async function bzAffinePrepareV1(env,body){
  const inputKey=String(body.input_key||""),
    base=bzAffineBaseV1(inputKey),
    a=await env.BENCHMARK_R2.get(bzRegionBaseV1(bzRegionImageShaV1(inputKey))+"result.json");
  if(!a)throw new Error("per-object shortlist result missing");
  const original=JSON.parse(await new Response(a.body).text());
  if(original.input_key!==inputKey)throw new Error("mixed screenshot shortlist source");
  const refs=new Map();
  for(let si=0;si<8;si++){
    const key="debug/whole-screen-local-feature-bank-v3/shards/shard-"+String(si).padStart(2,"0")+".json",
      obj=await env.BENCHMARK_R2.get(key);
    if(!obj)throw new Error("canonical shard missing "+si);
    const bank=JSON.parse(await new Response(obj.body).text());
    for(const row of bank.rows)refs.set(row.asset_path,row.source_sha256);
  }
  const regions=[];
  for(const r of original.regions){
    const by=new Map(),sha=bzRegionImageShaV1(inputKey);
    for(let si=0;si<8;si++){
      const key=bzRegionBaseV1(sha)+"rank-shard-"+String(si).padStart(2,"0")+".json",
        obj=await env.BENCHMARK_R2.get(key);
      if(!obj)throw new Error("source shortlist shard missing "+si);
      const shard=JSON.parse(await new Response(obj.body).text()),
        shortlist=shard.regions.find(x=>x.region_id===r.region_id)?.shortlist||[];
      for(const c of shortlist)if(!by.has(c.canonical_visual_asset)||
        by.get(c.canonical_visual_asset).raw_score<c.raw_score)
          by.set(c.canonical_visual_asset,c);
    }
    const ordered=[...by.values()].sort((a,b)=>b.raw_score-a.raw_score);
    const chosen=ordered.slice(0,24);
    // Fair representation from each database segment, not just global highest scores.
    for(let si=0;si<8;si++){
      if(chosen.some(c=>c.shard_index===si))continue;
      const best=ordered.find(c=>c.shard_index===si);
      if(best)chosen.push(best);
    }
    const selected=chosen.slice(0,32).map(c=>({
      canonical_visual_asset:c.canonical_visual_asset,
      source_sha256:refs.get(c.canonical_visual_asset)||null,
      feature_score:c.raw_score,shard_index:c.shard_index
    }));
    regions.push({region_id:r.region_id,bbox:r.bbox,candidates:selected});
  }
  const manifest={schema_version:1,version:"convolution-affine-candidate-manifest-v1",
    input_key:inputKey,catalogue_reference_count:refs.size,
    region_count:regions.length,regions,created_at:new Date().toISOString()};
  await env.BENCHMARK_R2.put(base+"manifest.json",JSON.stringify(manifest),{
    httpMetadata:{contentType:"application/json"}});
  if(body.dispatch!==false){
    if(!env.REGION_QUEUE)throw new Error("dedicated REGION_QUEUE missing");
    await env.REGION_QUEUE.sendBatch(regions.map(reg=>({
      body:{kind:"affine_rerank_region_v1",input_key:inputKey,region_id:reg.region_id,
        output_key:base+"error-"+reg.region_id+".json"}
    })));
  }
  return {region_count:regions.length,manifest_key:base+"manifest.json"};
}
async function bzAffineRerankRegionV1(env,body){
  const inputKey=String(body.input_key||""),base=bzAffineBaseV1(inputKey),
    regionId=String(body.region_id||"");
  const manifestObj=await env.BENCHMARK_R2.get(base+"manifest.json");
  if(!manifestObj)throw new Error("missing comparison manifest");
  const manifest=JSON.parse(await new Response(manifestObj.body).text()),
    region=manifest.regions.find(r=>r.region_id===regionId);
  if(!region||manifest.input_key!==inputKey)throw new Error("invalid region id");
  const image=await env.BENCHMARK_R2.get(inputKey);
  if(!image)throw new Error("screenshot not available");
  const target=await decodePng(await new Response(image.body).arrayBuffer()),
    W=32,H=48,
    targetFeature=bzAffineSummaryV1(bzAffineGridV1(target,region.bbox,W,H),W,H),
    sorted=[],errors=[];
  for(const c of region.candidates){
    if(!/^[a-f0-9]{64}$/.test(c.source_sha256||"")){
      errors.push({name:c.canonical_visual_asset,error:"missing_reference_sha"});continue;
    }
    const ref=await env.BENCHMARK_R2.get("catalogue/item-visual-normalized-v1/"+
      c.source_sha256+".png");
    if(!ref){errors.push({name:c.canonical_visual_asset,error:"missing_normalized_art"});continue;}
    try{
      const png=await decodePng(await new Response(ref.body).arrayBuffer());
      let best=null;
      for(const mode of ["cover","stretch"]){
        for(const shift of mode==="cover"?[-.16,0,.16]:[0]){
          const grid=bzAffineGridV1(png,region.bbox,W,H,mode,shift),
            comp=bzAffineCompareV1(targetFeature,bzAffineSummaryV1(grid,W,H));
          if(!best||comp.score>best.score)best={...comp,mode,shift};
        }
      }
      sorted.push({canonical_visual_asset:c.canonical_visual_asset,feature_score:c.feature_score,
        comparison_score:Number(best.score.toFixed(6)),warp_mode:best.mode,
        cover_shift:best.shift,components:{
          gaussian_correlation:Number(best.ga.toFixed(5)),
          chroma_correlation:Number(best.chroma.toFixed(5)),
          gaussian_hog:Number(best.hog.toFixed(5)),
          pde_hog:Number(best.pde_hog.toFixed(5)),
          pde_correlation:Number(best.pde_correlation.toFixed(5))
        }});
    }catch(e){errors.push({name:c.canonical_visual_asset,error:e instanceof Error?e.message:String(e)});}
  }
  sorted.sort((a,b)=>b.comparison_score-a.comparison_score||
    b.feature_score-a.feature_score);
  const result={schema_version:1,version:"convolution-affine-region-v1",input_key:inputKey,
    region_id:regionId,bbox:region.bbox,total_candidate_count:region.candidates.length,
    successfully_compared:sorted.length,errors,candidates:sorted,
    scoring_semantics:"raw image comparison of 32x48 filtered grids; not probabilities",
    verified_geometry_not_modified:true};
  await env.BENCHMARK_R2.put(base+regionId+".json",JSON.stringify(result),{
    httpMetadata:{contentType:"application/json"}});
  let ready=true;
  for(const r of manifest.regions)if(!await env.BENCHMARK_R2.head(base+r.region_id+".json")){
    ready=false;break;
  }
  if(ready)await bzAffineAggregateV1(env,{input_key:inputKey});
  return {region_id:regionId,compared:sorted.length,top:sorted.slice(0,3)};
}
async function bzAffineAggregateV1(env,body){
  const inputKey=String(body.input_key||""),base=bzAffineBaseV1(inputKey),
    m=await env.BENCHMARK_R2.get(base+"manifest.json");
  if(!m)throw new Error("missing manifest");
  const manifest=JSON.parse(await new Response(m.body).text()),
    originalObj=await env.BENCHMARK_R2.get(bzRegionBaseV1(bzRegionImageShaV1(inputKey))+"result.json"),
    original=JSON.parse(await new Response(originalObj.body).text()),regions=[];
  for(const r of manifest.regions){
    const x=await env.BENCHMARK_R2.get(base+r.region_id+".json");
    if(!x)throw new Error("missing region "+r.region_id);
    const v=JSON.parse(await new Response(x.body).text()),
      old=original.regions.find(q=>q.region_id===r.region_id);
    const verified=old?.verified||null;
    regions.push({region_id:r.region_id,bbox:r.bbox,verified,
      old_top1:old?.top_candidates?.[0]?.canonical_visual_asset||null,
      new_top1:v.candidates[0]?.canonical_visual_asset||null,
      top_candidates:v.candidates.slice(0,6),compared:v.successfully_compared,
      errors:v.errors});
  }
  const artifact={schema_version:1,version:"convolution-affine-candidate-sets-v1",
    input_key:inputKey,width:original.width,height:original.height,
    region_count:regions.length,regions,
    metrics:{candidates_compared:regions.reduce((s,r)=>s+r.compared,0),
      failed_reference_decodes:regions.reduce((s,r)=>s+r.errors.length,0),
      old_verified_hits:original.verified_region_count},
    evaluation_requirement:"Compare against independent human truth: do not infer correctness for unknown card IDs.",
    scoring_semantics:"Gaussian color/edge plus anisotropic-diffusion HOG under center-crop and nonuniform stretch. Scores are not probabilities.",
    generated_at:new Date().toISOString()};
  await env.BENCHMARK_R2.put(base+"result.json",JSON.stringify(artifact),{
    httpMetadata:{contentType:"application/json"}});
  return {result_key:base+"result.json",region_count:regions.length};
}



// Full-catalogue convolution/PDE discovery using pre-existing 16x16 RGB artwork.
// No neural model, no source-image downloads for first pass, and no ground truth labels.
// This tests whether weak binary shortlist retrieval was losing true candidates.
function bzFullConvBaseV1(inputKey){
  return "debug/region-fullcatalog-convolution-v1/"+bzRegionImageShaV1(inputKey)+"/";
}
function bzFullConvColorDistanceV1(target,ref){
  const n=Math.min(target.length,ref.length),aa=new Float32Array(n),bb=new Float32Array(n);
  let dif=0;
  for(let i=0;i<n;i++){aa[i]=target[i];bb[i]=ref[i]/255;dif+=Math.abs(aa[i]-bb[i]);}
  const mean=dif/n;
  return .55*(1-bzAffineClampV1(mean*1.25,0,1))+
    .45*(bzAffineCorrV1(aa,bb)+1)*.5;
}
async function bzFullConvRegionV1(env,body){
  const inputKey=String(body.input_key||""),
    sha=bzRegionImageShaV1(inputKey),base=bzFullConvBaseV1(inputKey),
    id=String(body.region_id||"");
  const data=await env.BENCHMARK_R2.get(bzRegionBaseV1(sha)+"regions.json");
  if(!data)throw new Error("missing card-region proposals");
  const loc=JSON.parse(await new Response(data.body).text()),
    r=loc.regions.find(a=>a.region_id===id);
  if(!r)throw new Error("invalid region id");
  const loaded=await loadProofInputs(env,inputKey),refs=loaded.refs;
  if(refs.length<1300)throw new Error("unexpectedly incomplete catalogue");
  // Stage A: inexpensive 4x4 color comparison across all 1483 references.
  const target4=bzAffineGridV1(loaded.image,r.bbox,4,4,"target"),
    coarse=[];
  for(const ref of refs){
    if(!ref.rgb4||ref.rgb4.length!==48)continue;
    coarse.push({ref,score:bzFullConvColorDistanceV1(target4,ref.rgb4)});
  }
  coarse.sort((a,b)=>b.score-a.score);
  const selected=coarse.slice(0,48);
  // Also preserve reference candidates already found by the region-first matcher;
  // not truth-dependent, and allows direct comparison with its previous output.
  const old=await env.BENCHMARK_R2.get(bzRegionBaseV1(sha)+"result.json");
  if(old){
    const rows=JSON.parse(await new Response(old.body).text())
      .regions.find(x=>x.region_id===id)?.top_candidates||[];
    for(const row of rows){
      const ref=refs.find(x=>x.asset_path===row.canonical_visual_asset);
      if(ref&&!selected.some(q=>q.ref.asset_path===ref.asset_path))selected.push({
        ref,score:null,source:"earlier_region_shortlist"
      });
    }
  }
  // Stage B: expensive Gaussian/anisotropic-diffusion convolution on only
  // 48-54 candidates. No download of full reference PNGs is required here.
  const W=16,H=16,target=bzAffineSummaryV1(
      bzAffineGridV1(loaded.image,r.bbox,W,H,"target"),W,H),
    ranking=[],errors=[];
  for(const entry of selected){
    const ref=entry.ref,b=ref.rgb16;
    if(!b||b.length!==W*H*3){
      errors.push({asset:ref.asset_path,error:"invalid_rgb16"});continue;
    }
    const rgba=new Uint8Array(W*H*4);
    for(let p=0;p<W*H;p++){
      rgba[p*4]=b[p*3];rgba[p*4+1]=b[p*3+1];
      rgba[p*4+2]=b[p*3+2];rgba[p*4+3]=255;
    }
    const art={width:W,height:H,rgba};
    let best=null;
    for(const [mode,shift] of [["cover",0],["cover",-.16],["cover",.16],["stretch",0]]){
      const f=bzAffineSummaryV1(
        bzAffineGridV1(art,r.bbox,W,H,mode,shift),W,H),
        comp=bzAffineCompareV1(target,f);
      if(!best||comp.score>best.score)best={
        score:comp.score,mode,shift,gaussian_hog:comp.hog,pde_hog:comp.pde_hog
      };
    }
    ranking.push({canonical_visual_asset:ref.asset_path,
      source_sha256:ref.source_sha256,
      score:Number(best.score.toFixed(6)),mode:best.mode,shift:best.shift,
      coarse_color_score:entry.score===null?null:Number(entry.score.toFixed(5)),
      source:entry.source||"full_catalogue_coarse",
      gaussian_hog:Number(best.gaussian_hog.toFixed(5)),
      pde_hog:Number(best.pde_hog.toFixed(5))});
  }
  ranking.sort((a,b)=>b.score-a.score||a.canonical_visual_asset.localeCompare(b.canonical_visual_asset));
  const result={schema_version:2,version:"region-fullcatalog-convolution-prefilter-v2",
    input_key:inputKey,region_id:id,bbox:r.bbox,
    reference_count:refs.length,coarse_count:coarse.length,
    compared:ranking.length,errors,top:ranking.slice(0,48),
    coarse_top:coarse.slice(0,64).map(q=>[q.ref.asset_path,Number(q.score.toFixed(6))]),
    score_semantics:"4x4 full-corpus color sweep, then 16x16 Gaussian/PDE comparison; not probabilities",
    no_label_leakage:true};
  await env.BENCHMARK_R2.put(base+id+".json",JSON.stringify(result),{
    httpMetadata:{contentType:"application/json"}});
  let complete=true;
  for(const x of loc.regions)if(!await env.BENCHMARK_R2.head(base+x.region_id+".json")){
    complete=false;break;
  }
  if(complete)await bzFullConvAggregateV1(env,{input_key:inputKey});
  return {region_id:id,coarse_count:coarse.length,compared:ranking.length,top:ranking.slice(0,5)};
}
async function bzFullConvAggregateV1(env,body){
  const inputKey=String(body.input_key||""),sha=bzRegionImageShaV1(inputKey),
    base=bzFullConvBaseV1(inputKey),
    v=await env.BENCHMARK_R2.get(bzRegionBaseV1(sha)+"regions.json");
  if(!v)throw new Error("localization missing");
  const loc=JSON.parse(await new Response(v.body).text()),regions=[];
  for(const r of loc.regions){
    const o=await env.BENCHMARK_R2.get(base+r.region_id+".json");
    if(!o)throw new Error("missing convolution full-catalogue output "+r.region_id);
    const row=JSON.parse(await new Response(o.body).text());
    regions.push({region_id:r.region_id,bbox:r.bbox,compared:row.compared,
      ranked_top:row.top.slice(0,24),full_score_artifact:base+r.region_id+".json",
      errors:row.errors});
  }
  const result={schema_version:1,version:"region-fullcatalog-convolution-v1",
    input_key:inputKey,regions,region_count:regions.length,
    total_comparisons:regions.reduce((n,r)=>n+r.compared,0),
    candidate_universe:loc.regions.length?1483:null,
    coarse_reference_comparisons:regions.reduce((n,r)=>n+(r.coarse_count||1483),0),
    detailed_reference_comparisons:regions.reduce((n,r)=>n+r.compared,0),
    warning:"Low-resolution full-catalogue retrieval. Candidate ranks do not imply calibrated likelihood or accepted identity.",
    generated_at:new Date().toISOString()};
  await env.BENCHMARK_R2.put(base+"result.json",JSON.stringify(result),{
    httpMetadata:{contentType:"application/json"}});
  return {result_key:base+"result.json",regions:regions.length,
    comparisons:result.total_comparisons};
}



// Full-catalogue region-first workflow. Works on any immutable screenshot in R2.
// Idempotent stage orchestration; labels/ground truth never enter the image pipeline.
async function bzFullcatalogStartV2(env,body){
  const inputKey=String(body.input_key||""),
    sha=bzRegionImageShaV1(inputKey),
    base=bzFullConvBaseV1(inputKey),
    locKey=bzRegionBaseV1(sha)+"regions.json";
  const source=await env.BENCHMARK_R2.head(inputKey);
  if(!source)throw new Error("screenshot_missing");
  let loc=await env.BENCHMARK_R2.get(locKey);
  let localization_action="reused";
  if(!loc||body.relocalize===true){
    // Don't dispatch BRIEF jobs here. This workflow starts with all-card
    // full-catalogue retrieval, independent of the earlier weak shortlist.
    await bzLocalizeRegionsV1(env,{input_key:inputKey,dispatch:false});
    loc=await env.BENCHMARK_R2.get(locKey);
    localization_action="created";
  }
  if(!loc)throw new Error("localization_failed");
  const l=JSON.parse(await new Response(loc.body).text());
  if(l.input_key!==inputKey||!Array.isArray(l.regions))throw new Error("localization_input_mismatch");
  if(l.regions.length===0)throw new Error("no_card_regions_detected");
  if(l.regions.length>36)throw new Error("too_many_card_regions");
  const pending=[],finished=[],errors=[];
  for(const region of l.regions){
    const id=region.region_id;
    if(!/^region-\d{2}$/.test(id))throw new Error("invalid_region_id");
    const out=base+id+".json",o=await env.BENCHMARK_R2.get(out);
    if(o){
      const v=JSON.parse(await new Response(o.body).text());
      if(v.input_key===inputKey&&v.region_id===id&&v.compared>0){
        finished.push(id);continue;
      }
    }
    const err=base+"error-"+id+".json",e=await env.BENCHMARK_R2.get(err);
    if(e){
      const d=JSON.parse(await new Response(e.body).text());
      errors.push({region_id:id,error:d.error||"unclassified_error"});
    }
    pending.push({id,out,err});
  }
  let queue_state="not_required";
  if(pending.length){
    if(!env.REGION_QUEUE)throw new Error("REGION_QUEUE binding missing");
    // Existing invalid jobs are safe to retry. Failed prior shards stay
    // isolated; never depend on queue backlog count for completion.
    for(let i=0;i<pending.length;i+=50){
      await env.REGION_QUEUE.sendBatch(pending.slice(i,i+50).map(p=>({
        body:{kind:"fullconv_region_v1",input_key:inputKey,
          region_id:p.id,output_key:p.err}
      })));
    }
    queue_state="submitted";
  }else{
    const aggregate=await env.BENCHMARK_R2.head(base+"result.json");
    if(!aggregate){
      await bzFullConvAggregateV1(env,{input_key:inputKey});
      queue_state="aggregated";
    }
  }
  const info={schema_version:2,workflow:"fullcatalog_region_first_v2",
    input_key:inputKey,sha256:sha,localization_action,
    region_count:l.regions.length,queued_count:pending.length,
    completed_count:finished.length,known_failure_count:errors.length,
    prior_errors:errors,queue_state,
    region_prefix:base,result_key:base+"result.json",
    probability_calibrated:false,geometry_acceptance_unchanged:true,
    report_generated_at:new Date().toISOString()};
  await env.BENCHMARK_R2.put(base+"workflow-latest.json",JSON.stringify(info),{
    httpMetadata:{contentType:"application/json"}});
  return info;
}
async function bzFullcatalogStatusV2(env,inputKey){
  const sha=bzRegionImageShaV1(inputKey),base=bzFullConvBaseV1(inputKey),
    localization=await env.BENCHMARK_R2.get(bzRegionBaseV1(sha)+"regions.json");
  if(!localization)return {status:"localization_pending",regions:[],complete:false};
  const loc=JSON.parse(await new Response(localization.body).text()),regions=[];
  for(const r of loc.regions){
    const id=r.region_id,out=await env.BENCHMARK_R2.get(base+id+".json");
    if(out){
      const a=JSON.parse(await new Response(out.body).text());
      if(a.input_key===inputKey&&a.compared>0){
        regions.push({region_id:id,bbox:r.bbox,status:"ranked",
          candidate_count:a.compared,
          top:a.top.slice(0,6).map((x,i)=>({
            rank:i+1,canonical_visual_asset:x.canonical_visual_asset,
            similarity_score:x.score,verification:"unverified_by_this_stage"
          }))});
        continue;
      }
    }
    const e=await env.BENCHMARK_R2.get(base+"error-"+id+".json");
    let error=null;
    if(e)error=JSON.parse(await new Response(e.body).text()).error||"failed";
    regions.push({region_id:id,bbox:r.bbox,status:error?"failed":"pending",
      ...(error?{error}:{})});
  }
  const complete=regions.length>0&&regions.every(r=>r.status==="ranked"),
    ready=await env.BENCHMARK_R2.get(base+"result.json");
  const result=ready?JSON.parse(await new Response(ready.body).text()):null;
  return {status:complete?"ranked":regions.some(r=>r.status==="failed")?"partial_failure":"processing",
    input_key:inputKey,region_count:regions.length,
    ranked_count:regions.filter(x=>x.status==="ranked").length,
    failed_count:regions.filter(x=>x.status==="failed").length,
    complete,aggregate_ready:!!result,regions,
    note:"Similarity scores and top guesses are not calibrated probabilities or independently verified identities.",
    result_key:base+"result.json"};
}



async function bzFullcatalogStatusSnapshotV2(env,body){
  const inputKey=String(body.input_key||""),
    sha=bzRegionImageShaV1(inputKey),
    out=String(body.output_key||
      bzFullConvBaseV1(inputKey)+"status-snapshot.json");
  if(!out.startsWith("debug/")||!out.endsWith(".json"))
    throw new Error("invalid output path");
  const status=await bzFullcatalogStatusV2(env,inputKey);
  const doc={schema_version:2,workflow:"fullcatalog_region_first_v2",
    sha256:sha,generated_at:new Date().toISOString(),...status};
  await env.BENCHMARK_R2.put(out,JSON.stringify(doc),{
    httpMetadata:{contentType:"application/json"}});
  return {key:out,region_count:doc.region_count,
    ranked_count:doc.ranked_count,aggregate_ready:doc.aggregate_ready};
}

export default {
  async fetch(request,env){const u=new URL(request.url);
    if(request.method==="POST"&&u.pathname==="/api/experimental/screenshots")
      return bzScreenshotUploadV1(request,env);
    const pictureMatch=/^\/api\/experimental\/screenshots\/([a-f0-9]{64})\/results$/.exec(u.pathname);
