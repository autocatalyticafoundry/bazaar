  return result;
}

async function runChunkTile(env,body){
  const inputKey=String(body.input_key||""),outputKey=String(body.output_key||""),hi=Math.max(0,Math.min(6,Number(body.hf_index)||0)),ai=Math.max(0,Math.min(6,Number(body.ar_index)||0)),tileCount=Math.max(1,Math.min(8,Number(body.tile_count)||4)),tileIndex=Math.max(0,Math.min(tileCount-1,Number(body.tile_index)||0));
  const {png,image,refs}=await loadProofInputs(env,inputKey),hfs=[0.075,0.10,0.135,0.18,0.24,0.32,0.40],ars=[0.52,0.62,0.72,0.82,0.94,1.08,1.24],minDim=Math.min(image.width,image.height),height=Math.max(72,Math.round(minDim*hfs[hi])),ar=ars[ai],width=Math.max(48,Math.round(height*ar));
  if(width>=image.width||height>=image.height)throw new Error("tile geometry outside source");
  const xs=positions(image.width-width,Math.max(34,Math.round(width*0.76))),ys=positions(image.height-height,Math.max(42,Math.round(height*0.66))),pairs=[];let globalIndex=0,windows=0;
  for(const y of ys)for(const x of xs){const use=(globalIndex%tileCount)===tileIndex;globalIndex++;if(!use)continue;const bbox={x,y,width,height},rgb4=sampleGrid(image,bbox,4),m=meanRgb(rgb4),color=[];
    for(const ref of refs){const d=(Math.abs(m[0]-ref.mean[0])+Math.abs(m[1]-ref.mean[1])+Math.abs(m[2]-ref.mean[2]))/(3*255);if(color.length<72){color.push({ref,d});if(color.length===72)color.sort((a,b)=>a.d-b.d);}else if(d<color[71].d){color[71]={ref,d};color.sort((a,b)=>a.d-b.d);}}
    const top=color.map(({ref,d})=>({ref,coarse:mae(rgb4,ref.rgb4)*0.88+d*0.12})).sort((a,b)=>a.coarse-b.coarse).slice(0,8);for(const t of top)pairs.push({bbox,asset_path:t.ref.asset_path,display_name:t.ref.display_name,render_mode:t.ref.render_mode,coarse_score:t.coarse});windows++;
  }
  pairs.sort((a,b)=>a.coarse_score-b.coarse_score);const refByPath=new Map(refs.map(r=>[r.asset_path,r])),cache=new Map(),exact=[];
  for(const p of pairs.slice(0,360)){const key=[p.bbox.x,p.bbox.y,p.bbox.width,p.bbox.height].join(",");let s=cache.get(key);if(!s){s=sampleGrid(image,p.bbox,16);cache.set(key,s);}const ref=refByPath.get(p.asset_path);if(!ref)continue;exact.push({...p,...structuralScore(s,ref.rgb16)});}
  exact.sort((a,b)=>a.score-b.score);const artifact={schema_version:1,proof_version:"whole-screen-canonical-fingerprint-v2-tile",generated_at:new Date().toISOString(),input_key:inputKey,source_dimensions:{width:image.width,height:image.height},prior_region_proposals_used:false,prior_item_router_used:false,item_reference_count:refs.length,hf_index:hi,ar_index:ai,tile_index:tileIndex,tile_count:tileCount,height_fraction:hfs[hi],aspect_ratio:ar,window_size:{width,height},searched_window_count:windows,total_grid_windows:xs.length*ys.length,exact_candidates:exact.slice(0,120)};
  await env.BENCHMARK_R2.put(outputKey,JSON.stringify(artifact),{httpMetadata:{contentType:"application/json"},customMetadata:{artifact:"whole-screen-canonical-fingerprint-v2-tile",hf_index:String(hi),ar_index:String(ai),tile_index:String(tileIndex),tile_count:String(tileCount),window_count:String(windows),candidate_count:String(artifact.exact_candidates.length)}});
  return artifact;
}
async function mergeChunkTiles(env,body){
  const base=String(body.tile_base_key||""),outputKey=String(body.output_key||""),hi=Number(body.hf_index),ai=Number(body.ar_index),tileCount=Math.max(1,Math.min(8,Number(body.tile_count)||4));const all=[];let windows=0,sourceDimensions=null,itemReferenceCount=null;
  for(let t=0;t<tileCount;t++){const obj=await env.BENCHMARK_R2.get(base+"/tile-"+hi+"-"+ai+"-"+t+".json");if(!obj)throw new Error("tile missing "+hi+","+ai+","+t);const row=JSON.parse(await new Response(obj.body).text());windows+=Number(row.searched_window_count||0);sourceDimensions??=row.source_dimensions;itemReferenceCount??=row.item_reference_count;for(const c of row.exact_candidates||[])all.push(c);}
  all.sort((a,b)=>a.score-b.score);const artifact={schema_version:1,proof_version:"whole-screen-canonical-fingerprint-v2-merged",generated_at:new Date().toISOString(),prior_region_proposals_used:false,prior_item_router_used:false,item_reference_count:itemReferenceCount,hf_index:hi,ar_index:ai,source_dimensions:sourceDimensions,searched_window_count:windows,exact_candidates:all.slice(0,120)};
  await env.BENCHMARK_R2.put(outputKey,JSON.stringify(artifact),{httpMetadata:{contentType:"application/json"},customMetadata:{artifact:"whole-screen-canonical-fingerprint-v2-merged",hf_index:String(hi),ar_index:String(ai),window_count:String(windows),candidate_count:String(artifact.exact_candidates.length),tile_count:String(tileCount)}});
  return artifact;
}

function centerMatch2(a,b){
  const acx=a.x+a.width/2,acy=a.y+a.height/2,bcx=b.x+b.width/2,bcy=b.y+b.height/2;
  const dx=Math.abs(acx-bcx)/Math.max(1,Math.min(a.width,b.width)),dy=Math.abs(acy-bcy)/Math.max(1,Math.min(a.height,b.height));
  return iou(a,b)>=0.22 || (dx<=0.42 && dy<=0.38);
}
async function reduceChunkForClusters(env,body){
  const chunkKey=String(body.chunk_key||""),out=String(body.output_key||"");const obj=await env.BENCHMARK_R2.get(chunkKey);if(!obj)throw new Error("chunk missing");const row=JSON.parse(await new Response(obj.body).text()),groups=new Map();
  for(const c of row.exact_candidates||[]){const k=[c.bbox.x,c.bbox.y,c.bbox.width,c.bbox.height].join(",");if(!groups.has(k))groups.set(k,{bbox:c.bbox,candidates:[]});groups.get(k).candidates.push(c);}
