function glEstimatePairs(inputPairs){const pairs=[...inputPairs].sort((a,b)=>a.distance-b.distance).slice(0,48);if(pairs.length<4)return {pair_count:pairs.length,transform:null};let best=null;for(let i=0;i<pairs.length-1;i++)for(let j=i+1;j<pairs.length;j++){const t=lgFromTwo(pairs[i],pairs[j]);if(!t)continue;const ins=pairs.filter(p=>lgResidual(t,p)<=5);if(ins.length<4)continue;const mr=ins.reduce((s,p)=>s+lgResidual(t,p),0)/ins.length,mh=ins.reduce((s,p)=>s+p.distance,0)/ins.length;if(!best||ins.length>best.inliers.length||(ins.length===best.inliers.length&&mr<best.mean_residual)||(ins.length===best.inliers.length&&mr===best.mean_residual&&mh<best.mean_hamming))best={transform:t,inliers:ins,mean_residual:mr,mean_hamming:mh};}if(!best)return {pair_count:pairs.length,transform:null};const t=lgRefine(best.inliers)||best.transform;if(t.scale<0.45||t.scale>1.8||Math.abs(t.rotation_deg)>26)return {pair_count:pairs.length,transform:null};const ins=pairs.filter(p=>lgResidual(t,p)<=5);if(ins.length<4)return {pair_count:pairs.length,transform:null};return {pair_count:pairs.length,transform:{...t,inlier_count:ins.length,mean_residual:ins.reduce((s,p)=>s+lgResidual(t,p),0)/ins.length,mean_hamming:ins.reduce((s,p)=>s+p.distance,0)/ins.length}};}
function glTile(i){const xs=[0,300,600,900,1200,1448],ys=[0,300,600,809],t=[];for(const y of ys)for(const x of xs)t.push({x,y,width:600,height:600});return t[Math.max(0,Math.min(23,i))];}
function lgExtractSpatialFastGridCellwise(data,w,h,cols=12,rows=8,perCell=40,scanStep=3,descriptorScale=1){const n=w*h,gray=new Float32Array(n),gx=new Float32Array(n),gy=new Float32Array(n);for(let p=0;p<n;p++){const i=p*4;gray[p]=lgGray(data[i],data[i+1],data[i+2]);}for(let y=1;y<h-1;y++)for(let x=1;x<w-1;x++){const p=y*w+x;gx[p]=gray[p+1]-gray[p-1];gy[p]=gray[p+w]-gray[p-w];}const selected=[];for(let cy=0;cy<rows;cy++)for(let cx=0;cx<cols;cx++){const x0=Math.max(10,Math.floor(cx*w/cols)),x1=Math.min(w-10,Math.floor((cx+1)*w/cols)),y0=Math.max(10,Math.floor(cy*h/rows)),y1=Math.min(h-10,Math.floor((cy+1)*h/rows)),c=[];let strongest=0;for(let y=y0;y<y1;y+=scanStep)for(let x=x0;x<x1;x+=scanStep){let xx=0,yy=0,xy=0;for(let dy=-1;dy<=1;dy++)for(let dx=-1;dx<=1;dx++){const p=(y+dy)*w+x+dx,ix=gx[p],iy=gy[p];xx+=ix*ix;yy+=iy*iy;xy+=ix*iy;}const tr=xx+yy,score=xx*yy-xy*xy-0.04*tr*tr;if(score>0){c.push({x,y,score});if(score>strongest)strongest=score;}}c.sort((a,b)=>b.score-a.score||a.y-b.y||a.x-b.x);const local=[];for(const p of c){if(local.length>=perCell)break;if(strongest>0&&p.score<strongest*0.006)break;if(local.some(q=>{const dx=p.x-q.x,dy=p.y-q.y;return dx*dx+dy*dy<25;}))continue;local.push(p);}selected.push(...local);}return selected.map(p=>{const d=new Uint8Array(16);for(let bit=0;bit<128;bit++){const [ax0,ay0,bx0,by0]=lgBriefPair(bit),ax=Math.round(ax0*descriptorScale),ay=Math.round(ay0*descriptorScale),bx=Math.round(bx0*descriptorScale),by=Math.round(by0*descriptorScale);if(lgPatchMean(gray,w,h,p.x+ax,p.y+ay)<lgPatchMean(gray,w,h,p.x+bx,p.y+by))d[bit>>>3]|=1<<(bit&7);}return {x:p.x,y:p.y,descriptor:d};});}
function lgExtractSpatialFastGrid(data,w,h,cols=16,rows=12,perCell=32,scanStep=2,descriptorScale=1){const n=w*h,gray=new Float32Array(n),gx=new Float32Array(n),gy=new Float32Array(n);for(let p=0;p<n;p++){const i=p*4;gray[p]=lgGray(data[i],data[i+1],data[i+2]);}for(let y=1;y<h-1;y++)for(let x=1;x<w-1;x++){const p=y*w+x;gx[p]=gray[p+1]-gray[p-1];gy[p]=gray[p+w]-gray[p-w];}const cells=Array.from({length:cols*rows},()=>({c:[],strongest:0}));for(let y=10;y<h-10;y+=scanStep)for(let x=10;x<w-10;x+=scanStep){let xx=0,yy=0,xy=0;for(let dy=-1;dy<=1;dy++)for(let dx=-1;dx<=1;dx++){const p=(y+dy)*w+x+dx,ix=gx[p],iy=gy[p];xx+=ix*ix;yy+=iy*iy;xy+=ix*iy;}const tr=xx+yy,score=xx*yy-xy*xy-0.04*tr*tr;if(score<=0)continue;const cx=Math.min(cols-1,Math.floor(x*cols/w)),cy=Math.min(rows-1,Math.floor(y*rows/h)),cell=cells[cy*cols+cx];cell.c.push({x,y,score});if(score>cell.strongest)cell.strongest=score;}const selected=[];for(const cell of cells){cell.c.sort((a,b)=>b.score-a.score||a.y-b.y||a.x-b.x);const local=[];for(const p of cell.c){if(local.length>=perCell)break;if(cell.strongest>0&&p.score<cell.strongest*0.006)break;if(local.some(q=>{const dx=p.x-q.x,dy=p.y-q.y;return dx*dx+dy*dy<25;}))continue;local.push(p);}selected.push(...local);}return selected.map(p=>{const d=new Uint8Array(16);for(let bit=0;bit<128;bit++){const [ax0,ay0,bx0,by0]=lgBriefPair(bit),ax=Math.round(ax0*descriptorScale),ay=Math.round(ay0*descriptorScale),bx=Math.round(bx0*descriptorScale),by=Math.round(by0*descriptorScale);if(lgPatchMean(gray,w,h,p.x+ax,p.y+ay)<lgPatchMean(gray,w,h,p.x+bx,p.y+by))d[bit>>>3]|=1<<(bit&7);}return {x:p.x,y:p.y,descriptor:d};});}
function lgExtractSpatialFast(data,w,h,perCell=80,scanStep=2){const n=w*h,gray=new Float32Array(n),gx=new Float32Array(n),gy=new Float32Array(n);for(let p=0;p<n;p++){const i=p*4;gray[p]=lgGray(data[i],data[i+1],data[i+2]);}for(let y=1;y<h-1;y++)for(let x=1;x<w-1;x++){const p=y*w+x;gx[p]=gray[p+1]-gray[p-1];gy[p]=gray[p+w]-gray[p-w];}const cells=Array.from({length:9},()=>({c:[],strongest:0}));for(let y=10;y<h-10;y+=scanStep)for(let x=10;x<w-10;x+=scanStep){let xx=0,yy=0,xy=0;for(let dy=-1;dy<=1;dy++)for(let dx=-1;dx<=1;dx++){const p=(y+dy)*w+x+dx,ix=gx[p],iy=gy[p];xx+=ix*ix;yy+=iy*iy;xy+=ix*iy;}const tr=xx+yy,score=xx*yy-xy*xy-0.04*tr*tr;if(score<=0)continue;const cx=Math.min(2,Math.floor(x*3/w)),cy=Math.min(2,Math.floor(y*3/h)),cell=cells[cy*3+cx];cell.c.push({x,y,score});if(score>cell.strongest)cell.strongest=score;}const selected=[];for(const cell of cells){cell.c.sort((a,b)=>b.score-a.score||a.y-b.y||a.x-b.x);const local=[];for(const p of cell.c){if(local.length>=perCell)break;if(cell.strongest>0&&p.score<cell.strongest*0.006)break;if(local.some(q=>{const dx=p.x-q.x,dy=p.y-q.y;return dx*dx+dy*dy<25;}))continue;local.push(p);}selected.push(...local);}return selected.map(p=>{const d=new Uint8Array(16);for(let bit=0;bit<128;bit++){const [ax,ay,bx,by]=lgBriefPair(bit);if(lgPatchMean(gray,w,h,p.x+ax,p.y+ay)<lgPatchMean(gray,w,h,p.x+bx,p.y+by))d[bit>>>3]|=1<<(bit&7);}return {x:p.x,y:p.y,descriptor:d};});}
function lgExtractSpatial(data,w,h,perCell=80,scanStep=2){const out=[],cols=3,rows=3;for(let gy=0;gy<rows;gy++)for(let gx=0;gx<cols;gx++){const x0=Math.floor(gx*w/cols),x1=Math.floor((gx+1)*w/cols),y0=Math.floor(gy*h/rows),y1=Math.floor((gy+1)*h/rows),cw=x1-x0,ch=y1-y0,sub=new Uint8ClampedArray(cw*ch*4);for(let yy=0;yy<ch;yy++){const si=((y0+yy)*w+x0)*4;sub.set(data.subarray(si,si+cw*4),yy*cw*4);}const f=lgExtract(sub,cw,ch,perCell,false,scanStep,false,descriptorScale);for(const p of f)out.push({x:p.x+x0,y:p.y+y0,descriptor:p.descriptor});}return out;}
function lgResizeNearest(data,w,h,s){s=Math.max(.5,Math.min(2,Number(s)||1));const nw=Math.max(24,Math.round(w*s)),nh=Math.max(24,Math.round(h*s)),out=new Uint8ClampedArray(nw*nh*4);for(let y=0;y<nh;y++){const sy=Math.min(h-1,Math.floor(y/s));for(let x=0;x<nw;x++){const sx=Math.min(w-1,Math.floor(x/s)),si=(sy*w+sx)*4,di=(y*nw+x)*4;out[di]=data[si];out[di+1]=data[si+1];out[di+2]=data[si+2];out[di+3]=data[si+3];}}return {data:out,width:nw,height:nh};}
