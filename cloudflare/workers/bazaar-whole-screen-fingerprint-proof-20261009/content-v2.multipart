  summarized.sort((a,b)=>b.cluster_score-a.cluster_score||a.best_score-b.best_score);const result={schema_version:1,proof_version:"whole-screen-reference-proof-v4-clusters",generated_at:new Date().toISOString(),prior_region_proposals_used:false,prior_item_router_used:false,reduced_chunk_count:reducedCount,total_windows:totalWindows,input_proposal_count:proposals.length,cluster_count:summarized.length,clusters:summarized.slice(0,80)};
