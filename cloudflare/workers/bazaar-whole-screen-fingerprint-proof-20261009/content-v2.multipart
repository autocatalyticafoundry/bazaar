  await env.BENCHMARK_R2.put(outputKey,JSON.stringify(artifact),{httpMetadata:{contentType:"application/json"},customMetadata:{artifact:"whole-screen-canonical-fingerprint-v2-chunk",hf_index:String(hi),ar_index:String(ai),window_count:String(windows),candidate_count:String(artifact.exact_candidates.length)}});
  return artifact;
