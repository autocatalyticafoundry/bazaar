function rnCrc32(parts){let c=0xffffffff;for(const part of parts)for(let i=0;i<part.length;i++){c^=part[i];for(let k=0;k<8;k++)c=(c>>>1)^((c&1)?0xedb88320:0);}return (c^0xffffffff)>>>0;}
