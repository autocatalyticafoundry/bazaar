    else if (colorType===2) { rgba[r]=scan[q]; rgba[r+1]=scan[q+1]; rgba[r+2]=scan[q+2]; rgba[r+3]=255; }
    else if (colorType===4) { rgba[r]=rgba[r+1]=rgba[r+2]=scan[q]; rgba[r+3]=scan[q+1]; }
    else { rgba[r]=rgba[r+1]=rgba[r+2]=scan[q]; rgba[r+3]=255; }
