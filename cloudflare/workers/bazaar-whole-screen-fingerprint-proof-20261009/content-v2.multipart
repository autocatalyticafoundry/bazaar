v,body);} else if(body.kind==="global_tile_allshards"){await glRunTileAllShards(env,body);} else if(body.kind==="control_v2"){await lgControlV2(env,body);} else if(body.kind==="local_feature_bank_find"){await lgFindBankReference(env,body);} else if(body.kind==="local_feature_bank_aggregate_hybrid"){await lgAggregateBankHybrid(env,body);} else if(body.kind==="local_feature_bank_manifest"){await lgBankManifest(env,body);} else if(body.kind==="local_feature_bank_batch"){await lgBuildBankBatch(env,body);} else if(body.kind==="local_feature_bank_aggregate"){await lgAggregateBank(env,body);} else if(body.kind==="local_feature_bank_scan_tile"){await lgScanBankTile(env,body);} else if(body.kind==="local_geometry_tile"){await localGeometryTile(env,body);} else if(body.kind==="ref_info"){await inspectReferenceInfo(env,body);} else if(body.kind==="inspect_clusters"){await inspectClusterProof(env,body);} else if(body.kind==="reduce_chunk"){await reduceChunkForClusters(env,body);} else if(body.kind==="aggregate_reduced"){await aggregateReducedClusters(env,body);} else if(body.kind==="scan_chunk_tile"){await runChunkTile(env,body);} else if(body.kind==="merge_chunk_tiles"){await mergeChunkTiles(env,body);} else if(body.kind==="nearby_candidates"){await nearbyCandidatesJob(env,body);} else if(body.kind==="verify_one_ref"){await verifyOneReferenceJob(env,body);} else if(body.kind==="verify_discovered"){await verifyDiscoveredBox(env,body);} else if(body.kind==="evaluate_chunk"){await evaluateOneChunk(env,body);} else if(body.kind==="evaluate_existing"){await evaluateExistingChunks(env,body);} else if(body.kind==="diagnostic_chunk"){await runDiagnosticChunk(env,body);} else if(body.kind==="diagnostic"){if(body.mode==="r1"){const r=await glFullShardRarePacked(env,body.shard_index,body.scale||1),out=String(body.output_key||("debug/r1-"+String(body.shard_index)+".json"));await env.BENCHMARK_R2.put(out,JSON.stringify(r),{httpMetadata:{contentType:"application/json"},customMetadata:{artif