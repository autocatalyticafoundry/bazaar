function lgGray(r,g,b){return r*0.299+g*0.587+b*0.114;}
function lgPatchMean(gray,w,h,x,y){let sum=0,n=0;for(let dy=-1;dy<=1;dy++){const yy=Math.max(0,Math.min(h-1,y+dy));for(let dx=-1;dx<=1;dx++){const xx=Math.max(0,Math.min(w-1,x+dx));sum+=gray[yy*w+xx];n++;}}return sum/n;}
function lgBriefPair(bit){let ax=(bit*37+3)%17-8,ay=(bit*53+5)%17-8,bx=(bit*61+11)%17-8,by=(bit*29+13)%17-8;if(ax===bx&&ay===by)bx=bx===8?-8:bx+1;if(ax===0&&ay===0)ax=-3;if(bx===0&&by===0)by=4;return [ax,ay,bx,by];}
function lgExtract(data,w,h,maxPoints=320,alphaAware=false,scanStep=1,balanced=false,descriptorScale=1){
  const n=w*h,gray=new Float32Array(n),alpha=alphaAware?new Float32Array(n):null;
  for(let p=0;p<n;p++){const i=p*4;gray[p]=lgGray(data[i],data[i+1],data[i+2]);if(alpha)alpha[p]=data[i+3]/255;}
  const gx=new Float32Array(n),gy=new Float32Array(n);
  for(let y=1;y<h-1;y++)for(let x=1;x<w-1;x++){const p=y*w+x;gx[p]=gray[p+1]-gray[p-1];gy[p]=gray[p+w]-gray[p-w];}
  const c=[];let strongest=0;
