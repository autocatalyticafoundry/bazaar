const svDenseRefCache=new Map();
async function svDenseRef32(env,sha){if(svDenseRefCache.has(sha))return svDenseRefCache.get(sha);const p=(async()=>{const obj=await env.BENCHMARK_R2.get("catalogue/item-visual-normalized-v1/"+sha+".png");if(!obj)throw new Error("dense reference missing "+sha);const dec=await decodePng(await new Response(obj.body).arrayBuffer()),image={width:dec.width,height:dec.height,rgba:dec.rgba},rgb32=sampleGrid(image,{x:0,y:0,width:dec.width,height:dec.height},32);return {width:dec.width,height:dec.height,rgb32};})();svDenseRefCache.set(sha,p);return p.catch(e=>{svDenseRefCache.delete(sha);throw e;});}
function trainStatAdd(m,k,n=1){m[k]=(m[k]||0)+n;}
async function trainTruthStatsBatch(env,start,count){start=Math.max(0,Number(start)||0);count=Math.max(1,Math.min(25,Number(count)||20));const listed=await env.BENCHMARK_R2.list({prefix:"clean/train/",limit:1000}),keys=(listed.objects||[]).map(o=>o.key).filter(k=>k.endsWith("/truth.json")).sort(),sel=keys.slice(start,start+count),acc={boards:0,objects:0,viewports:{},object_counts:{},bbox_sizes:{},bbox_positions:{},render_modes:{}};for(const k of sel){const o=await env.BENCHMARK_R2.get(k);if(!o)continue;const r=JSON.parse(await new Response(o.body).text());acc.boards++;trainStatAdd(acc.viewports,(r.viewport?.width||0)+"x"+(r.viewport?.height||0));const os=Array.isArray(r.objects)?r.objects:[];trainStatAdd(acc.object_counts,String(os.length));for(const ob of os){acc.objects++;const b=ob.bbox||{};trainStatAdd(acc.bbox_sizes,Math.round(b.width||0)+"x"+Math.round(b.height||0));trainStatAdd(acc.bbox_positions,Math.round(b.x||0)+","+Math.round(b.y||0));trainStatAdd(acc.render_modes,String(ob.render_mode||""));}}const key="debug/train-truth-stats-v2/part-"+String(start).padStart(3,"0")+".json";await env.BENCHMARK_R2.put(key,JSON.stringify({schema_version:1,start,count:sel.length,acc}),{httpMetadata:{contentType:"application/json"},customMetadata:{artifact:"train-truth-stats-v2-part",start:String(start),count:String(sel.length),boards:String(acc.boards),objects:String(acc.objects)}});return {start,count:sel.length,boards:acc.boards,objects:acc.objects};}
async function trainTruthStatsAggregate(env){const listed=await env.BENCHMARK_R2.list({prefix:"debug/train-truth-stats-v2/part-",limit:1000}),acc={boards:0,objects:0,viewports:{},object_counts:{},bbox_sizes:{},bbox_positions:{},render_modes:{}};for(const o of listed.objects||[]){const obj=await env.BENCHMARK_R2.get(o.key);if(!obj)continue;const r=JSON.parse(await new Response(obj.body).text()).acc||{};acc.boards+=Number(r.boards||0);acc.objects+=Number(r.objects||0);for(const k of ["viewports","object_counts","bbox_sizes","bbox_positions","render_modes"])for(const [v,n] of Object.entries(r[k]||{}))trainStatAdd(acc[k],v,Number(n||0));}const sort=o=>Object.entries(o).sort((a,b)=>b[1]-a[1]||a[0].localeCompare(b[0]));const result={schema_version:1,boards:acc.boards,objects:acc.objects,viewports:sort(acc.viewports),object_counts:sort(acc.object_counts),bbox_sizes:sort(acc.bbox_sizes).slice(0,60),bbox_positions:sort(acc.bbox_positions).slice(0,100),render_modes:sort(acc.render_modes)};await env.BENCHMARK_R2.put("debug/train-truth-stats-v2/aggregate.json",JSON.stringify(result),{httpMetadata:{contentType:"application/json"},customMetadata:{artifact:"train-truth-stats-v2-aggregate",boards:String(result.boards),objects:String(result.objects),viewports:JSON.stringify(result.viewports),object_counts:JSON.stringify(result.object_counts),bbox_sizes:JSON.stringify(result.bbox_sizes.slice(0,20)),bbox_positions:JSON.stringify(result.bbox_positions.slice(0,30)),render_modes:JSON.stringify(result.render_modes)}});return result;}
async function trainTruthStats(env){const listed=await env.BENCHMARK_R2.list({prefix:"clean/train/",limit:1000}),keys=(listed.objects||[]).map(o=>o.key).filter(k=>k.endsWith("/truth.json")),viewports=new Map(),counts=new Map(),sizes=new Map(),positions=new Map(),modes=new Map();let boards=0,objects=0;for(let i=0;i<keys.length;i+=20){const batch=keys.slice(i,i+20),rows=await Promise.all(batch.map(async k=>{const o=await env.BENCHMARK_R2.get(k);return o?JSON.parse(await new Response(o.body).text()):null;}));for(const r of rows){if(!r)continue;boards++;const vp=(r.viewport?.width||0)+"x"+(r.viewport?.height||0);viewports.set(vp,(viewports.get(vp)||0)+1);const os=Array.isArray(r.objects)?r.objects:[];counts.set(String(os.length),(counts.get(String(os.length))||0)+1);for(const o of os){objects++;const b=o.bbox||{},sz=Math.round(b.width||0)+"x"+Math.round(b.height||0),pos=Math.round(b.x||0)+","+Math.round(b.y||0);sizes.set(sz,(sizes.get(sz)||0)+1);positions.set(pos,(positions.get(pos)||0)+1);const md=String(o.render_mode||"");modes.set(md,(modes.get(md)||0)+1);}}}const sort=(m)=>[...m.entries()].sort((a,b)=>b[1]-a[1]||String(a[0]).localeCompare(String(b[0])));const result={schema_version:1,boards,objects,viewports:sort(viewports),object_counts:sort(counts),bbox_sizes:sort(sizes).slice(0,40),bbox_positions:sort(positions).slice(0,80),render_modes:sort(modes)};await env.BENCHMARK_R2.put("debug/train-truth-stats-v1.json",JSON.stringify(result),{httpMetadata:{contentType:"application/json"},customMetadata:{artifact:"train-truth-stats-v1",boards:String(boards),objects:String(objects),viewports:JSON.stringify(result.viewports),object_counts:JSON.stringify(result.object_counts),bbox_sizes:JSON.stringify(result.bbox_sizes.slice(0,20)),render_modes:JSON.stringify(result.render_modes)}});return result;}
const gateAcceptedCache={p:null};
