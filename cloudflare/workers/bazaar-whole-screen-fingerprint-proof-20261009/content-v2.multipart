async function inspectClusterProof(env,body){
  const key=String(body.clusters_key||""),out=String(body.output_key||"");const obj=await env.BENCHMARK_R2.get(key);if(!obj)throw new Error("clusters missing");const root=JSON.parse(await new Response(obj.body).text()),clusters=Array.isArray(root.clusters)?root.clusters:[];
  const sgw={x:997,y:339,width:311,height:494},hud={x:119,y:668,width:165,height:210};
  const norm=s=>String(s||"").toLowerCase().replace(/[^a-z0-9]/g,"");
  const decorate=c=>({...c,sgw_iou:iou(c.bbox,sgw),hud_iou:iou(c.bbox,hud),top_identity_names:(c.top_identities||[]).slice(0,6).map(x=>basename(x.asset_path||""))});
  const bySgw=[...clusters].map(decorate).sort((a,b)=>b.sgw_iou-a.sgw_iou).slice(0,8);
  const byHud=[...clusters].map(decorate).sort((a,b)=>b.hud_iou-a.hud_iou).slice(0,8);
  const sgwIdentity=clusters.filter(c=>(c.top_identities||[]).some(x=>norm(x.asset_path).includes("stainedglasswindow"))).map(decorate).sort((a,b)=>b.sgw_iou-a.sgw_iou||b.cluster_score-a.cluster_score).slice(0,12);
  const handsIdentity=clusters.filter(c=>(c.top_identities||[]).some(x=>norm(x.asset_path).includes("handsoftime"))).map(decorate).sort((a,b)=>b.hud_iou-a.hud_iou||b.cluster_score-a.cluster_score).slice(0,12);
  const ranked=[...clusters].sort((a,b)=>b.cluster_score-a.cluster_score).slice(0,30).map(decorate);
  const result={schema_version:1,inspection_version:"whole-screen-reference-proof-v4-known-region-inspection",cluster_count:clusters.length,sgw_truth:sgw,hud_truth:hud,best_sgw_overlap:bySgw[0]||null,best_hud_overlap:byHud[0]||null,sgw_identity_clusters:sgwIdentity,hands_identity_clusters:handsIdentity,top30:ranked};
  const slim=x=>x?{id:x.cluster_id,bbox:x.bbox,cluster_score:x.cluster_score,best_score:x.best_score,median_score:x.median_score,support_bands:x.support_bands,support_height_bands:x.support_height_bands,identity_concentration:x.identity_concentration,sgw_iou:x.sgw_iou,hud_iou:x.hud_iou,ids:x.top_identity_names}:null;
  await env.BENCHMARK_R2.put(out,JSON.stringify(result),{httpMetadata:{contentType:"application/json"},customMetadata:{artifact:"whole-screen-reference-proof-v4-known-region-inspection",cluster_count:String(clusters.length),best_sgw:JSON.stringify(slim(bySgw[0])),best_hud:JSON.stringify(slim(byHud[0])),best_sgw_identity:JSON.stringify(slim(sgwIdentity[0])),best_hands_identity:JSON.stringify(slim(handsIdentity[0])),sgw_identity_cluster_count:String(sgwIdentity.length),hands_identity_cluster_count:String(handsIdentity.length),top12:JSON.stringify(ranked.slice(0,12).map(slim))}});
  return result;
}

