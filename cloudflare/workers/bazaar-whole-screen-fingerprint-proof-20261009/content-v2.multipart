function rnLabelMap(rows){const m=new Map();for(const r of rows||[]){const k=String(r.label||r.class||"");const v=Number(r.score??r.confidence??0);if(k)m.set(k,v);}return m;}
function rnSim(a,b){const A=rnLabelMap(a),B=rnLabelMap(b),keys=new Set([...A.keys(),...B.keys()]);let dot=0,aa=0,bb=0;for(const k of keys){const x=A.get(k)||0,y=B.get(k)||0;dot+=x*y;aa+=x*x;bb+=y*y;}return aa&&bb?dot/Math.sqrt(aa*bb):0;}
