function glVoteRank8(target,refs,indexed,limit=32){const votes=new Float64Array(refs.length);for(let ti=0;ti<target.length;ti++){const d=target[ti].descriptor;for(let ci=0;ci<indexed.offs.length;ci++){const o=indexed.offs[ci],base=(d[o]<<8)|d[o+1],prefix=ci<<16,exact=indexed.idx.get(prefix|base);if(exact)for(const code of exact)votes[Math.floor(code/256)]+=2;for(let bit=0;bit<16;bit++){const a=indexed.idx.get(prefix|(base^(1<<bit)));if(a)for(const code of a)votes[Math.floor(code/256)]+=1;}}}const rows=Array.from(votes,(v,i)=>({i,v,score:v/Math.sqrt(Math.max(1,target.length*refs[i].features.length))}));rows.sort((a,b)=>b.score-a.score||b.v-a.v);return rows.slice(0,Math.max(1,Math.min(refs.length,limit)));}
const GL_PACKED_MAGIC=0x42495831,GL_PACKED_HEADS=8*65537;const glPackedCache=new Map();
const GL_BANK_MAGIC=0x42424631,GL_BANK_SLOTS=256;const glPackedBankCache=new Map();
async function glBuildPackedBankArtifact(env,si){si=Math.max(0,Math.min(7,Number(si)||0));const bank=await lgLoadBank(env,"debug/whole-screen-local-feature-bank-v1/shards/shard-"+String(si).padStart(2,"0")+".json"),refs=bank.refs,rc=refs.length,slots=GL_BANK_SLOTS,total=rc*slots;let off=16;const countsOff=off;off+=rc*2;const widthsOff=off;off+=rc*2;const heightsOff=off;off+=rc*2;const xsOff=off;off+=total*2;const ysOff=off;off+=total*2;const descOff=off;off+=total*16;const buf=new ArrayBuffer(off),hdr=new Uint32Array(buf,0,4);hdr[0]=GL_BANK_MAGIC;hdr[1]=rc;hdr[2]=slots;hdr[3]=refs.reduce((n,r)=>n+Math.min(slots,r.features.length),0);const counts=new Uint16Array(buf,countsOff,rc),widths=new Uint16Array(buf,widthsOff,rc),heights=new Uint16Array(buf,heightsOff,rc),xs=new Uint16Array(buf,xsOff,total),ys=new Uint16Array(buf,ysOff,total),desc=new Uint8Array(buf,descOff,total*16),meta=[];for(let ri=0;ri<rc;ri++){const r=refs[ri],cnt=Math.min(slots,r.features.length);counts[ri]=cnt;widths[ri]=Math.max(0,Math.min(65535,Math.round(r.width||0)));heights[ri]=Math.max(0,Math.min(65535,Math.round(r.height||0)));meta.push({asset_path:r.asset_path,source_sha256:r.source_sha256||null,width:r.width,height:r.height});for(let fi=0;fi<cnt;fi++){const f=r.features[fi],code=ri*slots+fi;xs[code]=Math.max(0,Math.min(65535,Math.round(f.x||0)));ys[code]=Math.max(0,Math.min(65535,Math.round(f.y||0)));desc.set(f.descriptor,code*16);}}const base="debug/global-local-packed-bank-v1/shard-"+String(si).padStart(2,"0");await env.BENCHMARK_R2.put(base+".bin",buf,{httpMetadata:{contentType:"application/octet-stream"},customMetadata:{artifact:"global-local-packed-bank-v1",shard_index:String(si),reference_count:String(rc),feature_count:String(hdr[3]),bytes:String(buf.byteLength)}});await env.BENCHMARK_R2.put(base+".meta.json",JSON.stringify({schema_version:1,shard_index:si,refs:meta}),{httpMetadata:{contentType:"application/json"},customMetadata:{artifact:"global-local-packed-bank-v1-meta",shard_index:St