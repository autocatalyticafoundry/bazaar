const ORIG="debug/whole-screen-local-feature-bank-v1/batches",SPLIT="debug/whole-screen-local-feature-bank-v1/splits";async function read(env,key){const o=await env.BENCHMARK_R2.get(key);if(!o)return null;return JSON.parse(await new Response(o.body).text());}export default {async queue(batch,env){for(const m of batch.messages){const b=m.body||{},start=Math.max(0,Math.floor(Number(b.start_batch)||0)),count=Math.max(1,Math.min(32,Math.floor(Number(b.batch_count)||16))),out=String(b.output_key||"");try{const rows=[],sources=[];for(let i=start;i<Math.min(124,start+count);i++){const k=ORIG+"/batch-"+String(i).padStart(3,"0")+".json",orig=await read(env,k);const origComplete=orig&&Number(orig.attempted||0)>0&&Array.isArray(orig.rows)&&orig.rows.length===Number(orig.attempted)&&(!Array.isArray(orig.failures)||orig.failures.length===0);if(origComplete){rows.push(...orig.rows);sources.push({batch:i,source:"original",rows:orig.rows.length});continue;}let splitRows=[];for(let s=0;s<4;s++){const sk=SPLIT+"/batch-"+String(i).padStart(3,"0")+"-"+s+".json",part=await read(env,sk);if(!part)throw new Error("missing "+sk);if(!Array.isArray(part.rows)||part.rows.length!==Number(part.attempted)||Array.isArray(part.failures)&&part.failures.length)throw new Error("incomplete "+sk);splitRows.push(...part.rows);}rows.push(...splitRows);sources.push({batch:i,source:"split",rows:splitRows.length});}const dedup=[],seen=new Set();for(const row of rows){const k=String(row.asset_path||"");if(!k||seen.has(k))continue;seen.add(k);dedup.push(row);}const result={schema_version:1,bank_version:"whole-screen-local-feature-bank-v1",aggregation:"shard",start_batch:start,batch_count:count,reference_count:dedup.length,rows:dedup,sources};await env.BENCHMARK_R2.put(out,JSON.stringify(result),{httpMetadata:{contentType:"application/json"},customMetadata:{artifact:"whole-screen-local-feature-bank-shard-v1",start_batch:String(start),batch_count:String(count),reference_count:String(dedup.length),source_summary:JSON.stringify(sources)}});}catch(e){await env.BENCHMARK_R2.put(out,JSON.stringify({start,count,error:e instanceof Error?e.message:String(e)}),{httpMetadata:{contentType:"application/json"},customMetadata:{artifact:"whole-screen-local-feature-bank-shard-v1",start_batch:String(start),batch_count:String(count),error:e instanceof Error?e.message:String(e)}});}m.ack();}}};
