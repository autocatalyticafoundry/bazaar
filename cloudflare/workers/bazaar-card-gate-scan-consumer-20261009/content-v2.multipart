    const d=JSON.parse(await o.text()),dec=gate(d),accepted=dec.filter(x=>x.accepted),rejected=dec.filter(x=>!x.accepted);
    const key="benchmarks/real-screenshot-card-gate-v1/"+sha+"/shadow-eval.json";
    const out={schema_version:1,gate_version:"real-screenshot-card-gate-v1-structural",source_result:"perception/results/"+sha+"-human-audit-20261007-0035.json",semantic_promotion_allowed:false,accepted_count:accepted.length,accepted_ids:accepted.map(x=>x.id),rejected_count:rejected.length,rejected_ids:rejected.map(x=>x.id),known_hud_region_id:"region-13",known_hud_accepted:accepted.some(x=>x.id==="region-13"),known_correct_region_id:"region-22",known_correct_accepted:accepted.some(x=>x.id==="region-22"),decisions:dec};
    await env.BUCKET.put(key,JSON.stringify(out),{httpMetadata:{contentType:"application/json"},customMetadata:{artifact:"real-screenshot-card-gate-shadow-eval",gate_version:out.gate_version,accepted_count:String(out.accepted_count),known_hud_accepted:String(out.known_hud_accepted),known_correct_accepted:String(out.known_correct_accepted),accepted_ids:JSON.stringify(out.accepted_ids)}});
    for(const m of batch.messages)m.ack();
