const VERSION="playable-card-cardness-features-v1";
function u32be(a,o){return ((a[o]<<24)>>>0)|(a[o+1]<<16)|(a[o+2]<<8)|a[o+3]}
function paeth(a,b,c){const p=a+b-c,pa=Math.abs(p-a),pb=Math.abs(p-b),pc=Math.abs(p-c);return pa<=pb&&pa<=pc?a:pb<=pc?b:c}
function cat(parts){let n=0;for(const p of parts)n+=p.length;const out=new Uint8Array(n);let o=0;for(const p of parts){out.set(p,o);o+=p.length}return out}
async function inflate(bytes){const stream=new Blob([bytes]).stream().pipeThrough(new DecompressionStream("deflate"));return new Uint8Array(await new Response(stream).arrayBuffer())}
async function decodePng(bytes){const sig=[137,80,78,71,13,10,26,10];for(let i=0;i<8;i++)if(bytes[i]!==sig[i])throw new Error("not png");let o=8,w=0,h=0,depth=0,type=0,interlace=0,idats=[],palette=null,trns=null;while(o+12<=bytes.length){const len=u32be(bytes,o)>>>0,typ=String.fromCharCode(...bytes.slice(o+4,o+8)),data=bytes.slice(o+8,o+8+len);o+=12+len;if(typ==="IHDR"){w=u32be(data,0)>>>0;h=u32be(data,4)>>>0;depth=data[8];type=data[9];interlace=data[12]}else if(typ==="PLTE")palette=new Uint8Array(data);else if(typ==="tRNS")trns=new Uint8Array(data);else if(typ==="IDAT")idats.push(data);else if(typ==="IEND")break}if(depth!==8||interlace!==0||!(type===6||type===2||type===3))throw new Error("unsupported png "+JSON.stringify({depth,type,interlace}));if(type===3&&!palette)throw new Error("indexed png missing palette");const bpp=type===6?4:type===2?3:1,stride=w*bpp,raw=await inflate(cat(idats)),rgba=new Uint8Array(w*h*4),prev=new Uint8Array(stride),cur=new Uint8Array(stride);let p=0;for(let y=0;y<h;y++){const f=raw[p++];for(let x=0;x<stride;x++){const v=raw[p++],a=x>=bpp?cur[x-bpp]:0,b=prev[x],c=x>=bpp?prev[x-bpp]:0,pr=f===0?0:f===1?a:f===2?b:f===3?Math.floor((a+b)/2):f===4?paeth(a,b,c):(()=>{throw new Error("filter "+f)})();cur[x]=(v+pr)&255}for(let x=0;x<w;x++){const si=x*bpp,di=(y*w+x)*4;if(type===3){const ix=cur[si],pi=ix*3;rgba[di]=palette[pi]??0;rgba[di+1]=palette[pi+1]??0;rgba[di+2]=palette[pi+2]??0;rgba[di+3]=trns&&ix<trns.length?trns[ix]:255}else{rgba[di]=cur[si];rgba[di+1]=cur[si+1];rgba[di+2]=cur[si+2];rgba[di+3]=type===6?cur[si+3]:255}}prev.set(cur)}return {width:w,height:h,rgba}}
function clampBox(b,w,h){const x=Math.max(0,Math.min(w-1,Math.round(b.x))),y=Math.max(0,Math.min(h-1,Math.round(b.y))),ww=Math.max(2,Math.min(w-x,Math.round(b.width))),hh=Math.max(2,Math.min(h-y,Math.round(b.height)));return {x,y,width:ww,height:hh}}
function stats(a){if(!a.length)return {mean:0,std:0};let s=0,s2=0;for(const v of a){s+=v;s2+=v*v}const mean=s/a.length;return {mean,std:Math.sqrt(Math.max(0,s2/a.length-mean*mean))}}
function entropy(vals,bins=12){if(!vals.length)return 0;const c=new Array(bins).fill(0);for(const v of vals)c[Math.min(bins-1,Math.max(0,Math.floor(v*bins)))]++;let e=0;for(const n of c)if(n){const p=n/vals.length;e-=p*Math.log(p)}return e/Math.log(bins)}
function features(img,rawBox){
 const b=clampBox(rawBox,img.width,img.height),N=48,L=new Float64Array(N*N),S=new Float64Array(N*N);
 for(let gy=0;gy<N;gy++)for(let gx=0;gx<N;gx++){const px=Math.min(img.width-1,b.x+Math.floor((gx+.5)*b.width/N)),py=Math.min(img.height-1,b.y+Math.floor((gy+.5)*b.height/N)),i=(py*img.width+px)*4,r=img.rgba[i]/255,g=img.rgba[i+1]/255,bl=img.rgba[i+2]/255,max=Math.max(r,g,bl),min=Math.min(r,g,bl);L[gy*N+gx]=.2126*r+.7152*g+.0722*bl;S[gy*N+gx]=max?((max-min)/max):0}
 const allL=[],allS=[],borderL=[],borderS=[],centerL=[],centerS=[],borderE=[],centerE=[],allE=[],hE=[],vE=[],cornerE=[],frameE=[];
 const ring=6,center0=12,center1=36,frameBand=[2,3,4,43,44,45];
 let symX=0,symY=0,symN=0;
 for(let y=0;y<N;y++)for(let x=0;x<N;x++){const idx=y*N+x,l=L[idx],s=S[idx],border=x<ring||x>=N-ring||y<ring||y>=N-ring,center=x>=center0&&x<center1&&y>=center0&&y<center1;allL.push(l);allS.push(s);if(border){borderL.push(l);borderS.push(s)}if(center){centerL.push(l);centerS.push(s)}let he=0,ve=0;if(x>0)he=Math.abs(l-L[idx-1]);if(y>0)ve=Math.abs(l-L[idx-N]);const e=(he+ve)/2;allE.push(e);hE.push(he);vE.push(ve);if(border)borderE.push(e);if(center)centerE.push(e);if((x<ring||x>=N-ring)&&(y<ring||y>=N-ring))cornerE.push(e);if(frameBand.includes(x)||frameBand.includes(y))frameE.push(e);if(x<N/2){symX+=Math.abs(l-L[y*N+(N-1-x)]);symN++}if(y<N/2)symY+=Math.abs(l-L[(N-1-y)*N+x])}
 const al=stats(allL),as=stats(allS),be=stats(borderE),ce=stats(centerE),ae=stats(allE),bs=stats(borderS),cs=stats(centerS),bls=stats(borderL),cls=stats(centerL),hs=stats(hE),vs=stats(vE),corn=stats(cornerE),frm=stats(frameE);
 return {aspect:b.width/b.height,area:b.width*b.height/(img.width*img.height),luma_mean:al.mean,luma_std:al.std,sat_mean:as.mean,sat_std:as.std,edge_mean:ae.mean,edge_std:ae.std,border_edge:be.mean,center_edge:ce.mean,border_center_edge_ratio:be.mean/(ce.mean+.005),border_luma_delta:bls.mean-cls.mean,border_sat_delta:bs.mean-cs.mean,h_edge:hs.mean,v_edge:vs.mean,hv_log_ratio:Math.log((hs.mean+.005)/(vs.mean+.005)),corner_edge:corn.mean,frame_edge:frm.mean,border_luma_std:bls.std,center_luma_std:cls.std,border_entropy:entropy(borderL),center_entropy:entropy(centerL),sym_x:symN?symX/symN:0,sym_y:symN?symY/symN:0};
}
async function loadImg(env,key){const o=await env.BUCKET.get(key);if(!o)throw new Error("missing image "+key);return decodePng(new Uint8Array(await o.arrayBuffer()))}
async function processSynthetic(env,truthKey){
 const to=await env.BUCKET.get(truthKey);if(!to)throw new Error("missing truth");const truth=JSON.parse(await to.text()),caseId=truth.case_id||truthKey.split("/").slice(-2,-1)[0],imageKey="clean/train/"+caseId+"/screenshot.png",img=await loadImg(env,imageKey),items=(truth.objects||[]).filter(x=>x?.expected_resolution==="semantic"&&Array.isArray(x.expected_entity_ids)&&x.expected_entity_ids.length===1&&String(x.expected_entity_ids[0]).startsWith("bazaar:item:")&&x.bbox);
 const positives=items.map(x=>({label:1,source:"synthetic_truth_item",entity_id:x.expected_entity_ids[0],bbox:x.bbox,features:features(img,x.bbox)}));
 const so=await env.BUCKET.get("benchmarks/playable-card-gate-training-v1/synthetic/"+caseId+".json");let negBoxes=[];if(so){const sd=JSON.parse(await so.text());negBoxes=(sd.negatives||[]).slice(0,8).map(x=>x.bbox)}
 const negatives=negBoxes.map(b=>({label:0,source:"synthetic_truth_empty_card_crop",bbox:b,features:features(img,b)}));
 const a={schema_version:1,artifact:"playable-card-cardness-feature-shard",version:VERSION,case_id:caseId,positive_count:positives.length,negative_count:negatives.length,positives,negatives};
 await env.BUCKET.put("benchmarks/playable-card-cardness-features-v1/synthetic/"+caseId+".json",JSON.stringify(a),{httpMetadata:{contentType:"application/json",cacheControl:"private, max-age=0"},customMetadata:{artifact:"playable-card-cardness-feature-shard",version:VERSION,case_id:caseId,positive_count:String(positives.length),negative_count:String(negatives.length)}});
}
function smallerOverlap(a,b){const ix=Math.max(0,Math.min(a.x+a.width,b.x+b.width)-Math.max(a.x,b.x)),iy=Math.max(0,Math.min(a.y+a.height,b.y+b.height)-Math.max(a.y,b.y)),inter=ix*iy;return inter/Math.max(1,Math.min(a.width*a.height,b.width*b.height))}
function overlapSmaller2(a,b){const ix=Math.max(0,Math.min(a.x+a.width,b.x+b.width)-Math.max(a.x,b.x)),iy=Math.max(0,Math.min(a.y+a.height,b.y+b.height)-Math.max(a.y,b.y)),inter=ix*iy;return inter/Math.max(1,Math.min(a.width*a.height,b.width*b.height))}
async function processCombine(env,msg){
 const go=await env.BUCKET.get(msg.v1_gate_key);if(!go)throw new Error("missing v1 gate");const gate=JSON.parse(await go.text());
 const ro=await env.BUCKET.get(gate.source_result_key);if(!ro)throw new Error("missing source");const d=JSON.parse(await ro.text()),token=String(d.pipeline_version).replace(/[^A-Za-z0-9._-]+/g,"-");
 const structural=(gate.decisions||[]).filter(x=>x.decision?.accepted===true),rows=[];
 for(const x of gate.decisions||[]){
   if(x.decision?.accepted===true){rows.push({region_id:x.region_id,bbox:x.bbox,structural:x.decision,cardness:null,max_structural_overlap:0,overlap_region_id:null,accepted:true,path:x.decision.path});continue}
   const ck="perception/playable-card-cardness-shadow/"+d.input.sha256+"/"+token+"/"+x.region_id+".json",co=await env.BUCKET.get(ck);let cardness=null;if(co){const c=JSON.parse(await co.text());cardness=c.cardness||null}
   const ovs=structural.map(s=>({region_id:s.region_id,overlap:overlapSmaller2(x.bbox,s.bbox)})).sort((a,b)=>b.overlap-a.overlap),max=ovs[0]?.overlap??0,oid=ovs[0]?.region_id??null,pred=cardness?.predicted_card===true,rescue=pred&&max<0.4;
   rows.push({region_id:x.region_id,bbox:x.bbox,structural:x.decision,cardness,max_structural_overlap:max,overlap_region_id:oid,accepted:rescue,path:rescue?"visual_cardness_uncovered_rescue":"rejected"});
 }
 const accepted=rows.filter(x=>x.accepted),rescued=rows.filter(x=>x.path==="visual_cardness_uncovered_rescue"),knownPos=new Set(msg.evaluation?.known_positive_region_ids||[]),knownNeg=new Set(msg.evaluation?.known_negative_region_ids||[]);
 const artifact={schema_version:1,artifact:"playable-card-gate-v2-shadow",version:"playable-card-gate-v2-structural-plus-uncovered-cardness-rescue",semantic_promotion_allowed:false,source_v1_gate_key:msg.v1_gate_key,source_result_key:gate.source_result_key,source_sha256:d.input.sha256,structural_accepted_count:structural.length,visual_rescue_count:rescued.length,accepted_count:accepted.length,rejected_count:rows.length-accepted.length,accepted_region_ids:accepted.map(x=>x.region_id),visual_rescue_region_ids:rescued.map(x=>x.region_id),evaluation:{expected_count:msg.evaluation?.expected_playable_card_count??null,count_matches:msg.evaluation?.expected_playable_card_count==null?null:accepted.length===msg.evaluation.expected_playable_card_count,known_positive_rejected:rows.filter(x=>knownPos.has(x.region_id)&&!x.accepted).map(x=>x.region_id),known_negative_accepted:rows.filter(x=>knownNeg.has(x.region_id)&&x.accepted).map(x=>x.region_id)},rows};
 const out="perception/playable-card-gate-v2-shadow/"+d.input.sha256+"/"+token+".json";await env.BUCKET.put(out,JSON.stringify(artifact),{httpMetadata:{contentType:"application/json",cacheControl:"private, max-age=0"},customMetadata:{artifact:"playable-card-gate-v2-shadow",version:artifact.version,structural_accepted:String(structural.length),visual_rescues:String(rescued.length),accepted:String(accepted.length),accepted_ids:JSON.stringify(accepted.map(x=>x.region_id)),rescue_ids:JSON.stringify(rescued.map(x=>x.region_id)),expected_count:artifact.evaluation.expected_count==null?"":String(artifact.evaluation.expected_count),count_matches:artifact.evaluation.count_matches==null?"":String(artifact.evaluation.count_matches),known_positive_rejected:JSON.stringify(artifact.evaluation.known_positive_rejected),known_negative_accepted:JSON.stringify(artifact.evaluation.known_negative_accepted),semantic_promotion_allowed:"false"}});
}
async function processMeta(env,msg){
 const ro=await env.BUCKET.get(msg.result_key);if(!ro)throw new Error("missing result");
 const d=JSON.parse(await ro.text()),region=(d.regions||[]).find(r=>r.region_id===msg.region_id);if(!region)throw new Error("missing region "+msg.region_id);
 const token=String(d.pipeline_version).replace(/[^A-Za-z0-9._-]+/g,"-");
 const key="debug/region-meta/"+d.input.sha256+"/"+token+"/"+msg.region_id;
 await env.BUCKET.put(key,new Uint8Array(),{customMetadata:{region_id:msg.region_id,bbox:JSON.stringify(region.bbox),proposal:JSON.stringify(region.proposal),cohort:String(region.routing?.cohort??"")}});
}
async function processCandidate(env,msg){
 const ro=await env.BUCKET.get(msg.result_key);if(!ro)throw new Error("missing result");
 const d=JSON.parse(await ro.text()),region=(d.regions||[]).find(r=>r.region_id===msg.region_id);if(!region)throw new Error("missing region "+msg.region_id);
 const img=await loadImg(env,d.input.r2_key||("perception/inputs/"+d.input.sha256+".png"));
 const featureRow=features(img,region.bbox);
 const mo=await env.BUCKET.get("benchmarks/playable-card-cardness-features-v1/model-interim-calibrated.json");if(!mo)throw new Error("missing cardness model");
 const ma=JSON.parse(await mo.text()),model=ma.model,keys=model.feature_keys||[];
 const x=keys.map(k=>Number(featureRow?.[k]??0)),z=x.map((v,j)=>(v-model.global_mean[j])/model.global_std[j]),delta=model.pos_centroid_z.map((v,j)=>v-model.neg_centroid_z[j]),mid=model.pos_centroid_z.map((v,j)=>(v+model.neg_centroid_z[j])/2),norm=Math.sqrt(delta.reduce((s,v)=>s+v*v,0))||1;
 const score=delta.reduce((s,v,j)=>s+v*(z[j]-mid[j]),0)/norm,threshold=Number(model.threshold),margin=score-threshold,predictedCard=score>=threshold;
 const token=String(d.pipeline_version).replace(/[^A-Za-z0-9._-]+/g,"-");
 const gateKey="perception/playable-card-gate-shadow/"+d.input.sha256+"/"+token+".json",go=await env.BUCKET.get(gateKey);if(!go)throw new Error("missing structural gate");
 const gate=JSON.parse(await go.text()),structural=(gate.decisions||[]).filter(q=>q.decision?.accepted===true&&q.region_id!==msg.region_id),overlaps=structural.map(q=>({region_id:q.region_id,overlap:smallerOverlap(region.bbox,q.bbox)})).sort((a,b)=>b.overlap-a.overlap);
 const maxStructuralOverlap=overlaps[0]?.overlap??0,overlapRegionId=overlaps[0]?.region_id??null,rescueUncovered=predictedCard&&maxStructuralOverlap<0.4;
 const row={region_id:msg.region_id,bbox:region.bbox,proposal:region.proposal,routing:{cohort:region.routing?.cohort??null},features:featureRow,cardness:{model_key:"benchmarks/playable-card-cardness-features-v1/model-interim-calibrated.json",fit_kind:ma.fit_kind,score,threshold,margin,predicted_card:predictedCard},structural_coverage:{max_smaller_overlap:maxStructuralOverlap,overlap_region_id:overlapRegionId,uncovered:maxStructuralOverlap<0.4},visual_rescue:{accepted:rescueUncovered,reason:!predictedCard?"cardness_below_threshold":maxStructuralOverlap>=0.4?"already_covered_by_structural_region":"cardness_positive_uncovered_region"}};
 const key="perception/playable-card-cardness-shadow/"+d.input.sha256+"/"+token+"/"+msg.region_id+".json";
 await env.BUCKET.put(key,JSON.stringify({schema_version:1,artifact:"playable-card-cardness-shadow",version:VERSION,source_result_key:msg.result_key,source_sha256:d.input.sha256,...row,semantic_promotion_allowed:false}),{httpMetadata:{contentType:"application/json",cacheControl:"private, max-age=0"},customMetadata:{artifact:"playable-card-cardness-shadow",version:VERSION,region_id:msg.region_id,bbox:JSON.stringify(region.bbox),cardness_score:String(score),cardness_threshold:String(threshold),cardness_margin:String(margin),predicted_card:String(predictedCard),max_structural_overlap:String(maxStructuralOverlap),overlap_region_id:String(overlapRegionId||""),visual_rescue_accepted:String(rescueUncovered),visual_rescue_reason:row.visual_rescue.reason,feature_summary:JSON.stringify(featureRow).slice(0,900),semantic_promotion_allowed:"false"}});
}
async function processReal(env,msg){
 const ro=await env.BUCKET.get(msg.result_key);if(!ro)throw new Error("missing result");const d=JSON.parse(await ro.text()),img=await loadImg(env,d.input.r2_key||("perception/inputs/"+d.input.sha256+".png")),rows=[];
 for(const spec of msg.regions){const r=(d.regions||[]).find(x=>x.region_id===spec.region_id);if(!r)throw new Error("missing "+spec.region_id);rows.push({label:spec.label,source:spec.source,region_id:spec.region_id,entity_id:spec.entity_id||null,bbox:r.bbox,features:features(img,r.bbox)})}
 const key="benchmarks/playable-card-cardness-features-v1/real/"+d.input.sha256+"-"+msg.tag+".json",a={schema_version:1,artifact:"playable-card-cardness-real-features",version:VERSION,source_result_key:msg.result_key,source_sha256:d.input.sha256,rows};
 await env.BUCKET.put(key,JSON.stringify(a),{httpMetadata:{contentType:"application/json",cacheControl:"private, max-age=0"},customMetadata:{artifact:"playable-card-cardness-real-features",version:VERSION,tag:msg.tag,positive_count:String(rows.filter(x=>x.label===1).length),negative_count:String(rows.filter(x=>x.label===0).length),row_summary:JSON.stringify(rows.map(x=>({region_id:x.region_id,label:x.label,source:x.source,features:x.features}))).slice(0,1800)}});
}
export default {async queue(batch,env){for(const m of batch.messages){try{if(m.body.kind==="synthetic")await processSynthetic(env,m.body.truth_key);else if(m.body.kind==="candidate")await processCandidate(env,m.body);else if(m.body.kind==="combine")await processCombine(env,m.body);else if(m.body.kind==="meta")await processMeta(env,m.body);else await processReal(env,m.body);m.ack()}catch(e){const msg=String(e?.stack||e);await env.BUCKET.put("debug/cardness-feature-errors/"+Date.now()+"-"+Math.random().toString(16).slice(2)+".txt",msg,{httpMetadata:{contentType:"text/plain"},customMetadata:{error:msg.slice(0,1000),kind:String(m.body?.kind||"")}});m.ack()}}}};
