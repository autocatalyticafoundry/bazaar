function iou(a,b){if(!a||!b)return 0;const x1=Math.max(a.x,b.x),y1=Math.max(a.y,b.y),x2=Math.min(a.x+a.width,b.x+b.width),y2=Math.min(a.y+a.height,b.y+b.height),i=Math.max(0,x2-x1)*Math.max(0,y2-y1),u=a.width*a.height+b.width*b.height-i;return u?i/u:0}
function itemTruth(t){return (t.objects||[]).map((o,i)=>({...o,_truth_index:i})).filter(o=>Array.isArray(o.expected_entity_ids)&&o.expected_entity_ids.some(x=>String(x).startsWith("bazaar:item:")))}
export default{async fetch(req,env){const u=new URL(req.url);if(u.pathname!=="/evaluate-case")return Response.json({ok:true});try{
 const id=u.searchParams.get("case_id")||"",to=await env.BUCKET.get("clean/train/"+id+"/truth.json"),so=await env.BUCKET.get("clean/train/"+id+"/screenshot.png");if(!to||!so)throw Error("missing_case");
 const truth=JSON.parse(await to.text()),bytes=await so.arrayBuffer(),stub=env.PERCEPTION_RUNNER.get(env.PERCEPTION_RUNNER.idFromName("perception-global")),pr=await stub.fetch("https://perception-runner.internal/analyze",{method:"POST",headers:{"content-type":"image/png","content-length":String(bytes.byteLength)},body:bytes});if(!pr.ok)throw Error("perception_"+pr.status+":"+(await pr.text()).slice(0,200));
 const result=await pr.json(),items=itemTruth(truth),rows=(result.regions||[]).map(r=>{let mi=0,best=null;for(const x of items){const z=iou(r.bbox,x.bbox);if(z>mi){mi=z;best=x}}const groups=(result.layout?.groups||[]).filter(g=>Array.isArray(g.region_ids)&&g.region_ids.includes(r.region_id)).map(g=>({member_count:g.member_count,spacing_cv:g.spacing_cv,width_cv:g.width_cv,height_cv:g.height_cv,repeat_recovered_fraction:g.repeat_recovered_fraction,orientation:g.orientation}));const ent=best?(best.expected_entity_ids||[]).find(v=>String(v).startsWith("bazaar:item:"))||null:null;return {region_id:r.region_id,bbox:r.bbox,proposal:r.proposal,routing:{cohort:r.routing?.cohort||null},max_item_iou:mi,truth_index:best?best._truth_index:null,truth_bbox:best?best.bbox:null,truth_entity_id:ent,label:mi>=.5?"positive":mi<.1?"negative":"ambiguous",groups}});
 const p=rows.filter(x=>x.label==="positive").length,n=rows.filter(x=>x.label==="negative").length,a=rows.length-p-n,key="benchmarks/card-role-calibration-v1/train/"+id+".json",covered=new Set(rows.filter(x=>x.label==="positive"&&x.truth_index!=null).map(x=>x.truth_index)).size,payload={schema_version:3,calibration_version:"card-role-calibration-v1.2-instance-aware",case_id:id,pipeline_version:result.pipeline_version,input_width:result.input?.width,input_height:result.input?.height,truth_item_count:items.length,truth_item_covered_count:covered,region_count:rows.length,positive_count:p,ambiguous_count:a,negative_count:n,rows};
 await env.BUCKET.put(key,JSON.stringify(payload),{httpMetadata:{contentType:"application/json"},customMetadata:{artifact:"card-role-calibration-case",calibration_version:"card-role-calibration-v1.2-instance-aware",case_id:id,truth_item_count:String(items.length),truth_item_covered_count:String(covered),region_count:String(rows.length),positive_count:String(p),ambiguous_count:String(a),negative_count:String(n)}});
 return Response.json({ok:true,key,case_id:id,truth_item_count:items.length,truth_item_covered_count:covered,region_count:rows.length,positive_count:p,ambiguous_count:a,negative_count:n});
 }catch(e){return Response.json({ok:false,error:String(e?.message||e)},{status:500})}}};

