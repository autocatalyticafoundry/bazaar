function keyFor(tag,c){return "debug/vscan-v1/f"+tag+"/c"+String(c).padStart(2,"0")+".json";}
function dist2(a,b){const dx=a.cx-b.cx,dy=a.cy-b.cy;return dx*dx+dy*dy;}
function compsFor(id,hits,size){const n=hits.length,seen=new Uint8Array(n),out=[],thr=size*.82,thr2=thr*thr;for(let i=0;i<n;i++){if(seen[i])continue;seen[i]=1;const q=[i],idx=[];while(q.length){const u=q.pop();idx.push(u);for(let v=0;v<n;v++){if(seen[v])continue;if(dist2(hits[u],hits[v])<=thr2){seen[v]=1;q.push(v);}}}const a=idx.map(k=>hits[k]),xs=a.map(x=>x.cx),ys=a.map(x=>x.cy),scores=a.map(x=>x.score),top1=a.filter(x=>x.rank===0).length,minx=Math.min(...xs),maxx=Math.max(...xs),miny=Math.min(...ys),maxy=Math.max(...ys),spread=Math.hypot(maxx-minx,maxy-miny),best=Math.min(...scores),mean=scores.reduce((s,x)=>s+x,0)/scores.length,locality=a.length/(1+spread/Math.max(1,size)),score=top1*3+a.length*1.2+Math.max(0,8-best)*.7+locality*2;out.push({id,support:a.length,top1,best,mean,spread,locality,score,cx:xs.reduce((s,x)=>s+x,0)/a.length,cy:ys.reduce((s,x)=>s+x,0)/a.length,peak:a.slice().sort((p,q)=>p.score-q.score||p.rank-q.rank)[0]});}return out;}
async function aggregate(env,tag,chunks){const all=[],missing=[];let size=0,totalWindows=0;for(let c=0;c<chunks;c++){const o=await env.R2.get(keyFor(tag,c));if(!o){missing.push(c);continue;}let j;try{j=JSON.parse(await new Response(o.body).text());}catch{missing.push(c);continue;}size=Number(j.size||size);totalWindows=Math.max(totalWindows,Number(j.window_count||0));for(const row of j.rows||[]){for(let rank=0;rank<(row.m||[]).length;rank++){const m=row.m[rank],b=row.b||{};all.push({id:String(m.id||""),sha:String(m.sha||""),score:Number(m.score||999),rank,cx:Number(b.x||0)+Number(b.width||0)/2,cy:Number(b.y||0)+Number(b.height||0)/2,x:Number(b.x||0),y:Number(b.y||0),w:Number(b.width||0),h:Number(b.height||0),i:Number(row.i||0)});}}}const by=new Map();for(const h of all){if(!by.has(h.id))by.set(h.id,[]);by.get(h.id).push(h);}const comps=[];for(const [id,hits] of by)for(const c of compsFor(id,hits,size))comps.push(c);comps.sort((a,b)=>b.score-a.score||b.top1-a.top1||b.support-a.support||a.best-b.best);return {tag,size,expected_chunks:chunks,completed_chunks:chunks-missing.length,missing,total_windows:totalWindows,hit_count:all.length,unique_ids:by.size,components:comps.slice(0,80)};}
export default {async fetch(request,env){const u=new URL(request.url),tag=Math.max(8,Math.min(30,Number(u.searchParams.get("f"))||22)),chunks=tag===22?8:tag===16?17:tag===10?44:Math.max(1,Number(u.searchParams.get("chunks"))||1),r=await aggregate(env,tag,chunks);return new Response(JSON.stringify(r),{headers:{"content-type":"application/json","cache-control":"no-store"}});}};

