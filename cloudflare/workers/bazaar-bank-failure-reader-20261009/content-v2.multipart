export default {async queue(batch,env){for(const m of batch.messages){const b=m.body||{},key=String(b.key||""),out=String(b.output_key||"");try{const o=await env.BENCHMARK_R2.get(key);if(!o)throw new Error("missing");const j=JSON.parse(await new Response(o.body).text());const compact={error:j.error??null,detail:j.detail??null,offset:j.offset??null,attempted:j.attempted??null,uploaded:j.uploaded??null,failures:j.failures??null,next_offset:j.next_offset??null,complete:j.complete??null,source:key};await env.BENCHMARK_R2.put(out,JSON.stringify(compact),{httpMetadata:{contentType:"application/json"},customMetadata:{artifact:"generic-json-readback",source:key,error:String(compact.error??""),detail:String(compact.detail??"").slice(0,1200),offset:String(compact.offset??""),attempted:String(compact.attempted??""),uploaded:String(compact.uploaded??""),failures:JSON.stringify(compact.failures??[]).slice(0,1600)}});}catch(e){await env.BENCHMARK_R2.put(out,JSON.stringify({source:key,error:e instanceof Error?e.message:String(e)}),{httpMetadata:{contentType:"application/json"},customMetadata:{artifact:"generic-json-readback",source:key,error:e instanceof Error?e.message:String(e)}});}m.ack();}}};
