const RUNNER_NAME="perception-global";
const PREFIX="benchmarks/playable-card-gate-v1/raw/";
function iou(a,b){const ax2=a.x+a.width,ay2=a.y+a.height,bx2=b.x+b.width,by2=b.y+b.height;const x1=Math.max(a.x,b.x),y1=Math.max(a.y,b.y),x2=Math.min(ax2,bx2),y2=Math.min(ay2,by2);const inter=Math.max(0,x2-x1)*Math.max(0,y2-y1);const u=a.width*a.height+b.width*b.height-inter;return u>0?inter/u:0;}
function validBox(b){return b&&[b.x,b.y,b.width,b.height].every(Number.isFinite)&&b.width>0&&b.height>0;}
function itemTruth(o){const ids=Array.isArray(o.expected_entity_ids)?o.expected_entity_ids:[];return o.expected_resolution==="semantic"&&ids.length===1&&typeof ids[0]==="string"&&ids[0].startsWith("bazaar:item:");}
function groupFeatures(regionId,groups){const members=(groups||[]).filter(g=>Array.isArray(g.region_ids)&&g.region_ids.includes(regionId));const nums=k=>members.map(g=>Number(g[k])).filter(Number.isFinite);const max=a=>a.length?Math.max(...a):null,min=a=>a.length?Math.min(...a):null;return {group_count:members.length,max_group_size:max(nums("member_count")),min_group_spacing_cv:min(nums("spacing_cv")),min_group_width_cv:min(nums("width_cv")),min_group_height_cv:min(nums("height_cv")),max_repeat_recovered_fraction:max(nums("repeat_recovered_fraction")),max_group_mean_support:max(nums("mean_proposal_support"))};}
async function analyzeCase(env,caseId){if(!/^clean-board-[a-z0-9]+$/.test(caseId))throw new Error("invalid case_id");const truthKey="clean/train/"+caseId+"/truth.json";const imageKey="clean/train/"+caseId+"/screenshot.png";const pair=await Promise.all([env.BENCHMARK_R2.get(truthKey),env.BENCHMARK_R2.get(imageKey)]);const to=pair[0],io=pair[1];if(!to||!io)throw new Error("case assets missing");const truth=JSON.parse(await to.text());const bytes=await io.arrayBuffer();let runnerHash=2166136261;for(let i=0;i<caseId.length;i++){runnerHash^=caseId.charCodeAt(i);runnerHash=Math.imul(runnerHash,16777619);}const runnerName="card-gate-calibration-"+((runnerHash>>>0)%8);const id=env.PERCEPTION_RUNNER.idFromName(runnerName);const stub=env.PERCEPTION_RUNNER.get(id);const response=await stub.fetch("https://perception-runner.internal/analyze",{method:"POST",headers:{"content-type":"image/png"},body:bytes});const text=await response.text();if(!response.ok)throw new Error("analyzer "+response.status+": "+text.slice(0,500));const perception=JSON.parse(text);const objects=Array.isArray(truth.objects)?truth.objects.filter(o=>validBox(o.bbox)):[];const items=objects.filter(itemTruth);const nonItems=objects.filter(o=>!itemTruth(o));const groups=perception.layout?.groups||[];const W=Number(perception.input?.width)||Number(truth.viewport?.width)||1;const H=Number(perception.input?.height)||Number(truth.viewport?.height)||1;const regions=(perception.regions||[]).filter(r=>validBox(r.bbox)).map(r=>{const maxItem=items.reduce((m,o)=>Math.max(m,iou(r.bbox,o.bbox)),0);const maxNon=nonItems.reduce((m,o)=>Math.max(m,iou(r.bbox,o.bbox)),0);const maxAny=Math.max(maxItem,maxNon);const b=r.bbox,p=r.proposal||{};const label=maxItem>=0.5?"playable_card":maxNon>=0.5?"non_item_object_negative":maxAny<0.1?"background_or_ui_negative":"ambiguous_or_partial_overlap";return {region_id:r.region_id||r.id||null,label,max_item_iou:maxItem,max_non_item_iou:maxNon,max_any_truth_iou:maxAny,bbox:b,features:{x_fraction:b.x/W,y_fraction:b.y/H,width_fraction:b.width/W,height_fraction:b.height/H,aspect_ratio:b.width/b.height,area_fraction:(b.width*b.height)/(W*H),proposal_source:p.source||null,proposal_score:Number.isFinite(p.score)?p.score:null,support_count:Number.isFinite(p.support_count)?p.support_count:null,geometry_class:r.geometry_class||null,cohort:r.routing?.cohort||null,current_item_route:r.routing?.cohort==="portrait_or_card"||r.routing?.cohort==="v30_board_cell",...classFeatures(r),...groupFeatures(r.region_id||r.id,groups)}};});const truthRecall=items.map(o=>{let best=null,bestIou=0;for(const rr of regions){const ov=iou(o.bbox,rr.bbox);if(ov>bestIou){bestIou=ov;best=rr;}}return {object_id:o.object_id||null,entity_id:o.expected_entity_ids?.[0]||null,bbox:o.bbox,best_iou:bestIou,best_region_id:best?.region_id||null,localized:bestIou>=0.5};});const record={schema_version:1,dataset_version:"playable-card-gate-v1",case_id:caseId,pipeline_version:perception.pipeline_version||null,input:perception.input,truth_item_count:items.length,truth_object_count:objects.length,region_count:regions.length,labels:{playable_card:regions.filter(r=>r.label==="playable_card").length,non_item_object_negative:regions.filter(r=>r.label==="non_item_object_negative").length,background_or_ui_negative:regions.filter(r=>r.label==="background_or_ui_negative").length,ambiguous_or_partial_overlap:regions.filter(r=>r.label==="ambiguous_or_partial_overlap").length},truth_localized_count:truthRecall.filter(x=>x.localized).length,truth_recall:truthRecall,regions,semantic_promotion_allowed:false};const key=PREFIX+caseId+".json";await env.BENCHMARK_R2.put(key,JSON.stringify(record),{httpMetadata:{contentType:"application/json; charset=utf-8",cacheControl:"private, max-age=0"},customMetadata:{artifact:"playable-card-gate-training-raw",dataset_version:"playable-card-gate-v1",case_id:caseId,pipeline_version:String(record.pipeline_version||""),truth_items:String(items.length),localized_items:String(record.truth_localized_count),positives:String(record.labels.playable_card),negatives:String((record.labels.background_or_ui_negative||0)+(record.labels.non_item_object_negative||0)),feature_schema:"visual-structural-v1"}});return {ok:true,artifact_key:key,case_id:caseId,pipeline_version:record.pipeline_version,truth_items:items.length,localized_items:record.truth_localized_count,regions:regions.length,labels:record.labels};}
function classFeatures(r){const ev=Array.isArray(r.semantic_class_evidence)?r.semantic_class_evidence:[];const item=ev.find(x=>x.semantic_class==="item")||null;const other=ev.filter(x=>x.semantic_class!=="item"&&Number.isFinite(x.best_score)).sort((a,b)=>a.best_score-b.best_score)[0]||null;const is=Number(item?.best_score),os=Number(other?.best_score);return {item_class_score:Number.isFinite(is)?is:null,best_non_item_class_score:Number.isFinite(os)?os:null,item_class_advantage:Number.isFinite(is)&&Number.isFinite(os)?os-is:null,item_class_candidate_rank:Number.isFinite(Number(item?.candidate_rank))?Number(item.candidate_rank):null,best_non_item_class:other?.semantic_class||null};}
function featureRow(r,groups,W,H){const b=r.bbox,p=r.proposal||{};return {x_fraction:b.x/W,y_fraction:b.y/H,width_fraction:b.width/W,height_fraction:b.height/H,aspect_ratio:b.width/b.height,area_fraction:(b.width*b.height)/(W*H),proposal_source:p.source||null,proposal_score:Number.isFinite(p.score)?p.score:null,support_count:Number.isFinite(p.support_count)?p.support_count:null,geometry_class:r.geometry_class||null,cohort:r.routing?.cohort||null,current_item_route:r.routing?.cohort==="portrait_or_card"||r.routing?.cohort==="v30_board_cell",...classFeatures(r),...groupFeatures(r.region_id||r.id,groups)};}
async function ingestRealHardExamples(env){const sha="5a4e9b43b05b2fd6f998cf2725ac450c1dd483f58134d0dec4b4713622bfd393";const key="perception/results/"+sha+"-human-audit-20261007-0035.json";const o=await env.BENCHMARK_R2.get(key);if(!o)throw new Error("real result missing");const d=JSON.parse(await o.text());const groups=d.layout?.groups||[];const W=Number(d.input?.width)||2048,H=Number(d.input?.height)||1409;const wanted=[{region_id:"region-13",label:"not_playable_card",role:"day_hour_hud",provenance:"user_correction"},{region_id:"region-22",label:"playable_card",role:"item",entity_id:"bazaar:item:stained-glass-window",provenance:"user_correction"}];const examples=wanted.map(w=>{const rr=(d.regions||[]).find(x=>(x.region_id||x.id)===w.region_id);if(!rr)throw new Error("real region missing "+w.region_id);return {...w,bbox:rr.bbox,features:featureRow(rr,groups,W,H)};});const out={schema_version:1,dataset_version:"playable-card-gate-v1",screenshot_sha256:sha,input:d.input,pipeline_version:d.pipeline_version,examples,semantic_promotion_allowed:false};const outKey="benchmarks/playable-card-gate-v1/real-hard-examples/"+sha+".json";await env.BENCHMARK_R2.put(outKey,JSON.stringify(out),{httpMetadata:{contentType:"application/json; charset=utf-8",cacheControl:"private, max-age=0"},customMetadata:{artifact:"playable-card-gate-real-hard-examples",dataset_version:"playable-card-gate-v1",positive_count:"1",negative_count:"1",pipeline_version:String(d.pipeline_version||"")}});return {ok:true,artifact_key:outKey,examples:examples.map(x=>({region_id:x.region_id,label:x.label,role:x.role,support_count:x.features.support_count,proposal_source:x.features.proposal_source}))};}
function stat(v){const a=v.filter(Number.isFinite).sort((x,y)=>x-y);if(!a.length)return {n:0,min:null,p10:null,median:null,p90:null,max:null};const q=p=>a[Math.min(a.length-1,Math.max(0,Math.floor((a.length-1)*p)))];return {n:a.length,min:a[0],p10:q(.1),median:q(.5),p90:q(.9),max:a[a.length-1]};}
async function aggregateDataset(env){const examples=[];let cursor;do{const l=await env.BENCHMARK_R2.list({prefix:"benchmarks/playable-card-gate-v1/raw/",cursor,limit:1000});for(const it of l.objects){const o=await env.BENCHMARK_R2.get(it.key);if(!o)continue;try{const d=JSON.parse(await o.text());for(const r of d.regions||[]){if(r.label==="playable_card")examples.push({label:"playable_card",source:"synthetic_truth",case_id:d.case_id,region_id:r.region_id,features:r.features});else if(r.label==="non_item_object_negative"||r.label==="background_or_ui_negative")examples.push({label:"not_playable_card",source:"synthetic_truth",case_id:d.case_id,region_id:r.region_id,negative_kind:r.label,features:r.features});}}catch{}}cursor=l.truncated?l.cursor:undefined;}while(cursor);let rcursor;do{const l=await env.BENCHMARK_R2.list({prefix:"benchmarks/playable-card-gate-v1/real-hard-examples/",cursor:rcursor,limit:1000});for(const it of l.objects){const o=await env.BENCHMARK_R2.get(it.key);if(!o)continue;try{const d=JSON.parse(await o.text());for(const x of d.examples||[])examples.push({label:x.label==="playable_card"?"playable_card":"not_playable_card",source:"real_user_corrected",case_id:d.screenshot_sha256,region_id:x.region_id,negative_kind:x.role,features:x.features});}catch{}}rcursor=l.truncated?l.cursor:undefined;}while(rcursor);const pos=examples.filter(x=>x.label==="playable_card"),neg=examples.filter(x=>x.label==="not_playable_card");const numeric=["support_count","proposal_score","aspect_ratio","area_fraction","x_fraction","y_fraction","width_fraction","height_fraction","group_count","max_group_size","min_group_spacing_cv","min_group_width_cv","min_group_height_cv","max_repeat_recovered_fraction","max_group_mean_support"];const distributions={};for(const k of numeric)distributions[k]={positive:stat(pos.map(x=>Number(x.features?.[k]))),negative:stat(neg.map(x=>Number(x.features?.[k])))};const bySource={};for(const x of examples){const s=x.features?.proposal_source||"unknown";bySource[s]??={playable_card:0,not_playable_card:0};bySource[s][x.label]++;}const byCohort={};for(const x of examples){const s=x.features?.cohort||"unknown";byCohort[s]??={playable_card:0,not_playable_card:0};byCohort[s][x.label]++;}const summary={schema_version:1,dataset_version:"playable-card-gate-v1",example_count:examples.length,positive_count:pos.length,negative_count:neg.length,real_example_count:examples.filter(x=>x.source==="real_user_corrected").length,by_proposal_source:bySource,by_cohort:byCohort,distributions,semantic_promotion_allowed:false};const outKey="benchmarks/playable-card-gate-v1/summary.json";await env.BENCHMARK_R2.put(outKey,JSON.stringify(summary),{httpMetadata:{contentType:"application/json; charset=utf-8",cacheControl:"private, max-age=0"},customMetadata:{artifact:"playable-card-gate-dataset-summary",dataset_version:"playable-card-gate-v1",examples:String(examples.length),positives:String(pos.length),negatives:String(neg.length),real_examples:String(summary.real_example_count)}});return {ok:true,artifact_key:outKey,example_count:examples.length,positive_count:pos.length,negative_count:neg.length,real_example_count:summary.real_example_count,by_proposal_source:bySource,by_cohort:byCohort};}
async function loadGateExamples(env){const examples=[];let cursor;do{const l=await env.BENCHMARK_R2.list({prefix:"benchmarks/playable-card-gate-v1/raw/",cursor,limit:1000});for(const it of l.objects){const o=await env.BENCHMARK_R2.get(it.key);if(!o)continue;try{const d=JSON.parse(await o.text());for(const r of d.regions||[]){if(r.label==="playable_card")examples.push({y:1,source:"synthetic_truth",case_id:d.case_id,region_id:r.region_id,f:r.features});else if(r.label==="non_item_object_negative"||r.label==="background_or_ui_negative")examples.push({y:0,source:"synthetic_truth",case_id:d.case_id,region_id:r.region_id,f:r.features});}}catch{}}cursor=l.truncated?l.cursor:undefined;}while(cursor);let rc;do{const l=await env.BENCHMARK_R2.list({prefix:"benchmarks/playable-card-gate-v1/real-hard-examples/",cursor:rc,limit:1000});for(const it of l.objects){const o=await env.BENCHMARK_R2.get(it.key);if(!o)continue;try{const d=JSON.parse(await o.text());for(const x of d.examples||[])examples.push({y:x.label==="playable_card"?1:0,source:"real_user_corrected",case_id:d.screenshot_sha256,region_id:x.region_id,f:x.features});}catch{}}rc=l.truncated?l.cursor:undefined;}while(rc);return examples;}
function leafStats(rows){const p=rows.filter(r=>r.y===1).length,n=rows.length-p;return {positive:p,negative:n,prediction:p>0?1:0,loss:p>0?n:0};}
function candidateSplits(rows){const numeric=["support_count","proposal_score","aspect_ratio","area_fraction","x_fraction","y_fraction","width_fraction","height_fraction","group_count","max_group_size","min_group_spacing_cv","min_group_width_cv","min_group_height_cv","max_repeat_recovered_fraction","max_group_mean_support"];const categorical=["proposal_source","cohort","geometry_class","current_item_route"];const out=[];for(const k of numeric){const vals=[...new Set(rows.map(r=>Number(r.f?.[k])).filter(Number.isFinite))].sort((a,b)=>a-b);for(let i=0;i<vals.length-1;i++)out.push({kind:"numeric",feature:k,threshold:(vals[i]+vals[i+1])/2});}for(const k of categorical){const vals=[...new Set(rows.map(r=>String(r.f?.[k]??"__missing__")))];for(const v of vals)out.push({kind:"categorical",feature:k,value:v});}return out;}
function side(row,s){if(s.kind==="numeric"){const v=Number(row.f?.[s.feature]);return Number.isFinite(v)&&v<=s.threshold;}return String(row.f?.[s.feature]??"__missing__")===s.value;}
function buildTree(rows,depth=0,maxDepth=4){const base=leafStats(rows);if(depth>=maxDepth||base.positive===0||base.negative===0)return {type:"leaf",...base};let best=null;for(const s of candidateSplits(rows)){const left=[],right=[];for(const r of rows)(side(r,s)?left:right).push(r);if(!left.length||!right.length)continue;const loss=leafStats(left).loss+leafStats(right).loss;if(loss<base.loss&&(best===null||loss<best.loss))best={s,left,right,loss};}if(!best)return {type:"leaf",...base};return {type:"split",split:best.s,training:{positive:base.positive,negative:base.negative,loss_before:base.loss,loss_after:best.loss},left:buildTree(best.left,depth+1,maxDepth),right:buildTree(best.right,depth+1,maxDepth)};}
function predictTree(tree,row){let n=tree;while(n.type==="split")n=side(row,n.split)?n.left:n.right;return n.prediction===1?1:0;}
function metricsFor(tree,rows){let tp=0,tn=0,fp=0,fn=0;for(const r of rows){const p=predictTree(tree,r);if(r.y===1&&p===1)tp++;else if(r.y===0&&p===0)tn++;else if(r.y===0)fp++;else fn++;}return {count:rows.length,tp,tn,fp,fn,recall:tp+fn?tp/(tp+fn):null,specificity:tn+fp?tn/(tn+fp):null};}
async function fitGateShadow(env){const all=await loadGateExamples(env);const synthetic=all.filter(r=>r.source==="synthetic_truth"),real=all.filter(r=>r.source==="real_user_corrected");const diagnosticTree=buildTree(synthetic,0,4);const calibratedTree=buildTree(all,0,4);const realRows=real.map(r=>({case_id:r.case_id,region_id:r.region_id,truth:r.y,prediction:predictTree(diagnosticTree,r)}));const record={schema_version:1,model_version:"playable-card-gate-shadow-v1",dataset_version:"playable-card-gate-v1",training_policy:"depth4_zero_training_false_negative_tree; synthetic-only diagnostic, all-evidence calibrated shadow",semantic_promotion_allowed:false,synthetic_only:{metrics:metricsFor(diagnosticTree,synthetic),tree:diagnosticTree,real_holdout:metricsFor(diagnosticTree,real),real_holdout_rows:realRows},calibrated_shadow:{metrics:metricsFor(calibratedTree,all),tree:calibratedTree}};const key="benchmarks/playable-card-gate-v1/model-shadow.json";await env.BENCHMARK_R2.put(key,JSON.stringify(record),{httpMetadata:{contentType:"application/json; charset=utf-8",cacheControl:"private, max-age=0"},customMetadata:{artifact:"playable-card-gate-shadow-model",model_version:"playable-card-gate-shadow-v1",synthetic_examples:String(synthetic.length),real_holdout_examples:String(real.length),synthetic_recall:String(record.synthetic_only.metrics.recall),synthetic_specificity:String(record.synthetic_only.metrics.specificity),real_holdout_recall:String(record.synthetic_only.real_holdout.recall),real_holdout_specificity:String(record.synthetic_only.real_holdout.specificity),calibrated_recall:String(record.calibrated_shadow.metrics.recall),calibrated_specificity:String(record.calibrated_shadow.metrics.specificity)}});return {ok:true,artifact_key:key,synthetic:record.synthetic_only.metrics,real_holdout:record.synthetic_only.real_holdout,real_holdout_rows:realRows,calibrated:record.calibrated_shadow.metrics};}
function candidateSplitsStructural(rows){const numeric=["support_count","proposal_score","aspect_ratio","group_count","max_group_size","min_group_spacing_cv","min_group_width_cv","min_group_height_cv","max_repeat_recovered_fraction","max_group_mean_support"];const categorical=["proposal_source","geometry_class"];const out=[];for(const k of numeric){const vals=[...new Set(rows.map(r=>Number(r.f?.[k])).filter(Number.isFinite))].sort((a,b)=>a-b);for(let i=0;i<vals.length-1;i++)out.push({kind:"numeric",feature:k,threshold:(vals[i]+vals[i+1])/2});}for(const k of categorical){const vals=[...new Set(rows.map(r=>String(r.f?.[k]??"__missing__")))];for(const v of vals)out.push({kind:"categorical",feature:k,value:v});}return out;}
function buildTreeStructural(rows,depth=0,maxDepth=4){const base=leafStats(rows);if(depth>=maxDepth||base.positive===0||base.negative===0)return {type:"leaf",...base};let best=null;for(const s of candidateSplitsStructural(rows)){const left=[],right=[];for(const r of rows)(side(r,s)?left:right).push(r);if(!left.length||!right.length)continue;const loss=leafStats(left).loss+leafStats(right).loss;if(loss<base.loss&&(best===null||loss<best.loss))best={s,left,right,loss};}if(!best)return {type:"leaf",...base};return {type:"split",split:best.s,training:{positive:base.positive,negative:base.negative,loss_before:base.loss,loss_after:best.loss},left:buildTreeStructural(best.left,depth+1,maxDepth),right:buildTreeStructural(best.right,depth+1,maxDepth)};}
async function fitGateStructuralShadow(env){const all=await loadGateExamples(env);const synthetic=all.filter(r=>r.source==="synthetic_truth"),real=all.filter(r=>r.source==="real_user_corrected");const diagnosticTree=buildTreeStructural(synthetic,0,4);const calibratedTree=buildTreeStructural(all,0,4);const realRows=real.map(r=>({case_id:r.case_id,region_id:r.region_id,truth:r.y,prediction:predictTree(diagnosticTree,r),support_count:r.f?.support_count??null,proposal_source:r.f?.proposal_source??null,aspect_ratio:r.f?.aspect_ratio??null,group_count:r.f?.group_count??null,max_group_size:r.f?.max_group_size??null,max_repeat_recovered_fraction:r.f?.max_repeat_recovered_fraction??null}));const rec={schema_version:1,model_version:"playable-card-gate-structural-shadow-v1",dataset_version:"playable-card-gate-v1",feature_policy:"no absolute screen position, width, height, or area; structural detector evidence only",semantic_promotion_allowed:false,synthetic_only:{metrics:metricsFor(diagnosticTree,synthetic),tree:diagnosticTree,real_holdout:metricsFor(diagnosticTree,real),real_holdout_rows:realRows},calibrated_shadow:{metrics:metricsFor(calibratedTree,all),tree:calibratedTree}};const key="benchmarks/playable-card-gate-v1/model-structural-shadow.json";await env.BENCHMARK_R2.put(key,JSON.stringify(rec),{httpMetadata:{contentType:"application/json; charset=utf-8",cacheControl:"private, max-age=0"},customMetadata:{artifact:"playable-card-gate-structural-shadow-model",model_version:rec.model_version,synthetic_examples:String(synthetic.length),real_holdout_examples:String(real.length),synthetic_recall:String(rec.synthetic_only.metrics.recall),synthetic_specificity:String(rec.synthetic_only.metrics.specificity),real_holdout_recall:String(rec.synthetic_only.real_holdout.recall),real_holdout_specificity:String(rec.synthetic_only.real_holdout.specificity),real_rows:JSON.stringify(realRows).slice(0,950),calibrated_recall:String(rec.calibrated_shadow.metrics.recall),calibrated_specificity:String(rec.calibrated_shadow.metrics.specificity)}});return {ok:true,artifact_key:key,synthetic:rec.synthetic_only.metrics,real_holdout:rec.synthetic_only.real_holdout,real_rows:realRows,calibrated:rec.calibrated_shadow.metrics};}
function candidateSplitsVisualStructural(rows){const numeric=["support_count","proposal_score","aspect_ratio","group_count","max_group_size","min_group_spacing_cv","min_group_width_cv","min_group_height_cv","max_repeat_recovered_fraction","max_group_mean_support","item_class_score","best_non_item_class_score","item_class_advantage","item_class_candidate_rank"];const categorical=["proposal_source","geometry_class","best_non_item_class"];const out=[];for(const k of numeric){const vals=[...new Set(rows.map(r=>Number(r.f?.[k])).filter(Number.isFinite))].sort((a,b)=>a-b);for(let i=0;i<vals.length-1;i++)out.push({kind:"numeric",feature:k,threshold:(vals[i]+vals[i+1])/2});}for(const k of categorical){const vals=[...new Set(rows.map(r=>String(r.f?.[k]??"__missing__")))];for(const v of vals)out.push({kind:"categorical",feature:k,value:v});}return out;}
function buildTreeVisualStructural(rows,depth=0,maxDepth=5){const base=leafStats(rows);if(depth>=maxDepth||base.positive===0||base.negative===0)return {type:"leaf",...base};let best=null;for(const s of candidateSplitsVisualStructural(rows)){const left=[],right=[];for(const r of rows)(side(r,s)?left:right).push(r);if(!left.length||!right.length)continue;const loss=leafStats(left).loss+leafStats(right).loss;if(loss<base.loss&&(best===null||loss<best.loss))best={s,left,right,loss};}if(!best)return {type:"leaf",...base};return {type:"split",split:best.s,training:{positive:base.positive,negative:base.negative,loss_before:base.loss,loss_after:best.loss},left:buildTreeVisualStructural(best.left,depth+1,maxDepth),right:buildTreeVisualStructural(best.right,depth+1,maxDepth)};}
function gateCaseBucket(caseId){let h=2166136261;for(let i=0;i<caseId.length;i++){h^=caseId.charCodeAt(i);h=Math.imul(h,16777619);}return (h>>>0)%5;}
async function fitGateVisualStructuralShadow(env){const all=await loadGateExamples(env);const hasNew=r=>Object.prototype.hasOwnProperty.call(r.f||{},"item_class_score");const synthetic=all.filter(r=>r.source==="synthetic_truth"&&hasNew(r));const real=all.filter(r=>r.source==="real_user_corrected"&&hasNew(r));const train=synthetic.filter(r=>gateCaseBucket(r.case_id)!==0);const validation=synthetic.filter(r=>gateCaseBucket(r.case_id)===0);if(!train.length)throw new Error("no synthetic training examples");if(!validation.length)throw new Error("no synthetic validation examples");const tree=buildTreeVisualStructural(train,0,5);const realRows=real.map(r=>({case_id:r.case_id,region_id:r.region_id,truth:r.y,prediction:predictTree(tree,r),support_count:r.f?.support_count??null,proposal_source:r.f?.proposal_source??null,aspect_ratio:r.f?.aspect_ratio??null,group_count:r.f?.group_count??null,item_class_score:r.f?.item_class_score??null,best_non_item_class_score:r.f?.best_non_item_class_score??null,item_class_advantage:r.f?.item_class_advantage??null,best_non_item_class:r.f?.best_non_item_class??null}));const trainCases=[...new Set(train.map(r=>r.case_id))].sort();const validationCases=[...new Set(validation.map(r=>r.case_id))].sort();const rec={schema_version:2,model_version:"playable-card-gate-visual-structural-shadow-v2-case-holdout",dataset_version:"playable-card-gate-v1",split_policy:"deterministic case-level FNV1a bucket mod 5; bucket 0 validation",feature_policy:"structural detector evidence plus semantic-class visual evidence; no candidate identity/name; no absolute position/size",semantic_promotion_allowed:false,synthetic_only:{tree,train_metrics:metricsFor(tree,train),validation_metrics:metricsFor(tree,validation),train_case_count:trainCases.length,validation_case_count:validationCases.length,train_cases:trainCases,validation_cases:validationCases,real_holdout:metricsFor(tree,real),real_holdout_rows:realRows}};const key="benchmarks/playable-card-gate-v1/model-visual-structural-shadow.json";await env.BENCHMARK_R2.put(key,JSON.stringify(rec),{httpMetadata:{contentType:"application/json; charset=utf-8",cacheControl:"private, max-age=0"},customMetadata:{artifact:"playable-card-gate-visual-structural-shadow-model",model_version:rec.model_version,synthetic_examples:String(synthetic.length),train_examples:String(train.length),validation_examples:String(validation.length),train_cases:String(trainCases.length),validation_cases:String(validationCases.length),train_recall:String(rec.synthetic_only.train_metrics.recall),train_specificity:String(rec.synthetic_only.train_metrics.specificity),validation_recall:String(rec.synthetic_only.validation_metrics.recall),validation_specificity:String(rec.synthetic_only.validation_metrics.specificity),real_holdout_recall:String(rec.synthetic_only.real_holdout.recall),real_holdout_specificity:String(rec.synthetic_only.real_holdout.specificity),real_rows:JSON.stringify(realRows).slice(0,950)}});return {ok:true,artifact_key:key,model_version:rec.model_version,train:rec.synthetic_only.train_metrics,validation:rec.synthetic_only.validation_metrics,train_case_count:trainCases.length,validation_case_count:validationCases.length,real_holdout:rec.synthetic_only.real_holdout,real_rows:realRows};}
async function scoreRealScreenShadow(env){const sha="5a4e9b43b05b2fd6f998cf2725ac450c1dd483f58134d0dec4b4713622bfd393";const [mo,ro]=await Promise.all([env.BENCHMARK_R2.get("benchmarks/playable-card-gate-v1/model-visual-structural-shadow.json"),env.BENCHMARK_R2.get("perception/results/"+sha+"-human-audit-20261007-0035.json")]);if(!mo||!ro)throw new Error("model or real result missing");const model=JSON.parse(await mo.text());const d=JSON.parse(await ro.text());const tree=model.synthetic_only?.tree;if(!tree)throw new Error("synthetic-only tree missing");const groups=d.layout?.groups||[];const W=Number(d.input?.width)||2048,H=Number(d.input?.height)||1409;const rows=(d.regions||[]).filter(r=>validBox(r.bbox)).map(r=>{const features=featureRow(r,groups,W,H);return {region_id:r.region_id||r.id||null,bbox:r.bbox,prediction:predictTree(tree,{f:features}),features};});const selected=rows.filter(r=>r.prediction===1),rejected=rows.filter(r=>r.prediction===0);const byId=Object.fromEntries(rows.map(r=>[r.region_id,r.prediction]));const out={schema_version:1,evaluation_version:"playable-card-gate-real-screen-shadow-v1",model_version:model.model_version,screenshot_sha256:sha,pipeline_version:d.pipeline_version,semantic_promotion_allowed:false,total_regions:rows.length,selected_count:selected.length,rejected_count:rejected.length,known_holdout_checks:{hud_region_13:{expected:0,prediction:byId["region-13"]??null,passed:byId["region-13"]===0},stained_glass_region_22:{expected:1,prediction:byId["region-22"]??null,passed:byId["region-22"]===1}},selected_region_ids:selected.map(r=>r.region_id),rejected_region_ids:rejected.map(r=>r.region_id),rows};const key="benchmarks/playable-card-gate-v1/real-screen-shadow/"+sha+".json";await env.BENCHMARK_R2.put(key,JSON.stringify(out),{httpMetadata:{contentType:"application/json; charset=utf-8",cacheControl:"private, max-age=0"},customMetadata:{artifact:"playable-card-gate-real-screen-shadow",evaluation_version:out.evaluation_version,model_version:String(model.model_version||""),total_regions:String(rows.length),selected_count:String(selected.length),rejected_count:String(rejected.length),hud_region_13_prediction:String(byId["region-13"]??""),stained_glass_region_22_prediction:String(byId["region-22"]??""),known_checks_passed:String(out.known_holdout_checks.hud_region_13.passed&&out.known_holdout_checks.stained_glass_region_22.passed),selected_ids:JSON.stringify(selected.map(r=>r.region_id)).slice(0,900)}});return {ok:true,artifact_key:key,total_regions:rows.length,selected_count:selected.length,rejected_count:rejected.length,selected_region_ids:selected.map(r=>r.region_id),known_holdout_checks:out.known_holdout_checks};}
export default{async fetch(request,env){const u=new URL(request.url);if(u.pathname==="/health")return Response.json({ok:true,dataset_version:"playable-card-gate-v1"});if(u.pathname==="/run"){try{const caseId=(u.searchParams.get("case")||"").trim();return Response.json(await analyzeCase(env,caseId),{headers:{"cache-control":"no-store"}});}catch(e){return Response.json({ok:false,error:e instanceof Error?e.message:String(e)},{status:422});}}return Response.json({ok:false,error:"not_found"},{status:404});},async queue(batch,env){for(const m of batch.messages){const c=String(m.body?.case_id||"");try{let out;if(m.body?.kind==="ingest_real")out=await ingestRealHardExamples(env);else if(m.body?.kind==="aggregate")out=await aggregateDataset(env);else if(m.body?.kind==="fit")out=await fitGateShadow(env);else if(m.body?.kind==="fit_structural")out=await fitGateStructuralShadow(env);else if(m.body?.kind==="fit_visual_structural")out=await fitGateVisualStructuralShadow(env);else if(m.body?.kind==="score_real")out=await scoreRealScreenShadow(env);else out=await analyzeCase(env,c);console.log("CARD_GATE_CALIBRATION",JSON.stringify(out));}catch(e){const detail=e instanceof Error?e.message:String(e);console.error("CARD_GATE_CALIBRATION_ERROR",JSON.stringify({case_id:c,kind:m.body?.kind||"case",error:detail}));try{await env.BENCHMARK_R2.put("debug/card-gate-calibrator/"+(c||String(m.body?.kind||"unknown"))+".json",JSON.stringify({case_id:c,kind:m.body?.kind||"case",error:detail,at:new Date().toISOString()}),{httpMetadata:{contentType:"application/json"},customMetadata:{artifact:"card-gate-calibrator-error",case_id:c,detail:detail.slice(0,900)}});}catch{}}finally{m.ack();}}}};
