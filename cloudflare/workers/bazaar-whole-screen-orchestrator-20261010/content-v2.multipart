Content-Disposition: form-data; name="worker.js"; filename="worker.js"
Content-Type: application/javascript+module


function iou(a,b){const x1=Math.max(a.x,b.x),y1=Math.max(a.y,b.y),x2=Math.min(a.x+a.width,b.x+b.width),y2=Math.min(a.y+a.height,b.y+b.height),w=Math.max(0,x2-x1),h=Math.max(0,y2-y1),inter=w*h,u=a.width*a.height+b.width*b.height-inter;return u>0?inter/u:0;}
function nameOf(path){const s=String(path||"").split("/").pop()||"";return s.replace(/.[^.]+$/,"");}
async function run(env){const rows=[];for(let start=0;start<24;start+=4){const batch=[];for(let i=start;i<Math.min(24,start+4);i++){const req=new Request("https://proof.internal/tile2-4c1f9a70-"+i,{headers:{"cache-control":"no-store"}});batch.push(env.PROOF.fetch(req).then(async r=>({tile:i,status:r.status,data:r.ok?await r.json():{error:await r.text()}})).catch(e=>({tile:i,status:0,data:{error:String(e)}})));}rows.push(...await Promise.all(batch));}
const accepted=[];for(const r of rows)for(const a of (r.data?.accepted||[]))accepted.push({...a,tile_index:r.tile,name:nameOf(a.asset_path)});
accepted.sort((a,b)=>(b.transform?.inlier_count||0)-(a.transform?.inlier_count||0)||(a.transform?.mean_hamming??999)-(b.transform?.mean_hamming??999)||(a.transform?.mean_residual??999)-(b.transform?.mean_residual??999));
const merged=[];for(const a of accepted){const hit=merged.find(m=>m.name===a.name&&m.bbox&&a.bbox&&iou(m.bbox,a.bbox)>=0.45);if(hit){hit.support++;hit.tiles.push(a.tile_index);hit.members.push(a);if((a.transform?.inlier_count||0)>(hit.best.transform?.inlier_count||0)||((a.transform?.inlier_count||0)===(hit.best.transform?.inlier_count||0)&&(a.transform?.mean_hamming??999)<(hit.best.transform?.mean_hamming??999)))hit.best=a;}else merged.push({name:a.name,support:1,tiles:[a.tile_index],bbox:a.bbox,best:a,members:[a]});}
return {schema_version:1,orchestrator_version:"whole-screen-reference-orchestrator-v2-service-binding",tile_count:rows.length,tile_failures:rows.filter(r=>r.status!==200).map(r=>({tile:r.tile,status:r.status,error:r.data?.error||null})),raw_accept_count:accepted.length,merged_detection_count:merged.length,detections:merged.map(m=>({name:m.name,support:m.support,tiles:m.tiles,bbox:m.best.bbox,inliers:m.best.transform?.inlier_count||0,mean_hamming:m.best.transform?.mean_hamming??null,mean_residual:m.best.transform?.mean_residual??null,shard_index:m.best.shard_index}))};}
export default {async fetch(req,env){const u=new URL(req.url);if(u.pathname!=="/run")return new Response("not found",{status:404});try{return new Response(JSON.stringify(await run(env)),{headers:{"content-type":"application/json","cache-control":"no-store"}});}catch(e){return new Response(JSON.stringify({error:e instanceof Error?e.message:String(e)}),{status:500,headers:{"content-type":"application/json"}});}}};

