async function callRunner(env,shard,payload){const id=env.PERCEPTION_RUNNER.idFromName(shard),stub=env.PERCEPTION_RUNNER.get(id),res=await stub.fetch("https://perception-runner.internal/item-visual-search-index-one",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify(payload)}),text=await res.text();let json={};try{json=JSON.parse(text);}catch{}return {status:res.status,ok:res.ok,text,json};}export default {async queue(batch,env){for(const m of batch.messages){const b=m.body||{},requestedOffset=Math.max(0,Math.floor(Number(b.offset)||0)),assetPath=String(b.asset_path||""),out=String(b.output_key||"");try{let primary,png=null;if(assetPath){primary=await callRunner(env,"perception-item-index-path-map",{offset:requestedOffset,asset_path:assetPath,limit:1});const mapped=Number(primary.json?.offset);if(Number.isFinite(mapped)&&mapped>=0){png=await callRunner(env,"perception-item-index-"+Math.floor(mapped/32),{offset:mapped,asset_path:"",limit:1});}}else{primary=await callRunner(env,"perception-item-index-"+Math.floor(requestedOffset/32),{offset:requestedOffset,asset_path:"",limit:1});}const payload=assetPath?{asset_path:assetPath,path_result:primary.json,png_result:png?.json??null}:{offset:requestedOffset,result:primary.json};const mappedOffset=assetPath?Number(primary.json?.offset):requestedOffset;const pngJson=assetPath?(png?.json??{}):primary.json;const finalStatus=assetPath?(png?.status??primary.status):primary.status,finalOk=assetPath?(png?.ok??primary.ok):primary.ok;if(out)await env.BENCHMARK_R2.put(out,JSON.stringify(payload),{httpMetadata:{contentType:"application/json"},customMetadata:{artifact:"normalization-gap-call-v2",requested_offset:String(requestedOffset),asset_path:assetPath,mapped_offset:Number.isFinite(mappedOffset)?String(mappedOffset):"",status:String(finalStatus),ok:String(finalOk),path_uploaded:String(primary.json?.uploaded??""),path_failure_count:String(Array.isArray(primary.json?.failures)?primary.json.failures.length:""),png_uploaded:String(pngJson?.uploaded??""),png_failure_count:String(Array.isArray(pngJson?.failures)?pngJson.failures.length:""),png_failure_details:JSON.stringify(Array.isArray(pngJson?.failures)?pngJson.failures.slice(0,3):[]).slice(0,1500),detail:String(pngJson?.detail??primary.json?.detail??"").slice(0,500)}});}catch(e){if(out)await env.BENCHMARK_R2.put(out,JSON.stringify({requestedOffset,assetPath,error:e instanceof Error?e.message:String(e)}),{httpMetadata:{contentType:"application/json"},customMetadata:{artifact:"normalization-gap-call-v2",requested_offset:String(requestedOffset),asset_path:assetPath,error:e instanceof Error?e.message:String(e)}});}m.ack();}}};
