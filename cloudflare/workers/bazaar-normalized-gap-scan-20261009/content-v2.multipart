const SNAP="catalogue/visual-catalogue-screen-native-native-v2.json";const GAP="debug/whole-screen-local-feature-bank-v1/normalized-gaps/";export default {async queue(batch,env){for(const m of batch.messages){const b=m.body||{},offset=Math.max(0,Number(b.offset)||0),limit=Math.max(1,Math.min(200,Number(b.limit)||100)),out=String(b.output_key||"");try{const o=await env.BENCHMARK_R2.get(SNAP);if(!o)throw new Error("snapshot missing");const s=JSON.parse(await new Response(o.body).text()),rows=(s.fingerprints||[]).filter(r=>/\/items\//i.test(String(r.asset_path||""))&&r.source_sha256),sel=rows.slice(offset,offset+limit),missing=[];for(let j=0;j<sel.length;j++){const r=sel[j],index=offset+j,key="catalogue/item-visual-normalized-v1/"+r.source_sha256+".png";const h=await env.BENCHMARK_R2.head(key);if(!h){const rec={index,asset_path:r.asset_path,source_sha256:r.source_sha256};missing.push(rec);await env.BENCHMARK_R2.put(GAP+"ref-"+String(index).padStart(4,"0")+".json",JSON.stringify(rec),{httpMetadata:{contentType:"application/json"},customMetadata:{artifact:"normalized-gap-ref",index:String(index),asset_path:r.asset_path,source_sha256:r.source_sha256}});}}await env.BENCHMARK_R2.put(out,JSON.stringify({offset,limit,attempted:sel.length,total:rows.length,missing_count:missing.length}),{httpMetadata:{contentType:"application/json"},customMetadata:{artifact:"normalized-gap-scan",offset:String(offset),attempted:String(sel.length),missing_count:String(missing.length)}});}catch(e){await env.BENCHMARK_R2.put(out,JSON.stringify({error:e instanceof Error?e.message:String(e)}),{httpMetadata:{contentType:"application/json"},customMetadata:{artifact:"normalized-gap-scan",error:e instanceof Error?e.message:String(e)}});}m.ack();}}};
