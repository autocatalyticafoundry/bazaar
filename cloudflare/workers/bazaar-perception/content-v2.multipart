function pRegisterRow(image,boxes){
 let bestDx=0,bestDy=0,best=-Infinity,bestDist=Infinity;
 for(let dy=-P_V30_REG_RADIUS;dy<=P_V30_REG_RADIUS;dy+=P_V30_REG_STEP)for(let dx=-P_V30_REG_RADIUS;dx<=P_V30_REG_RADIUS;dx+=P_V30_REG_STEP){
  let total=0,ok=true;for(const b of boxes){const s=pBoundary(image,{...b,x:b.x+dx,y:b.y+dy});if(!Number.isFinite(s)){ok=false;break}total+=s}
  if(!ok)continue;const score=total/boxes.length,dist=Math.abs(dx)+Math.abs(dy);if(score>best||(score===best&&dist<bestDist)){best=score;bestDx=dx;bestDy=dy;bestDist=dist}
