function pDown(image,box,w,h){
 const o=new Uint8Array(w*h*3),n=4;
 for(let ty=0;ty<h;ty++)for(let tx=0;tx<w;tx++){let rr=0,gg=0,bb=0;
  for(let sy=0;sy<n;sy++)for(let sx=0;sx<n;sx++){
   const x=Math.max(0,Math.min(image.width-1,Math.floor(box.x+(tx+(sx+.5)/n)*box.width/w)));
   const y=Math.max(0,Math.min(image.height-1,Math.floor(box.y+(ty+(sy+.5)/n)*box.height/h)));
   const k=(y*image.width+x)*4;rr+=image.data[k];gg+=image.data[k+1];bb+=image.data[k+2]
  }
  const k=(ty*w+tx)*3;o[k]=Math.round(rr/16);o[k+1]=Math.round(gg/16);o[k+2]=Math.round(bb/16)
 }
 return o
}
function pFP(image,box){
 const rgb=pDown(image,box,16,16);let r=0,g=0,b=0;for(let i=0;i<rgb.length;i+=3){r+=rgb[i];g+=rgb[i+1];b+=rgb[i+2]}
 const a=pDown(image,box,8,8),ag=[];for(let i=0;i<a.length;i+=3)ag.push(gray(a[i],a[i+1],a[i+2]));const avg=ag.reduce((s,v)=>s+v,0)/ag.length,ah=pBits(ag.map(v=>v>=avg));
