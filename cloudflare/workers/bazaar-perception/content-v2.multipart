 for(const bw of ws)for(const bh of hs){const r=bw/bh;if(r<.45||r>2.2)continue;const band=Math.max(1,Math.min(3,Math.round(Math.min(bw,bh)*.06))),step=Math.max(2,Math.round(Math.min(bw,bh)/6));
