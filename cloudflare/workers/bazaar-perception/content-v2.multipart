function pDetectV30Row(image){
 if(image.width<900||image.height<500)return{detected:false,reason:"image_too_small",boxes:[]};
 const base=Math.min(image.width/1920,image.height/1080),factors=[.85,1,1.15],tries=[];
 for(const f of factors){const scale=base*f,w=Math.max(120,Math.round(300*scale)),h=Math.max(160,Math.round(400*scale));try{const r=pDetectRowScale(image,w,h);if(r)tries.push({...r,scale})}catch{}}
 if(!tries.length)return{detected:false,reason:"no_row_candidate",boxes:[]};
 tries.sort((a,b)=>b.boundary_score-a.boundary_score||b.row_objective-a.row_objective);const best=tries[0],accepted=Number.isFinite(best.boundary_score)&&best.boundary_score>=45;
 return{detected:accepted,reason:accepted?"accepted":"weak_boundary_evidence",boxes:accepted?best.boxes:[],boundary_score:best.boundary_score,row_objective:best.row_objective,horizontal_boundary_score:best.horizontal_boundary_score,best_dx:best.best_dx,best_dy:best.best_dy,scale:best.scale,card_width:best.card_width,card_height:best.card_height,candidate_count:tries.length}
