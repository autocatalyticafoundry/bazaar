 for(let spacing=min;spacing<=max;spacing++){const last=xw.length-1-half-spacing*(P_V30_COUNT-1);for(let start=half;start<=last;start++){const centers=Array.from({length:P_V30_COUNT},(_,i)=>start+i*spacing),vals=centers.map(c=>xw[c]||0);if(vals.some(v=>!Number.isFinite(v)||v<=0))continue;let gt=0,gn=0,valid=true;for(let i=0;i<centers.length-1;i++){const a=Math.ceil(centers[i]+ww/2)+1,b=Math.floor(centers[i+1]-ww/2)-1;if(b-a+1<2){valid=false;break}for(let x=a;x<=b;x++){gt+=col[x]||0;gn++}}if(!valid||!gn)continue;const total=vals.reduce((s,v)=>s+v,0),floor=Math.min(...vals),cm=total/(P_V30_COUNT*ww),fm=floor/ww,gm=gt/gn,rc=(centers[0]+centers[centers.length-1])/2,pen=Math.abs(rc-P_V30_AW/2)/P_V30_AW*bg*.1,obj=cm+fm*.35-gm*.8-pen;if(!best||obj>best.objective)best={centers,objective:obj}}}
 if(!best)return null;
 const lefts=best.centers.map(c=>Math.round(c*sx-cardW/2));let topBest=0,topScore=-Infinity;
 for(let top=4;top+cardH<image.height-4;top+=2){let ts=0,bs=0,n=0;for(const left of lefts)for(let x=left+Math.round(cardW*.12);x<=left+cardW-Math.round(cardW*.12);x+=8){ts+=Math.abs(pIntensity(image,x,top-3)-pIntensity(image,x,top+3));bs+=Math.abs(pIntensity(image,x,top+cardH-3)-pIntensity(image,x,top+cardH+3));n++}if(!n)continue;const tm=ts/n,bm=bs/n,score=tm+bm+Math.min(tm,bm)*.75;if(score>topScore){topScore=score;topBest=top}}
 if(!Number.isFinite(topScore))return null;
 const boxes=best.centers.map(c=>({x:Math.round(c*sx-cardW/2),y:Math.round(topBest),width:cardW,height:cardH}));
