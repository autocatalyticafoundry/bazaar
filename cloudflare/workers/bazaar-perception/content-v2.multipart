export default{async fetch(r,e){const u=new URL(r.url);if(r.method==="GET"&&u.pathname==="/health")return j({ok:true,service:"bazaar-perception",pipeline_version:PIPELINE_VERSION,region_detector_version:REGION_VERSION});
 if(r.method==="POST"&&u.pathname==="/v1/analyze"){if(!await auth(r,e))return j({error:"unauthorized"},401);if(!(r.headers.get("content-type")||"").toLowerCase().includes("image/png"))return j({error:"image_png_required"},415);const declared=Number(r.headers.get("content-length")||"0");if(declared>MAX_BYTES)return j({error:"image_too_large"},413);try{const b=await r.arrayBuffer();if(!b.byteLength||b.byteLength>MAX_BYTES)return j({error:"image_size_outside_allowed_range"},413);return j(await analyze(e,b))}catch(x){console.error("PERCEPTION_ANALYZE_ERROR",x);return j({error:"perception_analysis_failed",detail:x instanceof Error?x.message:String(x),pipeline_version:PIPELINE_VERSION},422)}}return j({error:"not_found"},404)},
async queue(batch,e){
 for(const m of batch.messages){
  try{
   if(m.body?.kind==="evaluate_train_case"){
    const caseId=String(m.body.case_id||"");
    if(!caseId.startsWith("clean-board-"))throw Error("invalid train case id");
    const row=await e.DB.prepare("SELECT split,case_kind,truth_json FROM benchmark_cases WHERE case_id=?").bind(caseId).first();
    if(!row||row.split!=="train"||row.case_kind!=="board")throw Error("train board case required");
    const obj=await e.BENCHMARK_R2.get("clean/train/"+caseId+"/screenshot.png");
    if(!obj)throw Error("train screenshot missing");
    const perception=await analyze(e,await new Response(obj.body).arrayBuffer());
    const truth=JSON.parse(row.truth_json);
    const preds=perception.regions.filter(r=>r.proposal?.source==="v30_board_row");
    const remaining=new Set(preds.map((_,i)=>i)),objects=[];let matched=0,top1Asset=0,top5Asset=0,top1Entity=0,claimEntity=0;const ious=[];
    for(const t of truth.objects||[]){
     let bi=null,bv=0;for(const i of remaining){const v=iou(t.bbox,preds[i].bbox);if(v>bv){bv=v;bi=i}}
     if(bi!==null)remaining.delete(bi);
     const p=bi===null?null:preds[bi],ok=bi!==null&&bv>=.85;
     if(ok)matched++;ious.push(bv);
     const cands=p?.catalogue_candidates||[],a1=cands[0]?.asset_path===t.asset_path,a5=cands.some(c=>c.asset_path===t.asset_path);
     if(a1)top1Asset++;if(a5)top5Asset++;
     const expected=Array.isArray(t.expected_entity_ids)?t.expected_entity_ids:[];
     const topIds=cands[0]?.metadata?.candidate_entity_ids||[];
     const e1=t.expected_resolution==="semantic"&&expected.length>0&&expected.some(id=>topIds.includes(id));
     if(e1)top1Entity++;const claimIds=p?.semantic_claim?.entity_ids||[],claimOk=t.expected_resolution==="semantic"&&expected.length>0&&expected.some(id=>claimIds.includes(id));if(claimOk)claimEntity++;
     objects.push({object_id:t.object_id,iou:bv,region_match:ok,prediction_index:bi,top1_asset_match:a1,top5_asset_match:a5,top1_expected_entity_match:e1,semantic_claim_expected_entity_match:claimOk,semantic_claim:p?.semantic_claim||null,retrieval_resolution:p?.retrieval_resolution||null,top1_asset:cands[0]?.asset_path||null});
    }
    const n=(truth.objects||[]).length,mean=ious.length?ious.reduce((s,v)=>s+v,0)/ious.length:1,min=ious.length?Math.min(...ious):1;
    console.log("PERCEPTION_TRAIN_EVAL",JSON.stringify({
     pipeline_version:perception.pipeline_version,case_id:caseId,
     metrics:{truth_objects:n,specialized_predictions:preds.length,region_matches_at_085:matched,region_recall:n?matched/n:1,region_precision:preds.length?matched/preds.length:n?0:1,mean_iou:mean,min_iou:min,top1_asset_accuracy:n?top1Asset/n:1,top5_asset_accuracy:n?top5Asset/n:1,top1_expected_entity_accuracy:n?top1Entity/n:1,semantic_claim_expected_entity_accuracy:n?claimEntity/n:1},
     specialized_board_row:perception.layout?.specialized_board_row||null,
     objects,
     safeguards:perception.safeguards
    }));
    m.ack();continue
   }
   if(m.body?.kind==="store_smoke_chunk"){const id=String(m.body.upload_id||""),idx=Number(m.body.index),value=String(m.body.value||"");if(!/^[a-z0-9-]{4,64}$/.test(id)||!Number.isInteger(idx)||idx<0||idx>63||!/^[A-Za-z0-9+/=]+$/.test(value)||value.length>4000)throw Error("invalid smoke chunk");const key="perception_upload:"+id+":"+String(idx).padStart(3,"0");await e.DB.prepare("INSERT OR REPLACE INTO browser_session_state(key,value,updated_at) VALUES(?,?,CURRENT_TIMESTAMP)").bind(key,value).run();console.log("PERCEPTION_CHUNK_STORED",JSON.stringify({upload_id:id,index:idx,length:value.length}));m.ack();continue}if(m.body?.kind==="analyze_d1_chunks"){await pSafe(e);const id=String(m.body.upload_id||"");const total=Number(m.body.total||0),expectedSha=String(m.body.expected_sha256||"").toLowerCase();if(!/^[a-z0-9-]{4,64}$/.test(id)||!Number.isInteger(total)||total<1||total>512||!/^[0-9a-f]{64}$/.test(expectedSha))throw Error("invalid chunk smoke manifest");const pref="perception_upload:"+id+":";const rows=await e.DB.prepare("SELECT key,value FROM browser_session_state WHERE key LIKE ? ORDER BY key").bind(pref+"%").all(),rr=rows.results||[];if(rr.length!==total)throw Error("chunk smoke incomplete");for(let i=0;i<rr.length;i++){const want=pref+String(i).padStart(4,"0");if(rr[i].key!==want)throw Error("chunk smoke sequence mismatch at "+i)}const s64=rr.map(r=>String(r.value||"")).join(""),max64=Math.ceil(MAX_BYTES/3)*4+4;if(!s64.length||s64.length>max64)throw Error("chunk smoke base64 length outside allowed range");const bin=atob(s64),u=new Uint8Array(bin.length);if(!u.byteLength||u.byteLength>MAX_BYTES)throw Error("chunk smoke decoded size outside allowed range");for(let i=0;i<bin.length;i++)u[i]=bin.charCodeAt(i);const result=await analyze(e,u.buffer);if(result.input?.sha256!==expectedSha)throw Error("chunk smoke sha256 mismatch");const st=result.state||{};console.log("PERCEPTION_UPLOAD_SMOKE",JSON.stringify({pipeline_version:result.pipeline_version,upload_id:id,sha256_verified:true,input:result.input,scene:result.scene,layout:{detector_version:result.layout?.detector_version,general_region_count:result.layout?.general_region_count,specialized_board_row:result.layout?.specialized_board_row,choice_group:result.layout?.choice_group},state_summary:{scene:st.scene,board:{present:st.board?.present,slots:(st.board?.slots||[]).map(x=>({slot_index:x.slot_index,region_id:x.region_id,entity_resolution:x.entity_resolution}))},choices:{present:st.choices?.present,group_id:st.choices?.group_id,option_count:st.choices?.options?.length||0},character_count:st.characters?.length||0,upgrade_or_enchantment_count:st.upgrades_or_enchantments?.length||0,values:st.values,unresolved_region_ids:st.unresolved_region_ids},regions:result.regions.map(r=>({region_id:r.region_id,bbox:r.bbox,geometry_class:r.geometry_class,proposal:r.proposal,context_roles:r.context_roles,class_hypotheses:(r.class_hypotheses||[]).slice(0,3),routing:r.routing,retrieval_resolution:r.retrieval_resolution?{resolution:r.retrieval_resolution.resolution,accepted:r.retrieval_resolution.accepted,reason:r.retrieval_resolution.reason,best_asset_path:r.retrieval_resolution.best_asset_path,best_score:r.retrieval_resolution.best_score,second_score:r.retrieval_resolution.second_score,margin:r.retrieval_resolution.margin}:null,top_candidates:(r.catalogue_candidates||[]).slice(0,3).map(c=>({asset_path:c.asset_path,score:c.score,render_mode:c.render_mode,metadata:c.metadata}))})),safeguards:result.safeguards,timings_ms:result.timings_ms}));await e.DB.prepare("DELETE FROM browser_session_state WHERE key LIKE ?").bind(pref+"%").run();m.ack();continue}let buf=null,source=null;
   if(m.body?.kind==="analyze_base64"){const s=String(m.body.png_base64||""),bin=atob(s),u=new Uint8Array(bin.length);for(let i=0;i<bin.length;i++)u[i]=bin.charCodeAt(i);buf=u.buffer;source="base64_smoke"}
   else if(m.body?.kind==="analyze_r2_key"){await pSafe(e);const key=String(m.body.r2_key||"");if(!key.startsWith("clean/train/")||!key.endsWith("/screenshot.png"))throw Error("invalid train smoke key");const o=await e.BENCHMARK_R2.get(key);if(!o)throw Error("train smoke object missing");buf=await new Response(o.body).arrayBuffer();source="train_r2_smoke"}
   else throw Error("unsupported smoke message");
   const result=await analyze(e,buf);
   console.log("PERCEPTION_SMOKE",JSON.stringify({pipeline_version:result.pipeline_version,source,input:result.input,scene:result.scene,layout:result.layout,capabilities:result.capabilities,region_count:result.regions.length,state_summary:{scene:result.state?.scene,board_present:result.state?.board?.present,board_slot_count:result.state?.board?.slots?.length||0,choice_present:result.state?.choices?.present,choice_count:result.state?.choices?.options?.length||0,values:result.state?.values},first_regions:result.regions.slice(0,8).map(r=>({region_id:r.region_id,bbox:r.bbox,geometry_class:r.geometry_class,class_hypotheses:r.class_hypotheses?.slice(0,3),routing:r.routing,top_candidates:r.catalogue_candidates?.slice(0,2),semantic_claim:r.semantic_claim})),timings_ms:result.timings_ms,safeguards:result.safeguards}));
   m.ack()
  }catch(x){console.error("PERCEPTION_SMOKE_ERROR",x instanceof Error?x.stack||x.message:String(x));m.ack()}
 }
}};

