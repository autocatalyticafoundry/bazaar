 if(!w||!h||depth!==8||![2,6].includes(type)||comp!==0||filter!==0||interlace!==0)throw Error("PNG mode unsupported in v1a");
 if(w*h>MAX_PIXELS)throw Error("image pixel count exceeds limit");
