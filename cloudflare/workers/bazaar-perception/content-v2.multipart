}
function pHrMae(grids,ref,box){
 const rg=pRefGrid(ref,box);let best=Infinity;for(const sg of grids){let t=0;for(let i=0;i<rg.length;i+=3)t+=Math.abs(sg[i]-rg[i])+Math.abs(sg[i+1]-rg[i+1])+Math.abs(sg[i+2]-rg[i+2]);best=Math.min(best,t/(P_HR_W*P_HR_H*3*255))}return best
}
async function pConfirmHighres(e,image,diag,byPath){
 if(diag.reason!=="visual_near_tie_crosses_semantics"||!diag.best_asset_path)return diag;
 const paths=diag.near_tie_asset_paths||[];if(paths.length<2||paths.length>4)return diag;
 const cs=paths.map(p=>byPath.get(p)).filter(Boolean);if(cs.length!==paths.length||cs.some(c=>c.render_mode!=="card_art"))return diag;
 const sets=cs.map(c=>pSemanticIds(c.metadata));if(sets.some(ids=>ids.length>1)||!sets.some(ids=>ids.length===1))return diag;
 const grids=[];for(const dy of[-2,0,2])for(const dx of[-2,0,2])grids.push(pShotGrid(image,diag.bbox,dx,dy));
 const scores=[];
 try{
  for(const path of paths){const c=byPath.get(path),sha=c.metadata?.sha256;if(!sha)return{...diag,highres_tie_breaker:{applied:false,reason:"highres_reference_key_unavailable",candidate_scores:scores}};const o=await e.BENCHMARK_R2.get("visual-highres/"+P_HR_VARIANT+"/"+sha+".png");if(!o)return{...diag,highres_tie_breaker:{applied:false,reason:"precomputed_reference_object_missing",candidate_scores:scores}};const ref=await png(await new Response(o.body).arrayBuffer());scores.push({asset_path:path,mae:pHrMae(grids,ref,diag.bbox)})}
 }catch(err){return{...diag,highres_tie_breaker:{applied:false,reason:"precomputed_png_decode_error",detail:err instanceof Error?err.message:String(err),candidate_scores:scores}}}
 scores.sort((a,b)=>a.mae-b.mae||a.asset_path.localeCompare(b.asset_path));const w=scores[0],r=scores[1],m=r.mae-w.mae,rel=m/Math.max(w.mae,1e-9),ok=w.mae<=P_HR_MAX&&m>=P_HR_MARGIN&&rel>=P_HR_REL;
 if(!ok)return{...diag,highres_tie_breaker:{applied:false,reason:"precomputed_highres_margin_insufficient",winner_asset_path:w.asset_path,winner_mae:w.mae,runner_up_mae:r.mae,margin:m,relative_margin:rel,candidate_scores:scores}};
 const win=byPath.get(w.asset_path),res=pAssetResolution(win?.metadata);if(res.resolution!=="semantic"||res.entity_ids.length!==1)return diag;
 return{...diag,resolution:"semantic",entity_ids:res.entity_ids,accepted:true,reason:"precomputed_highres_tie_confirmed_semantic",highres_tie_breaker:{applied:true,reason:"precomputed_png_reference_confirmed_semantic",winner_asset_path:w.asset_path,winner_mae:w.mae,runner_up_mae:r.mae,margin:m,relative_margin:rel,candidate_scores:scores}}
}

function pMedian(a){if(!a.length)return 0;const x=[...a].sort((a,b)=>a-b),m=Math.floor(x.length/2);return x.length%2?x[m]:(x[m-1]+x[m])/2}
function pCentered(width,spacing,y,cardW,cardH){const c=width/2;return Array.from({length:5},(_,i)=>({x:Math.round(c+(i-2)*spacing-cardW/2),y:Math.round(y),width:cardW,height:cardH}))}
function pRowBoundaryEvidence(image,boxes){const s=boxes.map(b=>pBoundary(image,b));if(s.some(v=>!Number.isFinite(v)))return-Infinity;const mean=s.reduce((a,b)=>a+b,0)/Math.max(1,s.length),floor=Math.min(...s);return mean+floor*.5}
function pObjectiveV30(items){let accepted=0,value=0;for(const item of items){const ok=item.accepted&&item.resolution!=="presentation_only";if(ok)accepted++;value+=(item.best_score??1)+(ok?0:.25)}return{accepted,value:value/Math.max(1,items.length)}}

async function pRecoveryEval(e,image,cat,boxes,cache){
 const rows=[],missing=[],paths=[];
 for(const b of boxes){const key=[b.x,b.y,b.width,b.height].join(",");if(cache.has(key))continue;const ranked=pRank(cat,pFP(image,b));missing.push({key,b,ranked});for(const c of ranked)paths.push(c.asset_path)}
 if(missing.length){const meta=await pMeta(e,paths);for(const x of missing){const full=x.ranked.map((c,n)=>({...c,rank:n+1,metadata:meta.get(c.asset_path)||null})),diag=pResolveV30(full,{x:x.b.x,y:x.b.y,width:x.b.width,height:x.b.height});cache.set(x.key,{full,diag})}}
 const fulls=[],diags=[];for(const b of boxes){const hit=cache.get([b.x,b.y,b.width,b.height].join(","));fulls.push(hit.full);diags.push(hit.diag)}
 return{fulls,diags,score:pObjectiveV30(diags)}
}
async function pRecoverV30Row(e,image,cat,specialized){
 if(!specialized?.detected||!Array.isArray(specialized.boxes)||specialized.boxes.length!==5)return{...specialized,recovery_applied:false,recovery_reason:"not_applicable"};
 const cache=new Map,baseBoxes=specialized.boxes,cardW=baseBoxes[0].width,cardH=baseBoxes[0].height;
 const spacing=Math.round(pMedian(baseBoxes.slice(1).map((b,i)=>b.x-baseBoxes[i].x))),baseY=Math.round(pMedian(baseBoxes.map(b=>b.y)));
 const base=await pRecoveryEval(e,image,cat,baseBoxes,cache),boardAccepted=d=>d.accepted&&d.resolution!=="presentation_only",rejected=base.diags.filter(d=>!boardAccepted(d));
 const semanticOnly=rejected.length>0&&base.score.accepted>=4&&rejected.every(d=>d.reason==="visual_near_tie_crosses_semantics"&&(d.best_score??1)<=P_V30_MAX_SCORE);
 if(semanticOnly)return{...specialized,recovery_applied:false,recovery_reason:"semantic_near_tie_deferred_to_highres",recovery_base_y:baseY,recovery_base_accepted:base.score.accepted,recovery_base_objective:base.score.value,recovery_selected_y:baseY,recovery_selected_spacing:spacing,recovery_selected_accepted:base.score.accepted,recovery_selected_objective:base.score.value,recovery_cache_size:cache.size,recovery_evaluations:[]};
 let selectedBoxes=baseBoxes,selectedScore=base.score,selectedSpacing=spacing,recoveryApplied=false;
 const strong=()=>selectedScore.accepted===5&&selectedScore.value<.12,evals=[];
 const consider=async(boxes,sp,boundary,kind)=>{
  const ev=await pRecoveryEval(e,image,cat,boxes,cache),better=ev.score.accepted>selectedScore.accepted||(ev.score.accepted===selectedScore.accepted&&ev.score.value+.005<selectedScore.value);
  evals.push({kind,spacing:sp,y:boxes[0]?.y??0,boundary:Number.isFinite(boundary)?boundary:null,accepted:ev.score.accepted,objective:ev.score.value,selected:better});
  if(better){selectedBoxes=boxes;selectedScore=ev.score;selectedSpacing=sp;recoveryApplied=true}
 };
 if(!strong()){
  const scaleY=cardH/400,raw=Array.from({length:21},(_,i)=>(i-10)*16).filter(x=>x!==0),offsets=raw.sort((a,b)=>Math.abs(a)-Math.abs(b)||a-b).map(x=>Math.round(x*scaleY));
  for(const off of offsets){if(strong())break;const y=baseY+off;if(y<0||y+cardH>image.height)continue;const boxes=pCentered(image.width,spacing,y,cardW,cardH),boundary=pRowBoundaryEvidence(image,boxes);await consider(boxes,spacing,boundary,"vertical")}
  if(!strong()){
   const yRaw=Array.from({length:21},(_,i)=>(i-10)*16).map(x=>Math.round(x*scaleY)),scaleX=cardW/300,spacingCandidates=Array.from({length:10},(_,i)=>Math.round(cardW+(10+i*10)*scaleX)),geom=[];
   for(const sp of spacingCandidates)for(const off of yRaw){const y=baseY+off;if(y<0||y+cardH>image.height)continue;if(sp===spacing&&off===0)continue;const boxes=pCentered(image.width,sp,y,cardW,cardH),boundary=pRowBoundaryEvidence(image,boxes);if(!Number.isFinite(boundary))continue;geom.push({boxes,spacing:sp,y,boundary,distance:Math.abs(sp-spacing)+Math.abs(off)*.25})}
   geom.sort((a,b)=>b.boundary-a.boundary||a.distance-b.distance||a.spacing-b.spacing||a.y-b.y);
   for(const c of geom.slice(0,15)){if(strong())break;await consider(c.boxes,c.spacing,c.boundary,"geometry")}
  }
 }
 return{...specialized,boxes:selectedBoxes,recovery_applied:recoveryApplied,recovery_reason:recoveryApplied?"retrieval_scored_geometry_improvement":"no_better_geometry",recovery_base_y:baseY,recovery_base_accepted:base.score.accepted,recovery_base_objective:base.score.value,recovery_selected_y:selectedBoxes[0]?.y??null,recovery_selected_spacing:selectedSpacing,recovery_selected_accepted:selectedScore.accepted,recovery_selected_objective:selectedScore.value,recovery_cache_size:cache.size,recovery_evaluations:evals}
}
function pCtx(rs,gs,sp,img){const bm=new Map(rs.map(r=>[r.region_id,r])),rm=new Map(rs.map(r=>[r.region_id,[]])),bid=new Set(rs.filter(r=>r.proposal?.source==="v30_board_row").map(r=>r.region_id));for(const r of rs){const a=rm.get(r.region_id),c=r.class_hypotheses?.[0]?.class||"unknown",top=r.catalogue_candidates?.[0]||null,m=top?.render_mode||"unknown",genericStrong=Number.isFinite(top?.score)&&top.score<=.16;if(bid.has(r.region_id))a.push({role:"board_slot",confidence:1,basis:"v30_board_row"});if(genericStrong&&m==="portrait"&&(c==="hero"||c==="monster"))a.push({role:"character_portrait_candidate",confidence:.86,basis:"strict_portrait_catalogue_class"});if(genericStrong&&(m==="edge_overlay"||m==="slot_overlay"))a.push({role:"upgrade_or_enchantment_overlay_candidate",confidence:.82,basis:"strict_overlay_visual_match"})}if(sp&&sp.detected&&sp.boxes&&sp.boxes.length===5)return{role_map:rm,choice_group:null};const cs=gs.filter(g=>g.orientation==="horizontal"&&g.member_count>=2&&g.member_count<=5).map(g=>{const ms=g.member_region_ids.map(id=>bm.get(id)).filter(Boolean).filter(r=>!bid.has(r.region_id));if(ms.length<2)return null;const cy=ms.reduce((s,r)=>s+r.bbox.y+r.bbox.height/2,0)/ms.length,up=1-Math.min(1,cy/Math.max(1,img.height)),reg=Math.min(1,Math.max(0,(g.regularity_score||0)/4)),cl=ms.filter(r=>["hero","monster","item","skill","presentation","visual_object"].includes(r.class_hypotheses?.[0]?.class)).length/ms.length,score=Math.min(.96,.28+.12*Math.min(4,ms.length)+.16*up+.18*reg+.12*cl);return{g,ms,score}}).filter(Boolean).sort((a,b)=>b.score-a.score),best=cs[0]||null;if(best&&best.score>=.55)for(const r of best.ms)rm.get(r.region_id).push({role:"choice_option_candidate",confidence:best.score,basis:"regular_horizontal_nonboard_group",group_id:best.g.group_id});return{role_map:rm,choice_group:best?{group_id:best.g.group_id,member_region_ids:best.ms.map(r=>r.region_id),score:best.score}:null}}
