function pState(rs,scene,ctx){const has=(r,n)=>(r.context_roles||[]).some(x=>x.role===n),brief=r=>({region_id:r.region_id,bbox:r.bbox,context_roles:r.context_roles||[],class_hypotheses:(r.class_hypotheses||[]).slice(0,3),entity_resolution:r.semantic_claim?{status:"semantic",entity_ids:r.semantic_claim.entity_ids,basis:r.semantic_claim.basis,reason:r.semantic_claim.reason}:{status:"unresolved",entity_ids:[]},catalogue_candidates:(r.catalogue_candidates||[]).slice(0,3).map(c=>({asset_path:c.asset_path,score:c.score,render_mode:c.render_mode,metadata:c.metadata}))});const slots=rs.filter(r=>has(r,"board_slot")).sort((a,b)=>a.bbox.x-b.bbox.x).map((r,i)=>({slot_index:i,...brief(r)}));const ids=new Set(ctx?.choice_group?.member_region_ids||[]),choices=rs.filter(r=>ids.has(r.region_id)).map(brief),portraits=rs.filter(r=>has(r,"character_portrait_candidate")).map(brief),overlays=rs.filter(r=>has(r,"upgrade_or_enchantment_overlay_candidate")).map(brief),unresolved=rs.filter(r=>!r.semantic_claim&&(r.context_roles||[]).length>0).map(r=>r.region_id);return{schema_version:1,scene:{type:scene.classification,hypotheses:scene.hypotheses},board:{present:slots.length>0,slots},choices:{present:choices.length>0,group_id:ctx?.choice_group?.group_id||null,options:choices},characters:portraits,upgrades_or_enchantments:overlays,values:{status:"not_implemented",entries:[]},unresolved_region_ids:unresolved}}
async function analyze(e,buf){
