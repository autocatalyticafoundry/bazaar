}
function pMae(a,b){if(!a.length||a.length!==b.length)return 1;let t=0;for(let i=0;i<a.length;i++)t+=Math.abs(a[i]-b[i]);return t/(a.length*255)}
async function pCat(e){
 if(!pCatCache)pCatCache=(async()=>{const o=await e.BENCHMARK_R2.get("catalogue/visual-catalogue-board-v1.json");if(!o)throw Error("catalogue snapshot missing");const p=JSON.parse(await new Response(o.body).text());if(p?.schema_version!==1||!Array.isArray(p.fingerprints)||p.fingerprints.length!==2659)throw Error("catalogue snapshot invalid");return p.fingerprints.map(x=>({...x,rgb:pB64(x.rgb16),dhash_hi:pHexHi(x.dhash),dhash_lo:pHexLo(x.dhash),ahash_hi:pHexHi(x.ahash),ahash_lo:pHexLo(x.ahash)}))})().catch(x=>{pCatCache=null;throw x});
 return pCatCache
}
function pRank(cat,fp){
 const color=[];for(const row of cat){const d=Math.abs(row.mean_r-fp.mean_r)+Math.abs(row.mean_g-fp.mean_g)+Math.abs(row.mean_b-fp.mean_b);if(color.length<192){color.push({row,d});color.sort((a,b)=>a.d-b.d)}else if(d<color[191].d){color[191]={row,d};color.sort((a,b)=>a.d-b.d)}}
 return color.map(({row,d})=>{const rgb=pMae(fp.rgb,row.rgb),hash=(pHD(fp.dhash_hi,fp.dhash_lo,row.dhash_hi,row.dhash_lo)+pHD(fp.ahash_hi,fp.ahash_lo,row.ahash_hi,row.ahash_lo))/2,score=rgb*.72+hash*.2+d/(3*255)*.08;return{asset_path:row.asset_path,render_mode:row.render_mode,source_sha256:row.source_sha256,score,rgb_mae:rgb,hash_distance:hash}}).sort((a,b)=>a.score-b.score||a.asset_path.localeCompare(b.asset_path)).slice(0,8)
}
async function pMeta(e,paths){
 const u=[...new Set(paths)],m=new Map;if(!u.length)return m;
 for(let off=0;off<u.length;off+=50){const c=u.slice(off,off+50),q=c.map(()=>"?").join(","),r=await e.DB.prepare("SELECT asset_path,sha256,category,resolution_state,candidate_entity_ids_json FROM corpus_objects WHERE asset_path IN ("+q+")").bind(...c).all();
  for(const x of r.results||[]){let ids=[];try{const z=JSON.parse(x.candidate_entity_ids_json||"[]");if(Array.isArray(z))ids=z.map(String)}catch{}m.set(x.asset_path,{sha256:x.sha256,category:x.category,resolution_state:x.resolution_state,candidate_entity_ids:ids})}
 }
 return m
}

let pCoverageCache=null;
function pEntityClass(id){
 const s=String(id||"");
 for(const k of ["item","hero","monster","merchant","action","skill","enchantment","presentation","visual_object"])if(s.startsWith("bazaar:"+k+":"))return k;
 return "unknown"
}
function pClasses(cands){
 const m=new Map;
 for(const c of cands||[]){
  const ids=c.metadata?.candidate_entity_ids||[];
  const ks=ids.length?[...new Set(ids.map(pEntityClass))]:[c.metadata?.category||"unknown"];
  for(const k of ks){const prev=m.get(k);if(!prev||c.score<prev.best_score)m.set(k,{class:k,best_score:c.score,best_rank:c.rank,render_mode:c.render_mode});}
 }
 return [...m.values()].sort((a,b)=>a.best_score-b.best_score||a.best_rank-b.best_rank)
}
function pRoute(cands,classes){
 const top=cands?.[0],cls=classes?.[0]?.class||"unknown",mode=top?.render_mode||"unknown";
 if(mode==="portrait"&&(cls==="hero"||cls==="monster"))return "portrait_catalogue";
 if(mode==="card_art")return "card_art_catalogue";
 if(mode==="edge_overlay"||mode==="slot_overlay")return "overlay_catalogue";
 if(mode==="contained"||mode==="icon")return "ui_asset_catalogue";
 return "mixed_catalogue"
}
function pBoxArea(b){return Math.max(0,b.width)*Math.max(0,b.height)}
function pContainment(inner,outer){const x1=Math.max(inner.x,outer.x),y1=Math.max(inner.y,outer.y),x2=Math.min(inner.x+inner.width,outer.x+outer.width),y2=Math.min(inner.y+inner.height,outer.y+outer.height),inter=Math.max(0,x2-x1)*Math.max(0,y2-y1);return inter/Math.max(1,pBoxArea(inner))}
function pLayoutRoots(regions){return regions.filter(r=>!regions.some(q=>{if(q===r)return false;const ra=pBoxArea(r.bbox),qa=pBoxArea(q.bbox);if(qa<ra*1.35)return false;if(pContainment(r.bbox,q.bbox)<.9)return false;const rs=Number(r.proposal?.score||0),qs=Number(q.proposal?.score||0);return qs>=rs*.72}))}
function pGroups(regions){
 const layoutRegions=pLayoutRoots(regions),groups=[],seen=new Set;
 function add(orientation,seed){
  const b0=seed.bbox,c0x=b0.x+b0.width/2,c0y=b0.y+b0.height/2;
  let ms=layoutRegions.filter(r=>{
   const b=r.bbox,cx=b.x+b.width/2,cy=b.y+b.height/2,wr=b.width/b0.width,hr=b.height/b0.height;
   if(wr<.55||wr>1.8||hr<.55||hr>1.8)return false;
   return orientation==="horizontal"?Math.abs(cy-c0y)<=Math.max(4,.32*(b.height+b0.height)/2):Math.abs(cx-c0x)<=Math.max(4,.32*(b.width+b0.width)/2)
  }).sort((a,b)=>orientation==="horizontal"?a.bbox.x-b.bbox.x:a.bbox.y-b.bbox.y);
  const kept=[];for(const r of ms){if(kept.some(q=>iou(q.bbox,r.bbox)>.18))continue;kept.push(r)}
  if(kept.length<2)return;
  const ids=kept.map(r=>r.region_id),key=orientation+":"+ids.join(",");if(seen.has(key))return;seen.add(key);
  const centers=kept.map(r=>orientation==="horizontal"?r.bbox.x+r.bbox.width/2:r.bbox.y+r.bbox.height/2);
  const gaps=[];for(let i=1;i<centers.length;i++)gaps.push(centers[i]-centers[i-1]);
  const meanGap=gaps.reduce((s,v)=>s+v,0)/Math.max(1,gaps.length),gapVar=gaps.reduce((s,v)=>s+(v-meanGap)*(v-meanGap),0)/Math.max(1,gaps.length),spacingCv=meanGap>0?Math.sqrt(gapVar)/meanGap:null;
  const cross=kept.map(r=>orientation==="horizontal"?r.bbox.y+r.bbox.height/2:r.bbox.x+r.bbox.width/2),crossMean=cross.reduce((s,v)=>s+v,0)/cross.length;
  const scale=kept.reduce((s,r)=>s+(orientation==="horizontal"?r.bbox.height:r.bbox.width),0)/kept.length;
  const align=cross.reduce((s,v)=>s+Math.abs(v-crossMean),0)/(cross.length*Math.max(1,scale));
  groups.push({group_id:"group-"+String(groups.length+1).padStart(2,"0"),orientation,member_region_ids:ids,member_count:ids.length,alignment_error:align,spacing_cv:spacingCv,regularity_score:ids.length/(1+align*4+(spacingCv||0)*2)})
 }
 for(const r of layoutRegions){add("horizontal",r);add("vertical",r)}
 groups.sort((a,b)=>b.regularity_score-a.regularity_score||b.member_count-a.member_count);
 return groups.slice(0,12)
}
async function pCoverage(e){
 if(pCoverageCache)return pCoverageCache;
 const q=await e.DB.prepare("SELECT SUM(candidate_entity_ids_json LIKE '%bazaar:item:%') item,SUM(candidate_entity_ids_json LIKE '%bazaar:hero:%') hero,SUM(candidate_entity_ids_json LIKE '%bazaar:monster:%') monster,SUM(candidate_entity_ids_json LIKE '%bazaar:merchant:%') merchant,SUM(candidate_entity_ids_json LIKE '%bazaar:action:%') action,SUM(candidate_entity_ids_json LIKE '%bazaar:skill:%') skill,SUM(candidate_entity_ids_json LIKE '%bazaar:enchantment:%') enchantment FROM corpus_objects").first();
 pCoverageCache={item:Number(q?.item||0),hero:Number(q?.hero||0),monster:Number(q?.monster||0),merchant:Number(q?.merchant||0),action:Number(q?.action||0),skill:Number(q?.skill||0),enchantment:Number(q?.enchantment||0)};
 return pCoverageCache
}
function pEvidence(regions,groups){
 const counts={};for(const r of regions){const c=r.class_hypotheses?.[0]?.class||"unknown";counts[c]=(counts[c]||0)+1}
 return{top_candidate_class_region_counts:counts,horizontal_group_count:groups.filter(g=>g.orientation==="horizontal").length,vertical_group_count:groups.filter(g=>g.orientation==="vertical").length}
}

const P_V30_AW=192,P_V30_AH=108,P_V30_COUNT=5,P_V30_REG_RADIUS=24,P_V30_REG_STEP=2,P_V30_EDGE_STEP=8;
function pIntensity(image,x,y){const px=Math.max(0,Math.min(image.width-1,Math.round(x))),py=Math.max(0,Math.min(image.height-1,Math.round(y))),i=(py*image.width+px)*4;return image.data[i]*.299+image.data[i+1]*.587+image.data[i+2]*.114}
function pV30Gray(image){
 const out=new Float64Array(P_V30_AW*P_V30_AH);
 if(image.width%P_V30_AW===0&&image.height%P_V30_AH===0){
  const bw=image.width/P_V30_AW,bh=image.height/P_V30_AH,n=bw*bh,stride=image.width*4;
  for(let ty=0;ty<P_V30_AH;ty++){const y0=ty*bh;for(let tx=0;tx<P_V30_AW;tx++){const x0=tx*bw;let r=0,g=0,b=0;for(let y=0;y<bh;y++){let i=(y0+y)*stride+x0*4,e=i+bw*4;for(;i<e;i+=4){r+=image.data[i];g+=image.data[i+1];b+=image.data[i+2]}}out[ty*P_V30_AW+tx]=(r*.299+g*.587+b*.114)/n}}
  return out
 }
 const sx=image.width/P_V30_AW,sy=image.height/P_V30_AH;
 for(let ty=0;ty<P_V30_AH;ty++){const y0=Math.floor(ty*sy),y1=Math.max(y0+1,Math.ceil((ty+1)*sy));for(let tx=0;tx<P_V30_AW;tx++){const x0=Math.floor(tx*sx),x1=Math.max(x0+1,Math.ceil((tx+1)*sx));let t=0,n=0;for(let y=y0;y<y1&&y<image.height;y++)for(let x=x0;x<x1&&x<image.width;x++){const i=(y*image.width+x)*4;t+=gray(image.data[i],image.data[i+1],image.data[i+2]);n++}out[ty*P_V30_AW+tx]=n?t/n:0}}
 return out
}
function pMove(v,w){const o=new Float64Array(v.length);let t=0;for(let i=0;i<v.length;i++){t+=v[i];if(i>=w)t-=v[i-w];if(i>=w-1)o[i-Math.floor(w/2)]=t}return o}
function pMedPos(v){const a=Array.from(v).filter(x=>x>0).sort((a,b)=>a-b);return a[Math.floor(a.length/2)]||0}
function pBoundary(image,box){
 if(box.x<2||box.y<2||box.x+box.width>=image.width-2||box.y+box.height>=image.height-2)return-Infinity;
 let s=0,n=0;
 for(let y=box.y+P_V30_EDGE_STEP;y<box.y+box.height-P_V30_EDGE_STEP;y+=P_V30_EDGE_STEP){s+=Math.abs(pIntensity(image,box.x-2,y)-pIntensity(image,box.x+2,y));s+=Math.abs(pIntensity(image,box.x+box.width-2,y)-pIntensity(image,box.x+box.width+2,y));n+=2}
 for(let x=box.x+P_V30_EDGE_STEP;x<box.x+box.width-P_V30_EDGE_STEP;x+=P_V30_EDGE_STEP){s+=Math.abs(pIntensity(image,x,box.y-2)-pIntensity(image,x,box.y+2));s+=Math.abs(pIntensity(image,x,box.y+box.height-2)-pIntensity(image,x,box.y+box.height+2));n+=2}
