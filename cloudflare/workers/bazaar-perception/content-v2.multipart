const P_V30_MAX_SCORE=.19,P_V30_MIN_MARGIN=.008,P_V30_DIR_MARGIN=.012,P_V30_NEAR_TIE=.0025;
const P_HR_W=48,P_HR_H=64,P_HR_MAX=.08,P_HR_MARGIN=.0015,P_HR_REL=.05,P_HR_VARIANT="board-highres-png-v1";
function pSemanticIds(meta){return [...new Set((meta?.candidate_entity_ids||[]).filter(id=>!String(id).startsWith("bazaar:visual_object:")&&!String(id).startsWith("bazaar:presentation:")))].sort()}
function pAssetResolution(meta){
 const ids=pSemanticIds(meta);
 if(meta?.resolution_state==="semantic")return ids.length===1?{resolution:"semantic",entity_ids:ids,reason:"direct_visual_semantic"}:{resolution:"unknown",entity_ids:[],reason:"semantic_asset_without_single_supported_entity"};
 if(meta?.resolution_state==="ambiguous")return ids.length>=2?{resolution:"ambiguous",entity_ids:ids,reason:"catalogue_ambiguity_preserved"}:{resolution:"unknown",entity_ids:[],reason:"ambiguous_asset_without_supported_candidate_set"};
 if(meta?.resolution_state==="presentation_only")return{resolution:"presentation_only",entity_ids:[],reason:"presentation_visual_not_promoted"};
 return{resolution:"unresolved_visual_only",entity_ids:[],reason:"unresolved_visual_not_promoted"}
}
function pDirectional(c){
 if(c?.render_mode!=="card_art")return null;const ids=pSemanticIds(c.metadata);if(ids.length!==1)return null;
 const em=/^(bazaar:item:.+)-(l|r)$/.exec(ids[0]),pm=/^(.*?)([LR])\.(?:avif|png|webp)$/i.exec(c.asset_path||"");if(!em||!pm)return null;
 const es=em[2],ps=pm[2].toLowerCase();if(es!==ps)return null;return{family:em[1]+"|"+pm[1].toLowerCase(),side:es}
}
function pResolveV30(cands,bbox){
 const best=cands[0]||null,second=cands[1]||null;
 if(!best)return{bbox,resolution:"unknown",entity_ids:[],best_asset_path:null,best_score:null,second_score:null,margin:null,accepted:false,reason:"fingerprint_catalogue_empty",near_tie_asset_paths:[]};
 const margin=second?second.score-best.score:1,near=cands.filter(x=>x.score-best.score<=P_V30_NEAR_TIE).slice(0,8);
 const common={bbox,best_asset_path:best.asset_path,best_score:best.score,second_score:second?.score??null,margin,near_tie_asset_paths:near.map(x=>x.asset_path)};
 if(!best.metadata)return{...common,resolution:"unknown",entity_ids:[],accepted:false,reason:"nearest_asset_missing_from_seed"};
 if(best.score>P_V30_MAX_SCORE)return{...common,resolution:"unknown",entity_ids:[],accepted:false,reason:"visual_distance_above_threshold"};
 const resolved=pAssetResolution(best.metadata);
 if(margin<P_V30_MIN_MARGIN){
  const cohort=cands.filter(x=>x.score-best.score<=P_V30_MIN_MARGIN).slice(0,4),sem=cohort.filter(x=>x.metadata?.resolution_state!=="presentation_only"),sets=new Set(sem.map(x=>JSON.stringify(pSemanticIds(x.metadata))));
  if(sets.size>1)return{...common,near_tie_asset_paths:sem.map(x=>x.asset_path),resolution:"unknown",entity_ids:[],accepted:false,reason:"visual_near_tie_crosses_semantics"}
 }
 const sib=pDirectional(best);
 if(sib&&resolved.resolution==="semantic"&&resolved.entity_ids.length===1){
  const rivals=cands.filter(x=>x.asset_path!==best.asset_path&&x.source_sha256!==best.source_sha256&&x.score-best.score<=P_V30_DIR_MARGIN).filter(x=>{if(x.metadata?.resolution_state!=="semantic")return false;const s=pDirectional(x);return s?.family===sib.family&&s.side!==sib.side}).slice(0,3);
  if(rivals.length)return{...common,near_tie_asset_paths:[best.asset_path,...rivals.map(x=>x.asset_path)],resolution:"unknown",entity_ids:[],accepted:false,reason:"visual_near_tie_crosses_semantics"}
 }
 return{...common,resolution:resolved.resolution,entity_ids:resolved.entity_ids,accepted:resolved.resolution!=="unknown",reason:resolved.reason}
}
function pBilinear(image,x,y){
 const cx=Math.max(0,Math.min(image.width-1,x)),cy=Math.max(0,Math.min(image.height-1,y)),x0=Math.floor(cx),y0=Math.floor(cy),x1=Math.min(image.width-1,x0+1),y1=Math.min(image.height-1,y0+1),fx=cx-x0,fy=cy-y0,ox=1-fx,oy=1-fy,s=image.width*4,d=image.data,i00=y0*s+x0*4,i10=y0*s+x1*4,i01=y1*s+x0*4,i11=y1*s+x1*4;
 return[(d[i00]*ox+d[i10]*fx)*oy+(d[i01]*ox+d[i11]*fx)*fy,(d[i00+1]*ox+d[i10+1]*fx)*oy+(d[i01+1]*ox+d[i11+1]*fx)*fy,(d[i00+2]*ox+d[i10+2]*fx)*oy+(d[i01+2]*ox+d[i11+2]*fx)*fy]
}
function pGridPoints(box){
