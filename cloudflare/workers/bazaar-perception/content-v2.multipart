async function auth(r,e){const h=r.headers.get("authorization");if(!h)return false;try{const q=await e.SAFETY.fetch(new Request("https://bazaar-auth.internal/api/admin/r2-safety",{method:"GET",headers:{authorization:h}}));return q.ok}catch{return false}}
