}
function pRefGrid(ref,box){
 const {xs,ys}=pGridPoints(box),o=new Float64Array(P_HR_W*P_HR_H*3),scale=Math.max(box.width/ref.width,box.height/ref.height),dw=ref.width*scale,dh=ref.height*scale,ox=(box.width-dw)/2,oy=(box.height-dh)/2;let k=0;
 for(const by of ys){const y=(by-oy)*ref.height/dh-.5;for(const bx of xs){const x=(bx-ox)*ref.width/dw-.5,c=pBilinear(ref,x,y);o[k++]=c[0];o[k++]=c[1];o[k++]=c[2]}}
