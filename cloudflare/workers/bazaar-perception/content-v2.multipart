function grid(image){const w=224,h=Math.max(96,Math.min(224,Math.round(image.height/image.width*w))),v=new Float64Array(w*h),sx=image.width/w,sy=image.height/h;for(let y=0;y<h;y++){const py=Math.min(image.height-1,Math.floor((y+.5)*sy));for(let x=0;x<w;x++){const px=Math.min(image.width-1,Math.floor((x+.5)*sx)),k=(py*image.width+px)*4;v[y*w+x]=gray(image.data[k],image.data[k+1],image.data[k+2])}}return{w,h,v,sx,sy}}
