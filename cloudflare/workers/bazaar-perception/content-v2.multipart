let pCatCache=null;
async function pSafe(e){
 const r=await e.SAFETY.fetch("https://bazaar-safety.internal/r2-safety");
 if(!r.ok)throw Error("R2 safety service HTTP "+r.status);
 const s=await r.json();
 if(s.halted===true||s.latched===true)throw Error("R2 safety halted: "+String(s.reason||"unknown"));
 return s;
}
