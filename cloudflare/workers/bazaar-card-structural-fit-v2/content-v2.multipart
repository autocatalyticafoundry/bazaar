function clip(v,a=0,b=1){return Math.max(a,Math.min(b,v))}
function num(v,d=0){const n=Number(v);return Number.isFinite(n)?n:d}
function hashBucket(s){let h=2166136261>>>0;for(let i=0;i<s.length;i++){h^=s.charCodeAt(i);h=Math.imul(h,16777619)>>>0}return h%5}
function sigmoid(z){if(z>=0){const e=Math.exp(-z);return 1/(1+e)}const e=Math.exp(z);return e/(1+e)}
function gf(gs){const g=Array.isArray(gs)?gs:[];const vs=k=>g.map(x=>Number(x?.[k])).filter(Number.isFinite);const mn=(k,d)=>{const a=vs(k);return a.length?Math.min(...a):d};const mx=(k,d)=>{const a=vs(k);return a.length?Math.max(...a):d};return{gc:clip(g.length/8),ms:clip(mx("member_count",0)/12),sp:clip(mn("spacing_cv",1.5)/1.5),wc:clip(mn("width_cv",.6)/.6),hc:clip(mn("height_cv",.6)/.6),rr:clip(mx("repeat_recovered_fraction",0)),hg:clip(g.filter(x=>x?.orientation==="horizontal").length/8)}}
const N=["width_fraction","height_fraction","aspect_ratio","area_fraction","support_log","proposal_score","group_count","max_group_size","inv_min_spacing_cv","inv_min_width_cv","inv_min_height_cv","max_repeat","horizontal_group_count","src_repeat","src_portrait","src_other","cohort_portrait_card","cohort_square","cohort_landscape","cohort_noncard"];
function fx(r,W,H){const b=r?.bbox||{},p=r?.proposal||{},g=gf(r?.groups),wf=clip(num(b.width)/Math.max(1,W)),hf=clip(num(b.height)/Math.max(1,H)),src=String(p.source||""),c=String(r?.routing?.cohort||"");return[wf,hf,clip(num(b.width)/Math.max(1,num(b.height)),0,2.5)/2.5,clip(wf*hf*20),clip(Math.log1p(Math.max(0,num(p.support_count)))/Math.log(65)),clip(num(p.score)/100),g.gc,g.ms,1-g.sp,1-g.wc,1-g.hc,g.rr,g.hg,src==="edge-horizontal-repeat-v1"?1:0,src==="edge-portrait-card-v1"?1:0,(src!=="edge-horizontal-repeat-v1"&&src!=="edge-portrait-card-v1")?1:0,c==="portrait_or_card"?1:0,c==="square_ui"?1:0,c==="landscape_ui"?1:0,c==="noncard_ui"?1:0]}
async function shard(env,id,keys){const rows=[],cases=[];for(const key of keys){const o=await env.BUCKET.get(key);if(!o)continue;let d;try{d=JSON.parse(await o.text())}catch{continue}if(d.calibration_version!=="card-role-calibration-v1.2-instance-aware")continue;const W=Math.max(1,num(d.input_width,1920)),H=Math.max(1,num(d.input_height,1080));cases.push([d.case_id,num(d.truth_item_count),num(d.truth_item_covered_count)]);for(const r of d.rows||[]){if(r?.proposal?.source==="v30_board_row")continue;const y=r.label==="positive"?1:r.label==="negative"?0:null;if(y===null)continue;rows.push([d.case_id,r.truth_index??null,y,fx(r,W,H)])}}const rec={schema_version:1,shard:id,feature_names:N,cases,rows};const key="benchmarks/playable-card-gate-v2/shards/"+id+".json";await env.BUCKET.put(key,JSON.stringify(rec),{httpMetadata:{contentType:"application/json"},customMetadata:{artifact:"playable-card-gate-feature-shard",shard:String(id),cases:String(cases.length),rows:String(rows.length)}});return{key,cases:cases.length,rows:rows.length}}
async function listAll(bucket,prefix){let out=[],cursor;do{const r=await bucket.list({prefix,limit:1000,cursor});out.push(...r.objects);cursor=r.truncated?r.cursor:undefined}while(cursor);return out}
function dot(w,x){let s=w[0];for(let i=0;i<x.length;i++)s+=w[i+1]*x[i];return s}
function instBest(rows,w){const m=new Map();for(const r of rows){if(r.y!==1||r.t==null)continue;const p=sigmoid(dot(w,r.x)),k=r.c+":"+r.t;if(!m.has(k)||p>m.get(k))m.set(k,p)}return[...m.values()].sort((a,b)=>a-b)}
function th(best,target){if(!best.length)return .5;const miss=Math.floor(best.length*(1-target)+1e-9),i=Math.min(best.length-1,miss);return clip(best[i]-1e-9)}
function met(rows,w,t){let tp=0,tn=0,fp=0,fn=0;const im=new Map(),caseSel=new Map();for(const r of rows){const p=sigmoid(dot(w,r.x)),q=p>=t;if(r.y&&q)tp++;else if(r.y)fn++;else if(q)fp++;else tn++;if(q)caseSel.set(r.c,(caseSel.get(r.c)||0)+1);if(r.y&&r.t!=null){const k=r.c+":"+r.t,v=im.get(k)||false;im.set(k,v||q)}}const iv=[...im.values()];return{proposal_count:rows.length,tp,tn,fp,fn,proposal_recall:tp+fn?tp/(tp+fn):null,specificity:tn+fp?tn/(tn+fp):null,localized_truth_instances:iv.length,localized_truth_instance_recall:iv.length?iv.filter(Boolean).length/iv.length:null,selected_proposals:tp+fp,avg_selected_per_case:caseSel.size?[...caseSel.values()].reduce((a,b)=>a+b,0)/caseSel.size:0}}
async function fit(env){const os=await listAll(env.BUCKET,"benchmarks/playable-card-gate-v2/shards/");if(!os.length)throw Error("no_shards");const rows=[],cases=[];for(const e of os){const o=await env.BUCKET.get(e.key);if(!o)continue;const d=JSON.parse(await o.text());for(const c of d.cases||[])cases.push({id:c[0],truth:c[1],covered:c[2]});for(const r of d.rows||[])rows.push({c:r[0],t:r[1],y:r[2],x:r[3]})}const tr=rows.filter(r=>hashBucket(r.c)!==0),va=rows.filter(r=>hashBucket(r.c)===0),pos=tr.filter(r=>r.y===1).length,neg=tr.length-pos;if(!tr.length||!va.length||!pos||!neg)throw Error("insufficient_rows");const pw=Math.max(1,neg/pos),w=new Array(N.length+1).fill(0),epochs=80,lambda=.002;for(let ep=0;ep<epochs;ep++){const g=new Array(w.length).fill(0);let z=0;for(const r of tr){const p=sigmoid(dot(w,r.x)),wt=r.y?pw:1,e=(p-r.y)*wt;g[0]+=e;for(let j=0;j<r.x.length;j++)g[j+1]+=e*r.x[j];z+=wt}const lr=.5/Math.sqrt(1+ep*.1);w[0]-=lr*g[0]/z;for(let j=1;j<w.length;j++)w[j]-=lr*(g[j]/z+lambda*w[j])}const best=instBest(va,w),ts={r100:th(best,1),r99:th(best,.99),r98:th(best,.98),r95:th(best,.95)};let tt=0,tc=0,vt=0,vc=0;for(const c of cases){if(hashBucket(c.id)===0){vt+=c.truth;vc+=c.covered}else{tt+=c.truth;tc+=c.covered}}const rec={schema_version:2,model_version:"playable-card-gate-structural-logit-v2-sharded-case-holdout",dataset_version:"card-role-calibration-v1.2-instance-aware",feature_policy:"resolution-normalized structural detector evidence; excludes absolute x/y, identity names, and v30_board_row from fit",split_policy:"FNV1a(case_id) mod 5 == 0 validation",semantic_promotion_allowed:false,feature_names:N,weights:w,positive_weight:pw,epochs,counts:{shards:os.length,cases:cases.length,train_cases:new Set(tr.map(r=>r.c)).size,validation_cases:new Set(va.map(r=>r.c)).size,train_rows:tr.length,validation_rows:va.length,train_positive:pos,train_negative:neg},detector_coverage:{train_truth:tt,train_covered:tc,train_recall:tt?tc/tt:null,validation_truth:vt,validation_covered:vc,validation_recall:vt?vc/vt:null},thresholds:ts,validation:{r100:met(va,w,ts.r100),r99:met(va,w,ts.r99),r98:met(va,w,ts.r98),r95:met(va,w,ts.r95)},training_r100:met(tr,w,ts.r100)};const key="benchmarks/playable-card-gate-v2/structural-logit-case-holdout.json";await env.BUCKET.put(key,JSON.stringify(rec),{httpMetadata:{contentType:"application/json"},customMetadata:{artifact:"playable-card-gate-structural-model",model_version:rec.model_version,shards:String(os.length),cases:String(cases.length),validation_detector_recall:String(rec.detector_coverage.validation_recall),threshold_r100:String(ts.r100),validation_instance_recall_r100:String(rec.validation.r100.localized_truth_instance_recall),validation_specificity_r100:String(rec.validation.r100.specificity),validation_selected_r100:String(rec.validation.r100.selected_proposals)}});return{key,counts:rec.counts,detector:rec.detector_coverage,validation:rec.validation,thresholds:ts}}
export default{async queue(batch,env){for(const m of batch.messages){try{const b=m.body||{};let out;if(b.kind==="shard")out=await shard(env,String(b.shard).padStart(2,"0"),Array.isArray(b.keys)?b.keys:[]);else if(b.kind==="fit")out=await fit(env);else throw Error("unknown_kind");console.log("CARD_STRUCTURAL_V2",JSON.stringify(out));m.ack()}catch(e){const msg=String(e?.message||e);try{await env.BUCKET.put("debug/card-structural-fit-v2/"+Date.now()+".json",JSON.stringify({error:msg,body:m.body}),{customMetadata:{artifact:"card-structural-fit-v2-error",detail:msg.slice(0,900)}})}catch{}m.retry({delaySeconds:10})}}}};

