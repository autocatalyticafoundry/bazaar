const VERSION="playable-card-gate-v2-structural-plus-cardness-rescue";
const MODEL_KEY="benchmarks/playable-card-cardness-features-v1/model-interim-calibrated.json";
const MODEL_FEATURES=["luma_mean","luma_std","sat_mean","sat_std","edge_mean","edge_std","border_edge","center_edge","border_center_edge_ratio","border_luma_delta","border_sat_delta","h_edge","v_edge","hv_log_ratio","corner_edge","frame_edge","border_luma_std","center_luma_std","border_entropy","center_entropy","sym_x","sym_y"];
function u32be(a,o){return ((a[o]<<24)>>>0)|(a[o+1]<<16)|(a[o+2]<<8)|a[o+3]}
function paeth(a,b,c){const p=a+b-c,pa=Math.abs(p-a),pb=Math.abs(p-b),pc=Math.abs(p-c);return pa<=pb&&pa<=pc?a:pb<=pc?b:c}
function cat(parts){let n=0;for(const p of parts)n+=p.length;const out=new Uint8Array(n);let o=0;for(const p of parts){out.set(p,o);o+=p.length}return out}
async function inflate(bytes){const stream=new Blob([bytes]).stream().pipeThrough(new DecompressionStream("deflate"));return new Uint8Array(await new Response(stream).arrayBuffer())}
async function decodePng(bytes){const sig=[137,80,78,71,13,10,26,10];for(let i=0;i<8;i++)if(bytes[i]!==sig[i])throw new Error("not png");let o=8,w=0,h=0,depth=0,type=0,interlace=0,idats=[],palette=null,trns=null;while(o+12<=bytes.length){const len=u32be(bytes,o)>>>0,typ=String.fromCharCode(...bytes.slice(o+4,o+8)),data=bytes.slice(o+8,o+8+len);o+=12+len;if(typ==="IHDR"){w=u32be(data,0)>>>0;h=u32be(data,4)>>>0;depth=data[8];type=data[9];interlace=data[12]}else if(typ==="PLTE")palette=new Uint8Array(data);else if(typ==="tRNS")trns=new Uint8Array(data);else if(typ==="IDAT")idats.push(data);else if(typ==="IEND")break}if(depth!==8||interlace!==0||!(type===6||type===2||type===3))throw new Error("unsupported png "+JSON.stringify({depth,type,interlace}));if(type===3&&!palette)throw new Error("indexed png missing palette");const bpp=type===6?4:type===2?3:1,stride=w*bpp,raw=await inflate(cat(idats)),rgba=new Uint8Array(w*h*4),prev=new Uint8Array(stride),cur=new Uint8Array(stride);let p=0;for(let y=0;y<h;y++){const f=raw[p++];for(let x=0;x<stride;x++){const v=raw[p++],a=x>=bpp?cur[x-bpp]:0,b=prev[x],c=x>=bpp?prev[x-bpp]:0,pr=f===0?0:f===1?a:f===2?b:f===3?Math.floor((a+b)/2):f===4?paeth(a,b,c):(()=>{throw new Error("filter "+f)})();cur[x]=(v+pr)&255}for(let x=0;x<w;x++){const si=x*bpp,di=(y*w+x)*4;if(type===3){const ix=cur[si],pi=ix*3;rgba[di]=palette[pi]??0;rgba[di+1]=palette[pi+1]??0;rgba[di+2]=palette[pi+2]??0;rgba[di+3]=trns&&ix<trns.length?trns[ix]:255}else{rgba[di]=cur[si];rgba[di+1]=cur[si+1];rgba[di+2]=cur[si+2];rgba[di+3]=type===6?cur[si+3]:255}}prev.set(cur)}return {width:w,height:h,rgba}}
function clampBox(b,w,h){const x=Math.max(0,Math.min(w-1,Math.round(b.x))),y=Math.max(0,Math.min(h-1,Math.round(b.y))),ww=Math.max(2,Math.min(w-x,Math.round(b.width))),hh=Math.max(2,Math.min(h-y,Math.round(b.height)));return {x,y,width:ww,height:hh}}
function stats(a){if(!a.length)return {mean:0,std:0};let s=0,s2=0;for(const v of a){s+=v;s2+=v*v}const mean=s/a.length;return {mean,std:Math.sqrt(Math.max(0,s2/a.length-mean*mean))}}
function entropy(vals,bins=12){if(!vals.length)return 0;const c=new Array(bins).fill(0);for(const v of vals)c[Math.min(bins-1,Math.max(0,Math.floor(v*bins)))]++;let e=0;for(const n of c)if(n){const p=n/vals.length;e-=p*Math.log(p)}return e/Math.log(bins)}
function features(img,rawBox){
 const b=clampBox(rawBox,img.width,img.height),N=48,L=new Float64Array(N*N),S=new Float64Array(N*N);
 for(let gy=0;gy<N;gy++)for(let gx=0;gx<N;gx++){const px=Math.min(img.width-1,b.x+Math.floor((gx+.5)*b.width/N)),py=Math.min(img.height-1,b.y+Math.floor((gy+.5)*b.height/N)),i=(py*img.width+px)*4,r=img.rgba[i]/255,g=img.rgba[i+1]/255,bl=img.rgba[i+2]/255,max=Math.max(r,g,bl),min=Math.min(r,g,bl);L[gy*N+gx]=.2126*r+.7152*g+.0722*bl;S[gy*N+gx]=max?((max-min)/max):0}
 const allL=[],allS=[],borderL=[],borderS=[],centerL=[],centerS=[],borderE=[],centerE=[],allE=[],hE=[],vE=[],cornerE=[],frameE=[];
 const ring=6,center0=12,center1=36,frameBand=[2,3,4,43,44,45];
 let symX=0,symY=0,symN=0;
 for(let y=0;y<N;y++)for(let x=0;x<N;x++){const idx=y*N+x,l=L[idx],s=S[idx],border=x<ring||x>=N-ring||y<ring||y>=N-ring,center=x>=center0&&x<center1&&y>=center0&&y<center1;allL.push(l);allS.push(s);if(border){borderL.push(l);borderS.push(s)}if(center){centerL.push(l);centerS.push(s)}let he=0,ve=0;if(x>0)he=Math.abs(l-L[idx-1]);if(y>0)ve=Math.abs(l-L[idx-N]);const e=(he+ve)/2;allE.push(e);hE.push(he);vE.push(ve);if(border)borderE.push(e);if(center)centerE.push(e);if((x<ring||x>=N-ring)&&(y<ring||y>=N-ring))cornerE.push(e);if(frameBand.includes(x)||frameBand.includes(y))frameE.push(e);if(x<N/2){symX+=Math.abs(l-L[y*N+(N-1-x)]);symN++}if(y<N/2)symY+=Math.abs(l-L[(N-1-y)*N+x])}
 const al=stats(allL),as=stats(allS),be=stats(borderE),ce=stats(centerE),ae=stats(allE),bs=stats(borderS),cs=stats(centerS),bls=stats(borderL),cls=stats(centerL),hs=stats(hE),vs=stats(vE),corn=stats(cornerE),frm=stats(frameE);
 return {aspect:b.width/b.height,area:b.width*b.height/(img.width*img.height),luma_mean:al.mean,luma_std:al.std,sat_mean:as.mean,sat_std:as.std,edge_mean:ae.mean,edge_std:ae.std,border_edge:be.mean,center_edge:ce.mean,border_center_edge_ratio:be.mean/(ce.mean+.005),border_luma_delta:bls.mean-cls.mean,border_sat_delta:bs.mean-cs.mean,h_edge:hs.mean,v_edge:vs.mean,hv_log_ratio:Math.log((hs.mean+.005)/(vs.mean+.005)),corner_edge:corn.mean,frame_edge:frm.mean,border_luma_std:bls.std,center_luma_std:cls.std,border_entropy:entropy(borderL),center_entropy:entropy(centerL),sym_x:symN?symX/symN:0,sym_y:symN?symY/symN:0};
}
async function loadImg(env,key){const o=await env.BUCKET.get(key);if(!o)throw new Error("missing image "+key);return decodePng(new Uint8Array(await o.arrayBuffer()))}


function median2(values){if(!values.length)return null;const s=[...values].sort((a,b)=>a-b),m=Math.floor(s.length/2);return s.length%2?s[m]:(s[m-1]+s[m])/2}
function structural(region,regions,groups,w,h){
  const cohort=region.routing?.cohort??null;
  if(cohort==="v30_board_cell") return {accepted:true,score:1,path:"specialized_board_cell"};
  if(cohort!=="portrait_or_card") return {accepted:false,score:0,path:"not_card_candidate"};
  const b=region.bbox;
  const support=Number.isFinite(region.proposal?.support_count)?region.proposal.support_count:0;
  const aspect=b.width/Math.max(1,b.height);
  const area=b.width*b.height/Math.max(1,w*h);
  let best=null;
  for(let gi=0;gi<groups.length;gi++){
    const g=groups[gi];
    if(!(g.region_ids||[]).includes(region.region_id)||g.member_count<4)continue;
    const ms=(g.region_ids||[]).map(id=>regions.find(x=>x.region_id===id)).filter(Boolean);
    const mw=median2(ms.map(x=>x.bbox.width)),mh=median2(ms.map(x=>x.bbox.height)),mcy=median2(ms.map(x=>x.bbox.y+x.bbox.height/2));
    if(!mw||!mh||mcy===null)continue;
    const wr=b.width/mw,hr=b.height/mh,cd=Math.abs(b.y+b.height/2-mcy)/mh;
    const gf=((wr>=.76&&wr<=1.42?1:0)+(hr>=.76&&hr<=1.42?1:0)+(cd<=.30?1:0))/3;
    const count=Math.min(1,g.member_count/6);
    const regularity=g.spacing_cv===null?.5:Math.max(0,1-g.spacing_cv/.75);
    const repeat=Math.max(0,Math.min(1,g.repeat_recovered_fraction??0));
    const gs=Math.min(1,Math.max(0,g.mean_proposal_support??0)/8);
    const score=.4*gf+.22*count+.16*regularity+.12*repeat+.1*gs;
    const ev={score,member_count:g.member_count,width_ratio:wr,height_ratio:hr,center_delta:cd};
    if(!best||score>best.score)best=ev;
  }
  const row=(best?.score??0)>=.7;
  const large=support>=8&&area>=.018;
  const small=support>=12&&area>=.01&&aspect>=.62&&aspect<=.88;
  const accepted=row||large||small;
  return {accepted,score:Math.max(best?.score??0,large?.8:0,small?.75:0),path:row?"repeated_board_structure":large?"strong_standalone_large":small?"strong_standalone_small":"rejected",support,area,aspect,row:best};
}
function visualScore(model,f){
  const x=MODEL_FEATURES.map(k=>Number(f?.[k]??0));
  const z=x.map((v,j)=>(v-model.global_mean[j])/model.global_std[j]);
  const d=model.pos_centroid_z.map((v,j)=>v-model.neg_centroid_z[j]);
  const mid=model.pos_centroid_z.map((v,j)=>(v+model.neg_centroid_z[j])/2);
  const norm=Math.sqrt(d.reduce((s,v)=>s+v*v,0))||1;
  return d.reduce((s,v,j)=>s+v*(z[j]-mid[j]),0)/norm;
}
export default {async queue(batch,env){for(const m of batch.messages){try{
  const ro=await env.BUCKET.get(m.body.result_key),mo=await env.BUCKET.get(MODEL_KEY);
  if(!ro||!mo)throw new Error("missing result/model");
  const d=JSON.parse(await ro.text()),ma=JSON.parse(await mo.text()),model=ma.model,threshold=Number(model.threshold);
  const regions=d.regions||[],groups=d.layout?.groups||[];
  const img=await loadImg(env,d.input.r2_key||("perception/inputs/"+d.input.sha256+".png"));
  const knownPos=new Set(m.body.evaluation?.known_positive_region_ids||[]);
  const knownNeg=new Set(m.body.evaluation?.known_negative_region_ids||[]);
  const rows=[];
  for(const region of regions){
    if(!(region.routing?.cohort==="portrait_or_card"||region.routing?.cohort==="v30_board_cell"))continue;
    const s=structural(region,regions,groups,d.input.width,d.input.height);
    let cardness=null,rescued=false;
    if(!s.accepted&&region.routing?.cohort==="portrait_or_card"){
      const f=features(img,region.bbox);
      const score=visualScore(model,f);
      cardness={score,threshold,margin:score-threshold,accepted:score>=threshold};
      rescued=cardness.accepted;
    }
    rows.push({region_id:region.region_id,bbox:region.bbox,proposal:region.proposal,structural:s,cardness,accepted:s.accepted||rescued,path:s.accepted?s.path:rescued?"visual_cardness_rescue":"rejected"});
  }
  const accepted=rows.filter(x=>x.accepted),rescued=rows.filter(x=>!x.structural.accepted&&x.accepted);
  const artifact={
    schema_version:1,artifact:"playable-card-gate-v2-shadow",version:VERSION,semantic_promotion_allowed:false,
    source_result_key:m.body.result_key,source_sha256:d.input.sha256,model_key:MODEL_KEY,model_fit_kind:ma.fit_kind,
    model_threshold:threshold,candidate_count:rows.length,structural_accepted_count:rows.filter(x=>x.structural.accepted).length,
    visual_rescue_count:rescued.length,accepted_count:accepted.length,rejected_count:rows.length-accepted.length,
    accepted_region_ids:accepted.map(x=>x.region_id),visual_rescue_region_ids:rescued.map(x=>x.region_id),
    evaluation:{
      expected_count:m.body.evaluation?.expected_playable_card_count??null,
      count_matches:m.body.evaluation?.expected_playable_card_count==null?null:accepted.length===m.body.evaluation.expected_playable_card_count,
      known_positive_rejected:rows.filter(x=>knownPos.has(x.region_id)&&!x.accepted).map(x=>x.region_id),
      known_negative_accepted:rows.filter(x=>knownNeg.has(x.region_id)&&x.accepted).map(x=>x.region_id)
    },regions:rows
  };
  const token=String(d.pipeline_version).replace(/[^A-Za-z0-9._-]+/g,"-");
  const key="perception/playable-card-gate-v2-shadow/"+d.input.sha256+"/"+token+".json";
  await env.BUCKET.put(key,JSON.stringify(artifact),{
    httpMetadata:{contentType:"application/json",cacheControl:"private, max-age=0"},
    customMetadata:{
      artifact:"playable-card-gate-v2-shadow",version:VERSION,candidates:String(rows.length),
      structural_accepted:String(artifact.structural_accepted_count),visual_rescues:String(artifact.visual_rescue_count),
      accepted:String(accepted.length),accepted_region_ids:JSON.stringify(accepted.map(x=>x.region_id)),
      visual_rescue_region_ids:JSON.stringify(rescued.map(x=>x.region_id)),
      expected_count:artifact.evaluation.expected_count==null?"":String(artifact.evaluation.expected_count),
      count_matches:artifact.evaluation.count_matches==null?"":String(artifact.evaluation.count_matches),
      known_positive_rejected:JSON.stringify(artifact.evaluation.known_positive_rejected),
      known_negative_accepted:JSON.stringify(artifact.evaluation.known_negative_accepted),
      semantic_promotion_allowed:"false"
    }
  });
  m.ack();
}catch(e){
  const msg=String(e?.stack||e);
  await env.BUCKET.put("debug/gate-v2-errors/"+Date.now()+"-"+Math.random().toString(16).slice(2)+".txt",msg,{httpMetadata:{contentType:"text/plain"},customMetadata:{error:msg.slice(0,1000)}});
  m.ack();
}}}};
