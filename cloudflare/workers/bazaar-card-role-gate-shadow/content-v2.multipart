const V="card-role-gate-shadow-v1.1-public-runtime";
const C=(v,a=0,b=1)=>Math.max(a,Math.min(b,v));
function I(a,b){if(!a||!b)return 0;const x1=Math.max(a.x,b.x),y1=Math.max(a.y,b.y),x2=Math.min(a.x+a.width,b.x+b.width),y2=Math.min(a.y+a.height,b.y+b.height),i=Math.max(0,x2-x1)*Math.max(0,y2-y1),u=a.width*a.height+b.width*b.height-i;return u?i/u:0}
function F(result,r){
 const b=r.bbox||{},w=+b.width||0,h=+b.height||0,cx=(+b.x||0)+w/2,cy=(+b.y||0)+h/2;
 const gs=(result.layout?.groups||[]).filter(g=>g?.orientation==="horizontal"&&Array.isArray(g.region_ids)&&g.region_ids.includes(r.region_id));
 let bg=null,bs=0;
 for(const g of gs){const s=(+g.member_count||0)*(1-C(+g.spacing_cv||1))*(1-.5*C(+g.width_cv||0))*(1-.5*C(+g.height_cv||0));if(s>bs){bs=s;bg=g}}
 let n=0;
