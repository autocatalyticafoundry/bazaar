 return {source:r.proposal?.source||"",support_count:+r.proposal?.support_count||0,proposal_score:+r.proposal?.score||0,ratio:w/Math.max(1,h),area_fraction:w*h/Math.max(1,(result.input?.width||1)*(result.input?.height||1)),local_neighbors:n,horizontal_group_count:gs.length,best_group_score:bs,best_group_member_count:+bg?.member_count||0,best_group_spacing_cv:Number(bg?.spacing_cv),best_group_repeat_fraction:Number(bg?.repeat_recovered_fraction),cohort:r.routing?.cohort||null}
}
function G(f){
 if(f.source==="v30_board_row"||f.cohort==="v30_board_cell")return {eligible:true,reason:"specialized_board_cell"};
 const a=f.area_fraction>=.005&&f.area_fraction<=.09;
 if(f.source==="edge-horizontal-repeat-v1"&&f.ratio>=.45&&f.ratio<=1.65&&a&&f.best_group_member_count>=5&&f.best_group_score>=2.5)return {eligible:true,reason:"repeated_horizontal_structure"};
 if(f.source==="edge-portrait-card-v1"&&f.ratio>=.45&&f.ratio<=1.05&&a&&(f.local_neighbors>=2||(f.local_neighbors>=1&&f.best_group_member_count>=5&&f.best_group_score>=3)))return {eligible:true,reason:"clustered_portrait_structure"};
 if(f.source==="edge-portrait-card-v1"&&f.ratio>=.45&&f.ratio<=1&&f.area_fraction>=.03&&f.area_fraction<=.09)return {eligible:true,reason:"large_isolated_card_shape"};
 return {eligible:false,reason:"insufficient_card_structure"}
}
function IT(t){return (t.objects||[]).filter(o=>o.expected_resolution==="semantic"&&Array.isArray(o.expected_entity_ids)&&o.expected_entity_ids.length===1&&String(o.expected_entity_ids[0]).startsWith("bazaar:item:"))}
async function AC(env,id){
 const [to,so]=await Promise.all([env.BUCKET.get("clean/train/"+id+"/truth.json"),env.BUCKET.get("clean/train/"+id+"/screenshot.png")]);if(!to||!so)throw Error("missing "+id);
 const t=JSON.parse(await to.text()),bytes=await so.arrayBuffer();
 const resp=await fetch("https://bazaar-clean-benchmark.allaboutstudios.workers.dev/api/runtime/perception-analyze",{method:"POST",headers:{"content-type":"image/png","content-length":String(bytes.byteLength)},body:bytes});if(!resp.ok)throw Error("core "+resp.status+":"+(await resp.text()).slice(0,250));
 const result=await resp.json(),items=IT(t),rows=[];
 for(const r of result.regions||[]){let mi=0,ma=0,te=null;for(const x of items){const z=I(r.bbox,x.bbox);if(z>mi){mi=z;te=x.expected_entity_ids[0]}}for(const x of t.objects||[])ma=Math.max(ma,I(r.bbox,x.bbox));const label=mi>=.5?"positive":ma<.1?"negative":"ambiguous",f=F(result,r);rows.push({region_id:r.region_id,bbox:r.bbox,label,max_item_iou:mi,max_any_truth_iou:ma,truth_entity_id:label==="positive"?te:null,features:f,gate:G(f)})}
 const p=rows.filter(x=>x.label==="positive"),n=rows.filter(x=>x.label==="negative"),key="benchmarks/card-role-gate-v1/train/"+id+".json";
 await env.BUCKET.put(key,JSON.stringify({schema_version:1,gate_version:V,case_id:id,pipeline_version:result.pipeline_version,truth_item_count:items.length,region_count:rows.length,positive_count:p.length,negative_count:n.length,rows}),{httpMetadata:{contentType:"application/json"},customMetadata:{artifact:"card-role-gate-calibration-case",gate_version:V,case_id:id,positive_count:String(p.length),negative_count:String(n.length)}});
