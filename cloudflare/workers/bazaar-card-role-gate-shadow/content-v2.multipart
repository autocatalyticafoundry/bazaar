}
async function ER(env){
 const sha="5a4e9b43b05b2fd6f998cf2725ac450c1dd483f58134d0dec4b4713622bfd393",src="perception/results/"+sha+"-human-audit-20261007-0035.json",o=await env.BUCKET.get(src);if(!o)throw Error("missing real result");
 const result=JSON.parse(await o.text()),rows=(result.regions||[]).map(r=>{const f=F(result,r);return {region_id:r.region_id,bbox:r.bbox,features:f,gate:G(f),known_label:r.region_id==="region-13"?"negative_day_hour_hud":r.region_id==="region-22"?"positive_stained_glass_window":null}});
 const eligible=rows.filter(x=>x.gate.eligible).map(x=>x.region_id),neg=rows.find(x=>x.region_id==="region-13"),pos=rows.find(x=>x.region_id==="region-22"),key="perception/card-role-gate-shadow/"+sha+"/"+V+".json";
