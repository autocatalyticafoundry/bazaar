 await env.BUCKET.put(key,JSON.stringify(art),{httpMetadata:{contentType:"application/json"},customMetadata:{artifact:"card-role-gate-shadow",gate_version:V,eligible_count:String(eligible.length),known_hud_rejected:String(Boolean(neg&&!neg.gate.eligible)),known_stained_glass_retained:String(Boolean(pos&&pos.gate.eligible)),semantic_promotion_allowed:"false",eligible_region_ids:JSON.stringify(eligible).slice(0,900)}});
 return {key,...art}
}
export default{async fetch(req,env){const u=new URL(req.url);try{if(req.method==="POST"&&u.pathname==="/evaluate-real")return Response.json(await ER(env));if(req.method==="POST"&&u.pathname==="/evaluate-case")return Response.json(await AC(env,u.searchParams.get("case_id")||""));return Response.json({ok:true,gate_version:V})}catch(e){console.error("CARD_ROLE_GATE_ERROR",String(e?.stack||e));return Response.json({error:String(e?.message||e)},{status:500})}}};

