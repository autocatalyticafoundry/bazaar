export default{async queue(batch,env){let i=0;for(const m of batch.messages){let b=m.body;if(typeof b==="string"){try{b=JSON.parse(b)}catch{}}const key="debug/queue-dispatch-diagnostic/"+Date.now()+"-"+(i++);await env.BUCKET.put(key,new Uint8Array(),{customMetadata:{body:JSON.stringify(b).slice(0,1000)}});m.ack()}}};
