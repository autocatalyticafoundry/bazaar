const VERSION="item-visual-qwen3-vl-multicrop-shadow-v1";
const te=new TextEncoder();
let cachedKey=null,cachedDecoded=null;
function u32be(a,o){return ((a[o]<<24)>>>0)|(a[o+1]<<16)|(a[o+2]<<8)|a[o+3]}
function paeth(a,b,c){const p=a+b-c,pa=Math.abs(p-a),pb=Math.abs(p-b),pc=Math.abs(p-c);return pa<=pb&&pa<=pc?a:pb<=pc?b:c}
function cat(parts){let n=0;for(const p of parts)n+=p.length;const out=new Uint8Array(n);let o=0;for(const p of parts){out.set(p,o);o+=p.length}return out}
async function inflate(bytes){const stream=new Blob([bytes]).stream().pipeThrough(new DecompressionStream("deflate"));return new Uint8Array(await new Response(stream).arrayBuffer())}
async function deflate(bytes){const stream=new Blob([bytes]).stream().pipeThrough(new CompressionStream("deflate"));return new Uint8Array(await new Response(stream).arrayBuffer())}
async function decodePng(bytes){
 const sig=[137,80,78,71,13,10,26,10];for(let i=0;i<8;i++)if(bytes[i]!==sig[i])throw new Error("not png");
 let o=8,w=0,h=0,depth=0,type=0,interlace=0,idats=[];
 while(o+12<=bytes.length){const len=u32be(bytes,o)>>>0,typ=String.fromCharCode(...bytes.slice(o+4,o+8)),data=bytes.slice(o+8,o+8+len);o+=12+len;if(typ==="IHDR"){w=u32be(data,0)>>>0;h=u32be(data,4)>>>0;depth=data[8];type=data[9];interlace=data[12]}else if(typ==="IDAT")idats.push(data);else if(typ==="IEND")break}
 if(depth!==8||interlace!==0||!(type===6||type===2))throw new Error("unsupported png "+JSON.stringify({depth,type,interlace}));
 const bpp=type===6?4:3,stride=w*bpp,raw=await inflate(cat(idats)),rgba=new Uint8Array(w*h*4),prev=new Uint8Array(stride),cur=new Uint8Array(stride);let p=0;
 for(let y=0;y<h;y++){const f=raw[p++];for(let x=0;x<stride;x++){const v=raw[p++],a=x>=bpp?cur[x-bpp]:0,b=prev[x],c=x>=bpp?prev[x-bpp]:0;cur[x]=(v+(f===0?0:f===1?a:f===2?b:f===3?Math.floor((a+b)/2):f===4?paeth(a,b,c):(()=>{throw new Error("png filter "+f)})()))&255}
  for(let x=0;x<w;x++){const si=x*bpp,di=(y*w+x)*4;rgba[di]=cur[si];rgba[di+1]=cur[si+1];rgba[di+2]=cur[si+2];rgba[di+3]=type===6?cur[si+3]:255}prev.set(cur)
 }
